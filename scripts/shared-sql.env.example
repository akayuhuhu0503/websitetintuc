# TEMPLATE ONLY. Copy outside Git/webroot, restrict ACL, then fill privately.
# Never use an existing Development .env on the shared target.
Deployment__Profile=UAT
Deployment__TargetApproved=false
Deployment__TargetApprovalReference=
Deployment__ExpectedSqlServer=REPLACE_ENDPOINT
Deployment__SqlAuthentication=SqlPassword
Deployment__ExpectedSqlLogin=REPLACE_APP_LOGIN
# From read-only probe + DBA confirmation; never substitute an IP/port here.
Deployment__ExpectedSqlServerIdentity=
Deployment__ExpectedHost=REPLACE_HTTPS_HOST
Sql__ExpectedDatabase=REPLACE_ALLOCATED_DATABASE
Sql__CompatibilityLevel=160
# Keep empty password until supplied privately. Optional HostNameInCertificate
# must match the approved certificate CN/SAN; never TrustServerCertificate=true.
ConnectionStrings__Portal=Server=REPLACE_ENDPOINT;Database=REPLACE_ALLOCATED_DATABASE;User ID=REPLACE_APP_LOGIN;Password=;Encrypt=true;TrustServerCertificate=false;Persist Security Info=false
Runtime__RolePassword=
Public__BaseUrl=https://REPLACE_HTTPS_HOST
Storage__MediaRoot=D:\REPLACE_PRIVATE_HOME\media
Storage__SnapshotRoot=D:\REPLACE_PRIVATE_HOME\snapshots
Storage__TempRoot=D:\REPLACE_PRIVATE_HOME\temp
Storage__KeysRoot=D:\REPLACE_PRIVATE_HOME\keys
Scanner__Provider=MicrosoftDefenderOnPrem
Scanner__PolicyReference=
Scanner__DefenderPrivacyPolicyReference=
Scanner__DefenderBinarySha256=
Scanner__DefenderServiceIdentity=
Media__AllowUnscannedDevelopmentUploads=false
Mail__Transport=Disabled
Mail__DeliveryEnabled=false
