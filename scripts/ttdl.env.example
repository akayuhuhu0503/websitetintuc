# Private TTDL config: complete allocations before copying to root .env; NEVER commit secrets.
# Only Staging/UAT supported; blank mandatory fields block publish.
DOTNET_ENVIRONMENT=Staging
ASPNETCORE_ENVIRONMENT=Staging
LANDPORTAL_HOME=

# Deployment
Deployment__Profile=UAT
Deployment__OperatingOwner=Trung tâm Dữ liệu và Thông tin đất đai (TTDL)
Deployment__TargetApproved=false
Deployment__TargetApprovalReference=
# Temporary certificate-trust exception is opt-in and bound to this exact SQL UAT target.
# Production is never allowed; reference the owner approval when enabling privately.
Deployment__SqlTlsExceptionApproved=false
Deployment__SqlTlsExceptionReference=
Deployment__ExpectedSqlServer=45.120.229.43,1433
Deployment__SqlAuthentication=SqlPassword
Deployment__ExpectedSqlLogin=website_tin_tuc_app
Deployment__ExpectedSqlServerIdentity=WIN-S1IBJB84OOO
Deployment__ExpectedHost=

# Sql
Sql__ExpectedDatabase=website_tin_tuc
Sql__CompatibilityLevel=160

# ConnectionStrings
# Portal: private SQL connection string; Server/Database/User ID/Password; Encrypt=True;TrustServerCertificate=False.
# These non-secret target identifiers are allocated; password/certificate remain TTDL inputs.
# TrustServerCertificate=True additionally requires the explicit UAT exception fields above.
ConnectionStrings__Portal=Server=45.120.229.43,1433;Database=website_tin_tuc;User ID=website_tin_tuc_app;Password=;Encrypt=True;TrustServerCertificate=False;Persist Security Info=False

# Public
Public__BaseUrl=

# Storage
# Four distinct children of LANDPORTAL_HOME, outside source and IIS webroot.
Storage__MediaRoot=
Storage__SnapshotRoot=
Storage__TempRoot=
Storage__KeysRoot=

# Runtime
# Existing role LandPortalRuntime. RolePassword must differ from SQL login password (24-128 characters).
Runtime__RolePassword=

# Media
Media__AllowUnscannedDevelopmentUploads=false

# Scanner
Scanner__Provider=MicrosoftDefenderOnPrem
Scanner__ClamdHost=
Scanner__ClamdPort=
Scanner__PolicyReference=
Scanner__TimeoutSeconds=120
Scanner__DefenderPrivacyPolicyReference=
Scanner__DefenderBinarySha256=
Scanner__DefenderServiceIdentity=

# Mail
Mail__Transport=Disabled
Mail__DeliveryEnabled=false
Mail__Host=
Mail__Port=587
Mail__From=
Mail__Tls=StartTls
Mail__UserName=
Mail__Password=
Mail__PolicyReference=

# AdminSession
AdminSession__IdleMinutes=30

# SafeImport
SafeImport__ApprovedSignerThumbprints=

# Video
Video__Enabled=false
Video__ProcessorApproved=false
Video__FfmpegPath=
Video__FfprobePath=
Video__FfmpegSha256=
Video__FfprobeSha256=
Video__LicenseReference=
