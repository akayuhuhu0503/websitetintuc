# Copiez vers .env. Aucun secret fourni; .NET le charge explicitement via PortalConfiguration.
Application__Name=Land Portal
ASPNETCORE_ENVIRONMENT=Development
Public__BaseUrl=http://127.0.0.1:5188
ConnectionStrings__Portal=Server=.\SQLEXPRESS;Database=LandPortal_Dev;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
Sql__ExpectedDatabase=LandPortal_Dev
Sql__CompatibilityLevel=160
# Local Windows-only SQL runtime uses an application role, provisioned explicitly.
Runtime__RolePassword=
Storage__MediaRoot=.local/media
Storage__SnapshotRoot=.local/snapshots
Storage__TempRoot=.local/temp
Storage__KeysRoot=.local/keys
Upload__MaxBytes=1073741824
Upload__ChunkBytes=8388608
# Phase 2A images/PDF: disabled until an explicit Development loopback exception is selected.
Media__AllowUnscannedDevelopmentUploads=false
Media__MaxImageBytes=16777216
Media__MaxPdfBytes=33554432
Media__MaxImagePixels=30000000
Media__MaxDecodedFramePixels=80000000
Media__MaxImageFrames=100
Media__MaxPdfPages=1000
Worker__Enabled=false
# Publication scheduler starts only through the standalone worker command.
# Worker__Enabled is reserved for future job types; it does not start a web timer.
Scheduler__PollSeconds=5
Scheduler__LeaseSeconds=60
Scheduler__CatchUpMinutes=15
Scheduler__MaxAttempts=4
# Editor idle session; GET status/media polling does not renew it.
AdminSession__IdleMinutes=30
# 2D default closed. Only explicit Development + named SQL Test + isolated Test storage can enable.
# Operator-installed binaries stay outside repository/packages; pin both hashes and record build/license.
Video__Enabled=false
Video__FfmpegPath=
Video__FfprobePath=
Video__FfmpegSha256=
Video__FfprobeSha256=
Video__ProcessorApproved=false
Video__LicenseReference=
Video__MaxFileBytes=1073741824
Video__ChunkBytes=8388608
Video__QuotaBytes=17179869184
Video__MinimumFreeBytes=536870912
Video__MaxSessions=3
Video__SessionHours=24
Video__ProcessSeconds=300
Video__Threads=2
Scanner__Enabled=false
Scanner__Executable=
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=25
Smtp__User=
Smtp__Password=
Bootstrap__AdminEmail=
# Bootstrap now generates a private temporary password; do not configure a shared AdminPassword.
Sync__Enabled=true
Sync__CutoverUtc=
