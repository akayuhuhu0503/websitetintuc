@model MfaManageModel
@{Layout="~/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Xác thực hai bước";}
<h1>Xác thực hai bước</h1><p>Trạng thái: <strong>@(Model.Enabled?"Đã bật":"Chưa bật")</strong>. @(Model.Required?"Môi trường này yêu cầu MFA trước khi truy cập quản trị.":"")</p>
@if(Model.RecoveryCodes.Length>0){<section class="panel" role="status"><h2>Lưu mã khôi phục</h2><p>Các mã chỉ hiển thị trong lần này. Giữ ở nơi riêng, mỗi mã dùng một lần; các mã cũ đã bị thu hồi.</p><ul>@foreach(var code in Model.RecoveryCodes){<li><code>@code</code></li>}</ul></section>}
@if(!Model.Enabled){<section class="panel"><h2>Kết nối ứng dụng xác thực</h2>@if(Model.SharedKey is null){<form method="post" action="/admin/account/mfa/start">@Html.AntiForgeryToken()<label>Mật khẩu hiện tại<input type="password" name="password" autocomplete="current-password" maxlength="256" required /></label><button type="submit">Bắt đầu thiết lập</button></form>}else{<p>Trong ứng dụng hỗ trợ TOTP, thêm tài khoản bằng khóa thiết lập thủ công sau. Giữ bí mật khóa này.</p><code>@Model.SharedKey</code><form method="post" action="/admin/account/mfa/enable">@Html.AntiForgeryToken()<label>Mã 6 chữ số<input name="code" autocomplete="one-time-code" inputmode="numeric" maxlength="8" required /></label><button type="submit">Xác nhận bật MFA</button></form>}</section>}
else{<section class="panel"><h2>Tạo lại mã khôi phục</h2><form method="post" action="/admin/account/mfa/recovery-codes">@Html.AntiForgeryToken()<label>Mật khẩu hiện tại<input type="password" name="password" autocomplete="current-password" maxlength="256" required /></label><label>Mã ứng dụng xác thực<input name="code" autocomplete="one-time-code" maxlength="8" required /></label><button type="submit">Tạo mã mới, thu hồi mã cũ</button></form></section><section class="panel"><h2>Thay thiết bị xác thực</h2><p>Cần mật khẩu và một mã khôi phục. Thao tác thu hồi các phiên; bạn phải thiết lập MFA lại để dùng quản trị ở UAT.</p><form method="post" action="/admin/account/mfa/reset">@Html.AntiForgeryToken()<label>Mật khẩu hiện tại<input type="password" name="password" autocomplete="current-password" maxlength="256" required /></label><label>Mã khôi phục<input name="recoveryCode" autocomplete="off" maxlength="32" required /></label><button type="submit">Thu hồi thiết bị và các phiên</button></form></section>}
