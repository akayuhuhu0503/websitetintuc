@model ChangeOwnPasswordModel
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityPolicy
@{ ViewData["Title"] = "Đổi mật khẩu của bạn"; var minimum = IdentityPolicy.Value.Password.RequiredLength; }
<div class="login-wrap"><section class="login-panel">
<h1>Đổi mật khẩu của bạn</h1>
@if (Model.RequiredChange) { <p>Bạn đang sử dụng mật khẩu tạm. Hãy đổi mật khẩu trước khi mở các màn hình quản trị.</p> }
<p class="form-help">Sau khi đổi thành công, bạn sẽ được chuyển tới trang quản trị.</p>
<form method="post" action="/admin/account/change-password">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="validation-summary" role="alert" aria-live="polite"></div>
<div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" maxlength="256" /><span asp-validation-for="CurrentPassword"></span></div>
<div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" minlength="@minimum" maxlength="256" aria-describedby="password-policy" /><small id="password-policy" class="form-help">@LandPortal.Infrastructure.PortalIdentityPolicy.Guidance</small><span asp-validation-for="NewPassword"></span></div>
<div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" maxlength="256" /><span asp-validation-for="ConfirmPassword"></span></div>
<button type="submit" class="button">Đổi mật khẩu</button>
</form>
<form method="post" action="/admin/account/logout">@Html.AntiForgeryToken()<button type="submit" class="link-button">Đăng xuất</button></form>
</section></div>
