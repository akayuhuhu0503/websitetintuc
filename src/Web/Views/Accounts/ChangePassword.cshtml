@model ChangeOwnPasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu của bạn"; }
<div class="login-wrap"><section class="login-panel"><h1>Đổi mật khẩu của bạn</h1>@if (Model.RequiredChange) { <p>Bạn đang sử dụng mật khẩu tạm. Hãy đổi mật khẩu trước khi mở các màn hình quản trị.</p> }<form method="post" action="/admin/account/change-password">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /></div><div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /></div><div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div><button type="submit" class="button">Đổi mật khẩu</button></form><form method="post" action="/admin/account/logout">@Html.AntiForgeryToken()<button type="submit" class="link-button">Đăng xuất</button></form></section></div>
