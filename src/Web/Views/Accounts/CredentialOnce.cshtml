@model CredentialOnceModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Bàn giao mật khẩu tạm"; }
<section class="account-card credential-handoff" data-credential-once>
<h1>Mật khẩu tạm — chỉ xem lần này</h1>
<p>Thông tin này đã được đánh dấu đã bàn giao và không thể mở lại. Gửi trực tiếp cho người nhận qua kênh an toàn, không gửi vào nhóm chat công khai hoặc nhật ký xử lý.</p>
<div class="form-field"><label for="handoff-username">Tên đăng nhập</label><input id="handoff-username" value="@Model.UserName" readonly autocomplete="off" /></div>
<div class="form-field"><label for="handoff-password">Mật khẩu tạm</label><input id="handoff-password" type="password" value="@Model.TemporaryPassword" readonly autocomplete="off" data-sensitive-value /></div>
<div class="credential-actions"><button type="button" class="button secondary" data-credential-toggle aria-pressed="false">Hiện mật khẩu</button><button type="button" class="button secondary" data-credential-copy>Sao chép mật khẩu</button></div>
<p role="status" data-credential-status></p>
<p>Người nhận đăng nhập tại <strong>/admin/login</strong> và bắt buộc đổi mật khẩu trước khi sử dụng CMS. Vai trò, quyền và nội dung không thay đổi khi nhận mật khẩu.</p>
<a class="button" href="/admin/users/@Uri.EscapeDataString(Model.UserId)">Đã bàn giao · Quay lại tài khoản</a>
</section>
@section Styles { <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/account-credential.js" asp-append-version="true" defer></script> }
