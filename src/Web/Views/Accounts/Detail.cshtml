@model AccountDetailModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Quản trị tài khoản"; }
<p><a href="/admin/users">← Danh sách tài khoản</a></p><h1>@Model.UserName</h1><p>@(Model.Disabled ? "Tài khoản đã vô hiệu hóa." : "Tài khoản đang hoạt động.") @(Model.MustChangePassword ? "Phải đổi mật khẩu trước khi quản trị." : "")</p>
<div asp-validation-summary="All" class="validation-summary" role="alert"></div>
@if(TempData["CredentialFile"] is string credentialFile){<section class="account-card" role="status"><h2>Bàn giao mật khẩu tạm</h2><p>Mật khẩu chỉ có trong tệp private trên máy chủ: <code>@credentialFile</code>. Tệp chỉ cho tài khoản Windows chạy ứng dụng và SYSTEM đọc. Người vận hành có thẩm quyền bàn giao qua kênh an toàn; không đưa tệp vào Git, log, email từ website hoặc thư mục công khai.</p></section>}
@if (!Model.CanChangeSensitive) { <p class="validation-summary">Tài khoản có quyền nhạy cảm. Thay đổi cần quyền ủy quyền đặc quyền và quyền nằm trong phạm vi của người thực hiện.</p> }
<section class="account-card"><h2>Thông tin tài khoản</h2><form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/update">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" />
<div class="form-field"><label asp-for="Email"></label><input asp-for="Email" maxlength="256" /></div><div class="form-field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" maxlength="200" /></div><button class="button" type="submit">Lưu thông tin</button></form></section>
<section class="account-card"><h2>Nhóm quyền</h2><p>Thay đổi nhóm sẽ thu hồi các phiên cũ. Các quyền xuất bản, cấu hình, quản lý người dùng và lịch đăng có thể thay đổi ngay. Không tự thay đổi nhóm của mình.</p>
@if (Model.CanGrant) { <form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/roles">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" /><fieldset><legend>Chọn các nhóm cho tài khoản</legend>@foreach (var role in Model.Roles) { <label class="account-checkbox"><input type="checkbox" name="RoleIds" value="@role.Id" checked="@Model.RoleIds.Contains(role.Id)" /> @AdminLabels.Role(role.Name) @(role.Sensitive ? "(quyền nhạy cảm)" : "")</label> }</fieldset><button type="submit" class="button">Áp dụng nhóm quyền và thu hồi phiên</button></form> } else { <p>Bạn chưa có quyền cấp nhóm cho tài khoản này.</p>@foreach (var role in Model.Roles.Where(x => Model.RoleIds.Contains(x.Id))) { <p>@AdminLabels.Role(role.Name)</p> } }
<h3>Quyền từ các nhóm và quyền riêng</h3><p>Danh sách này là tập quyền được gán. Tài khoản bị khóa hoặc chưa đổi mật khẩu tạm chưa được thực thi các quyền.</p><ul>@foreach (var permission in Model.EffectivePermissions) { <li>@AdminLabels.Permission(permission)</li> }</ul>@if (Model.EffectivePermissions.Count == 0) { <p>Chưa được cấp quyền.</p> }</section>
<section class="account-card"><h2>Phiên đăng nhập và trạng thái</h2><p>Các thao tác này có hiệu lực trên yêu cầu kế tiếp. Không xóa tài khoản hoặc đặt lại mật khẩu.</p><form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/revoke-sessions">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" /><button type="submit" class="button secondary">Thu hồi tất cả phiên</button></form><form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/status">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" /><input type="hidden" name="disabled" value="@(!Model.Disabled)" /><button type="submit" class="button secondary">@(Model.Disabled ? "Mở lại tài khoản" : "Vô hiệu hóa tài khoản và thu hồi phiên")</button></form></section>

<section class="account-card"><h2>Phạm vi chuyên mục</h2><p>Chuyên mục chính và mọi chuyên mục phụ đều phải được giao. Phạm vi không cấp thêm quyền duyệt hoặc xuất bản. Tài khoản cũ chưa có giới hạn vẫn giữ phạm vi toàn bộ; không tự đổi tài khoản vận hành.</p>
@if(Model.CanGrant){<form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/categories">@Html.AntiForgeryToken()<input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" /><label class="account-checkbox"><input type="checkbox" name="unrestrictedCategories" value="true" checked="@Model.UnrestrictedCategories" /> Toàn bộ chuyên mục (cần ủy quyền đặc quyền)</label><fieldset><legend>Nếu giới hạn, chọn các chuyên mục</legend>@foreach(var category in Model.Categories){<label class="account-checkbox"><input type="checkbox" name="categoryIds" value="@category.Id" checked="@Model.CategoryIds.Contains(category.Id)" /> @category.Name</label>}</fieldset><button class="button" type="submit">Áp dụng phạm vi và thu hồi phiên</button></form>}else{<p>@(Model.UnrestrictedCategories?"Toàn bộ chuyên mục":"Phạm vi hữu hạn: "+string.Join(", ",Model.CategoryIds))</p>}</section>
@section Styles { <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" /> }
@if(Model.CanChangeSensitive){<section class="account-card"><h2>Đặt lại mật khẩu</h2><p>Hệ thống sinh mật khẩu tạm mới, thu hồi phiên cũ và yêu cầu đổi ở lần đăng nhập tiếp theo. Vai trò và quyền giữ nguyên. Không dùng thao tác này để tự đổi mật khẩu của mình.</p><form method="post" action="/admin/users/@Uri.EscapeDataString(Model.Id)/reset-password">@Html.AntiForgeryToken()<input type="hidden" name="concurrencyStamp" value="@Model.ConcurrencyStamp" /><button type="submit" class="button secondary">Tạo mật khẩu tạm mới</button></form></section>}
