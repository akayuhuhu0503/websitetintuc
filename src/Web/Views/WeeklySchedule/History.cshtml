@model IReadOnlyList<LandPortal.Domain.WeeklyScheduleRelease>
@{Layout="_AdminLayout";ViewData["Title"]="Lịch sử phát hành lịch tuần";}
<h1>Lịch sử phát hành lịch tuần</h1><p>Bản cũ chỉ dành cho quản trị có quyền; khôi phục trong lịch sử bài sẽ tạo nháp/revision mới, cần duyệt và đăng lại để tạo phiên bản phát hành tiếp theo.</p><ul>@foreach(var release in Model){<li>Tuần @release.IsoWeek/@release.IsoYear · phiên bản @release.Version · @release.PublishedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") · @release.ChangeNote · <a href="/admin/history/@release.ContentId">Lịch sử bài và khôi phục</a></li>}</ul>
