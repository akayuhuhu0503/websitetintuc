@model InquiryCalendarForm
@using LandPortal.Domain
@{Layout="_AdminLayout";ViewData["Title"]="Lịch xử lý hỏi đáp";var versions=ViewData["Versions"] as IReadOnlyList<InquiryCalendar>??[];}
<section class="interaction-panel"><h1>Lịch xử lý hỏi đáp</h1><p class="scope-note">Tạm tính — chưa phải SLA chính thức. Phiên bản mới chỉ áp dụng cho hồ sơ nhận từ mốc hiệu lực; không đổi hạn đã lưu. Chưa xác nhận ngày nghỉ pháp lý hoặc policy chính thức.</p>
<form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label asp-for="Label">Tên phiên bản</label><input asp-for="Label" required/><label asp-for="PolicyVersion">Mã chính sách</label><input asp-for="PolicyVersion" required/><label asp-for="EffectiveFrom">Hiệu lực từ ngày Việt Nam</label><input asp-for="EffectiveFrom" type="date" required/><label asp-for="WorkingDays">Số ngày làm việc tạm tính</label><input asp-for="WorkingDays" type="number" min="1" max="60"/><label asp-for="Cutoff">Giờ chốt/hạn trong ngày Việt Nam</label><input asp-for="Cutoff" type="time"/><label class="interaction-consent"><input asp-for="CountReceiptDay"/> Tính ngày tiếp nhận nếu trước giờ chốt và là ngày làm việc</label><label asp-for="WeekendDays">Ngày nghỉ tuần (0=Chủ nhật,…6=Thứ bảy)</label><input asp-for="WeekendDays"/><label asp-for="Exceptions">Ngoại lệ: mỗi dòng yyyy-MM-dd|work/off|ghi chú</label><textarea asp-for="Exceptions" rows="6"></textarea><button>Tạo phiên bản lịch tạm tính</button></form>
<h2>Phiên bản đã lưu</h2><ul>@foreach(var c in versions){<li>@c.Label · @c.EffectiveFrom · @c.WorkingDays ngày · @c.PolicyVersion · @(c.IsApproved?"Đã xác nhận":"Tạm tính")</li>}</ul></section>
