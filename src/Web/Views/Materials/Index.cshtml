@model MaterialsModel
@{ ViewData["Title"] = "Tài liệu"; }
<partial name="_PublicBreadcrumb" model='"Tài liệu"' />
<header class="page-header page-header-search">
    <div><h1>Tài liệu</h1><p>Tra cứu và tải tài liệu đã công bố.</p></div>
    <form class="listing-filter" method="get" role="search"><label class="sr-only" for="materials-q">Tìm tài liệu</label><input id="materials-q" type="search" name="q" value="@Model.Query" maxlength="200" placeholder="Tìm theo tiêu đề, từ khóa…" /><button class="button" type="submit">Tìm kiếm</button></form>
</header>
<nav class="tabs" aria-label="Nhóm văn bản"><a href="/van-ban">Văn bản pháp luật</a><a href="/du-thao">Văn bản dự thảo</a><a href="/tai-lieu" aria-current="page">Tài liệu</a></nav>
@if (Model.Items.Count == 0)
{
    <div class="empty-state"><partial name="_PortalIcon" model='"document"' /><h2>Chưa có tài liệu phù hợp</h2><p>Tài liệu sẽ hiển thị tại đây sau khi được biên tập, duyệt và công bố.</p></div>
}
else
{
    <p class="result-count">@Model.Total nội dung có tài liệu công khai</p>
    <div class="materials-list">
    @foreach (var item in Model.Items)
    {
        <article class="material-card">
            <div><h2><a href="@item.Content.Url">@item.Content.Title</a></h2>@if(item.Content.DisplayDate is not null){<p class="article-meta">Công bố: @item.Content.DisplayDate</p>}@if(item.Content.Summary is not null){<p>@item.Content.Summary</p>}</div>
            <ul class="material-files">
            @foreach(var file in item.Files)
            {
                <li><span><partial name="_PortalIcon" model='"document"' /> @file.Name</span><a href="/media/@file.Id?download=true&amp;contentId=@item.Content.Id">@(file.ContentType == "application/zip" ? "Tải tệp ZIP về" : "Tải tài liệu")<span class="sr-only"> @file.Name</span> ↓</a></li>
            }
            </ul>
        </article>
    }
    </div>
    <partial name="_PublicPager" model="new int[]{Model.Page,Model.PageCount}" />
}
