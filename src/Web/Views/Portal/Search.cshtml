@model ListingModel
@section Styles { <link rel="stylesheet" href="~/css/search-results.css" asp-append-version="true" /> }
@{ ViewData["Title"] = "Tìm kiếm"; }
<nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Tìm kiếm</span></nav>
<div class="page-header"><p class="eyebrow">TÌM KIẾM THÔNG TIN</p><h1>Tìm kiếm trên cổng thông tin</h1></div>
<form class="search-page-form" method="get"><div><label for="search-q">Từ khóa</label><input id="search-q" type="search" name="q" value="@Model.Query" maxlength="200" placeholder="Nhập tiêu đề, nội dung hoặc số văn bản" /></div><div><label for="search-kind">Loại nội dung</label><select id="search-kind" name="kind"><option value="">Tất cả</option><option value="Article" selected="@(Model.Kind == "Article")">Tin tức</option><option value="Announcement" selected="@(Model.Kind == "Announcement")">Thông báo</option><option value="LegalDocument" selected="@(Model.Kind == "LegalDocument")">Văn bản pháp luật</option><option value="DraftDocument" selected="@(Model.Kind == "DraftDocument")">Văn bản dự thảo</option><option value="Inquiry" selected="@(Model.Kind == "Inquiry")">Hỏi đáp đã công khai</option><option value="Video" selected="@(Model.Kind == "Video")">Video</option><option value="StaticPage" selected="@(Model.Kind == "StaticPage")">Giới thiệu</option></select></div><div><label for="search-category">Chuyên mục</label><select id="search-category" name="categoryId"><option value="">Tất cả</option>@foreach(var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }</select></div><div><label for="filter-from">Ngày đăng từ</label><input id="filter-from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" /></div><div><label for="filter-to">Ngày đăng đến</label><input id="filter-to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" /></div><div><label for="filter-sort">Sắp xếp</label><select id="filter-sort" name="sort"><option value="relevant" selected="@(Model.Sort == "relevant")">Liên quan nhất</option><option value="recent" selected="@(Model.Sort == "recent")">Mới nhất</option><option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option><option value="title" selected="@(Model.Sort == "title")">Tiêu đề</option></select></div><button class="button" type="submit">Tìm kiếm</button></form>
<p class="form-help">Tra cứu tin, văn bản và hỏi đáp đã công khai theo từ khóa, chuyên mục hoặc ngày đăng.</p>
@if(string.IsNullOrWhiteSpace(Model.Query)) { <p class="query-help" role="status">Nhập từ khóa hoặc số ký hiệu để tìm kiếm, hoặc sử dụng bộ lọc bên dưới.</p> }
<p class="result-count">@Model.Total kết quả @if (!string.IsNullOrWhiteSpace(Model.Query)) { <span>cho “@Model.Query”</span> }</p>
@if (Model.SearchItems.Count == 0) { <div class="empty-state"><h2>Không tìm thấy kết quả</h2><p>Thử từ khóa ngắn hơn hoặc chọn một loại nội dung khác.</p></div> } else { <div class="search-results">@foreach (var item in Model.SearchItems) { <article class="content-card"><div class="card-body"><p class="eyebrow">@(item.Kind == 99 ? "HỎI ĐÁP ĐÃ CÔNG KHAI" : "NỘI DUNG ĐÃ XUẤT BẢN") · @item.Date?.ToString("dd/MM/yyyy")</p><h2><a href="@(item.Kind == 99 ? "/hoi-dap/cong-khai/" + item.Id : "/bai-viet/" + item.Id)">@item.Title</a></h2><p>@(item.Summary.Length > 400 ? item.Summary[..400] + "…" : item.Summary)</p></div></article> }</div> }
<partial name="_PublicPager" model="new int[]{Model.Page,Model.PageCount}" />
