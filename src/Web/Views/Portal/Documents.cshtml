@model DocumentListModel
@{ ViewData["Title"] = Model.Title; }
<nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>@Model.Title</span></nav>
<div class="page-header"><p class="eyebrow">TRA CỨU VĂN BẢN</p><h1>@Model.Title</h1><p>@(Model.IsDraft ? "Tài liệu dự thảo lấy ý kiến được công bố tại nguồn chính." : "Tra cứu văn bản theo trích yếu, số ký hiệu và cơ quan ban hành.")</p></div>
<p class="query-help">Ưu tiên số ký hiệu khớp chính xác khi chọn Liên quan nhất. Hiệu lực chỉ theo thông tin đã được xác nhận; thiếu căn cứ ghi Chưa xác định.</p>
<form class="document-filter" method="get"><div class="filter-wide"><label for="doc-q">Trích yếu hoặc số ký hiệu</label><input id="doc-q" name="q" value="@Model.Query" maxlength="200" placeholder="Nhập từ khóa, số văn bản..." /></div><div><label for="doc-agency">Cơ quan ban hành</label><input id="doc-agency" name="agency" value="@Model.Agency" maxlength="200" placeholder="Tên cơ quan" /></div><div><label for="doc-type">Loại văn bản</label><input id="doc-type" name="type" value="@Model.Type" maxlength="100" placeholder="Luật, nghị định, thông tư..." /></div><div><label for="doc-field">Lĩnh vực</label><input id="doc-field" name="field" value="@Model.Field" maxlength="300" /></div><div><label for="issued-from">Ban hành từ ngày</label><input id="issued-from" name="issuedFrom" type="date" value="@Model.IssuedFrom?.ToString("yyyy-MM-dd")" /></div><div><label for="issued-to">Ban hành đến ngày</label><input id="issued-to" name="issuedTo" type="date" value="@Model.IssuedTo?.ToString("yyyy-MM-dd")" /></div><div><label for="filter-from">Ngày đăng từ</label><input id="filter-from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" /></div><div><label for="filter-to">Ngày đăng đến</label><input id="filter-to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" /></div><div><label for="doc-signer">Người ký</label><input id="doc-signer" name="signer" value="@Model.Signer" maxlength="300" /></div><div><label for="doc-effectiveness">Hiệu lực đã xác nhận</label><select id="doc-effectiveness" name="effectiveness"><option value="">Tất cả</option><option value="Unknown" selected="@(Model.Effectiveness == "Unknown")">Chưa xác định</option><option value="ConfirmedEffective" selected="@(Model.Effectiveness == "ConfirmedEffective")">Đã xác nhận còn hiệu lực</option><option value="ConfirmedExpired" selected="@(Model.Effectiveness == "ConfirmedExpired")">Đã xác nhận hết hiệu lực</option><option value="ConfirmedPartial" selected="@(Model.Effectiveness == "ConfirmedPartial")">Đã xác nhận hiệu lực một phần</option></select></div><div><label for="filter-sort">Sắp xếp</label><select id="filter-sort" name="sort"><option value="relevant" selected="@(Model.Sort == "relevant")">Liên quan nhất</option><option value="recent" selected="@(Model.Sort == "recent")">Mới nhất</option><option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option><option value="title" selected="@(Model.Sort == "title")">Tiêu đề</option></select></div><button class="button" type="submit">Tra cứu</button></form>
<p class="form-help">Tìm trong chữ bài đã xuất bản và metadata. Chưa tìm nội dung bên trong PDF/ảnh, chưa OCR. Ngày đăng và ngày ban hành là hai bộ lọc riêng.</p>
<p class="result-count">@Model.Total văn bản công khai trong tập dữ liệu đã nhập</p>
@if (Model.Items.Count == 0) { <div class="empty-state"><h2>Chưa có văn bản phù hợp</h2><p>Thử thay đổi từ khóa hoặc bộ lọc. Không tự suy diễn ngày hiệu lực nếu nguồn chưa xác nhận.</p></div> } else { <div class="table-scroll" tabindex="0" role="region" aria-label="Bảng văn bản; cuộn ngang để xem đầy đủ"><table class="document-table"><caption class="sr-only">Danh sách @Model.Title</caption><thead><tr><th scope="col">Số ký hiệu / Ngày ban hành</th><th scope="col">Trích yếu</th><th scope="col">Cơ quan / Loại văn bản</th><th scope="col">Tra cứu</th></tr></thead><tbody>@foreach (var row in Model.Items) { <tr><td><strong>@(row.Number ?? "Nguồn chưa ghi số ký hiệu")</strong><span>@(row.IssuedDate ?? row.Content.DisplayDate)</span></td><td><h2><a href="@row.Content.Url">@row.Content.Title</a></h2></td><td><span>@(row.Agency ?? "Nguồn chưa xác nhận cơ quan")</span><small>@row.DocumentType</small><span class="effectiveness-label">@row.Effectiveness</span></td><td><a class="table-action" href="@row.Content.Url">Xem văn bản →</a>@if (row.FileId is not null) { <a class="table-action" href="/media/@row.FileId?download=true">Tải tệp ↓</a> }</td></tr> }</tbody></table></div> }
@if (Model.PageCount > 1) { <nav class="pagination" aria-label="Phân trang">@if (Model.Page > 1) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&agency=@Uri.EscapeDataString(Model.Agency ?? "")&type=@Uri.EscapeDataString(Model.Type ?? "")&field=@Uri.EscapeDataString(Model.Field ?? "")&issuedFrom=@Model.IssuedFrom?.ToString("yyyy-MM-dd")&issuedTo=@Model.IssuedTo?.ToString("yyyy-MM-dd")&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&signer=@Uri.EscapeDataString(Model.Signer ?? "")&effectiveness=@Uri.EscapeDataString(Model.Effectiveness ?? "")&sort=@Model.Sort&page=@(Model.Page - 1)">← Trước</a> }<span>Trang @Model.Page / @Model.PageCount</span>@if (Model.Page < Model.PageCount) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&agency=@Uri.EscapeDataString(Model.Agency ?? "")&type=@Uri.EscapeDataString(Model.Type ?? "")&field=@Uri.EscapeDataString(Model.Field ?? "")&issuedFrom=@Model.IssuedFrom?.ToString("yyyy-MM-dd")&issuedTo=@Model.IssuedTo?.ToString("yyyy-MM-dd")&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")&signer=@Uri.EscapeDataString(Model.Signer ?? "")&effectiveness=@Uri.EscapeDataString(Model.Effectiveness ?? "")&sort=@Model.Sort&page=@(Model.Page + 1)">Tiếp →</a> }</nav> }
@if (Model.IsDraft) { <div class="scope-note">Góp ý dự thảo và kiểm duyệt ý kiến sẽ được triển khai ở Giai đoạn 2. Bản chạy thử chưa mở gửi góp ý.</div> }
