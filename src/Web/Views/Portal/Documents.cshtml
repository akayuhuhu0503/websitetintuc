@model DocumentListModel
@{ ViewData["Title"] = Model.Title; }
<nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>@Model.Title</span></nav>
<div class="page-header"><p class="eyebrow">TRA CỨU VĂN BẢN</p><h1>@Model.Title</h1><p>@(Model.IsDraft ? "Tài liệu dự thảo lấy ý kiến được công bố tại nguồn chính." : "Tra cứu văn bản theo trích yếu, số ký hiệu và cơ quan ban hành.")</p></div>
<p class="query-help">Ưu tiên số ký hiệu khớp chính xác khi chọn Liên quan nhất. Hiệu lực chỉ theo thông tin đã được xác nhận; thiếu căn cứ ghi Chưa xác định.</p>
<datalist id="legal-document-types">@foreach (var label in new[] { "Luật", "Nghị định", "Nghị quyết", "Thông tư", "Quyết định", "Chỉ thị", "Công văn", "Kế hoạch", "Thông báo", "Báo cáo", "Công điện", "Hướng dẫn", "Văn bản hợp nhất" }) { <option value="@label"></option> }</datalist>
<datalist id="legal-document-fields">@foreach (var label in new[] { "Đất đai", "Nông nghiệp – Môi trường", "Tổng hợp" }) { <option value="@label"></option> }</datalist>
<p id="date-filter-help" class="form-help">Nhập ngày/tháng/năm: dd/MM/yyyy, ví dụ 04/11/2026 là ngày 4 tháng 11. Có thể để trống ngày.</p>
<form class="document-filter" method="get"><div class="filter-wide"><label for="doc-q">Trích yếu hoặc số ký hiệu</label><input id="doc-q" name="q" value="@Model.Query" maxlength="200" placeholder="Nhập từ khóa, số văn bản..." /></div><div><label for="doc-agency">Cơ quan ban hành</label><input id="doc-agency" name="agency" value="@Model.Agency" maxlength="200" placeholder="Tên cơ quan" /></div><div><label for="doc-type">Loại văn bản</label><input id="doc-type" list="legal-document-types" name="type" value="@Model.Type" maxlength="100" placeholder="Luật, nghị định, thông tư..." /></div><div><label for="doc-field">Lĩnh vực</label><input id="doc-field" list="legal-document-fields" name="field" value="@Model.Field" maxlength="300" /></div><div><label for="issued-from">Ban hành từ ngày</label><input id="issued-from" name="issuedFrom" type="text" inputmode="numeric" data-vietnamese-date autocomplete="off" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-describedby="date-filter-help" value="@Model.IssuedFrom?.ToString("dd/MM/yyyy")" /></div><div><label for="issued-to">Ban hành đến ngày</label><input id="issued-to" name="issuedTo" type="text" inputmode="numeric" data-vietnamese-date autocomplete="off" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-describedby="date-filter-help" value="@Model.IssuedTo?.ToString("dd/MM/yyyy")" /></div><div><label for="filter-from">Ngày đăng từ</label><input id="filter-from" name="from" type="text" inputmode="numeric" data-vietnamese-date autocomplete="off" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-describedby="date-filter-help" value="@Model.From?.ToString("dd/MM/yyyy")" /></div><div><label for="filter-to">Ngày đăng đến</label><input id="filter-to" name="to" type="text" inputmode="numeric" data-vietnamese-date autocomplete="off" placeholder="dd/MM/yyyy" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-describedby="date-filter-help" value="@Model.To?.ToString("dd/MM/yyyy")" /></div><div><label for="doc-signer">Người ký</label><input id="doc-signer" name="signer" value="@Model.Signer" maxlength="300" /></div><div><label for="doc-effectiveness">Hiệu lực đã xác nhận</label><select id="doc-effectiveness" name="effectiveness"><option value="">Tất cả</option><option value="Unknown" selected="@(Model.Effectiveness == "Unknown")">Chưa xác định</option><option value="ConfirmedEffective" selected="@(Model.Effectiveness == "ConfirmedEffective")">Đã xác nhận còn hiệu lực</option><option value="ConfirmedExpired" selected="@(Model.Effectiveness == "ConfirmedExpired")">Đã xác nhận hết hiệu lực</option><option value="ConfirmedPartial" selected="@(Model.Effectiveness == "ConfirmedPartial")">Đã xác nhận hiệu lực một phần</option></select></div><div><label for="filter-sort">Sắp xếp</label><select id="filter-sort" name="sort"><option value="relevant" selected="@(Model.Sort == "relevant")">Liên quan nhất</option><option value="recent" selected="@(Model.Sort == "recent")">Mới nhất</option><option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option><option value="title" selected="@(Model.Sort == "title")">Tiêu đề</option></select></div><button class="button" type="submit">Tra cứu</button></form>
<p class="form-help">Tra cứu theo trích yếu, số ký hiệu và thông tin văn bản. Ngày đăng và ngày ban hành được lọc riêng.</p>
<p class="result-count">@Model.Total văn bản công khai</p>
@if (Model.Items.Count == 0) { <div class="empty-state"><h2>Chưa có văn bản phù hợp</h2><p>Thử thay đổi từ khóa hoặc bộ lọc. Không tự suy diễn ngày hiệu lực nếu nguồn chưa xác nhận.</p></div> } else { <div class="table-scroll" tabindex="0" role="region" aria-label="Bảng văn bản; cuộn ngang để xem đầy đủ"><table class="document-table"><caption class="sr-only">Danh sách @Model.Title</caption><thead><tr><th scope="col">Số ký hiệu / Ngày ban hành</th><th scope="col">Trích yếu</th><th scope="col">Cơ quan / Loại văn bản</th><th scope="col">Tra cứu</th></tr></thead><tbody>@foreach (var row in Model.Items) { <tr><td><strong>@(row.Number ?? "Nguồn chưa ghi số ký hiệu")</strong><span>@(row.IssuedDate ?? row.Content.DisplayDate)</span></td><td><h2><a href="@row.Content.Url">@row.Content.Title</a></h2></td><td><span>@(row.Agency ?? "Nguồn chưa xác nhận cơ quan")</span><small>@row.DocumentType</small><span class="effectiveness-label">@row.Effectiveness</span></td><td><a class="table-action" href="@row.Content.Url">Xem văn bản →</a>@if (row.FileId is not null) { <a class="table-action" href="/media/@row.FileId?download=true&amp;contentId=@row.Content.Id">Tải tệp ↓</a> }</td></tr> }</tbody></table></div> }
<partial name="_PublicPager" model="new int[]{Model.Page,Model.PageCount}" />
@if (Model.IsDraft) { <div class="scope-note">Mở từng văn bản dự thảo để gửi góp ý khi còn thời hạn tiếp nhận. Mọi ý kiến được lưu riêng và phải qua kiểm duyệt.</div> }

@section Scripts { <script src="~/js/public-forms.js" asp-append-version="true" defer></script> }
