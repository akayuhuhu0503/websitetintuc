@model LandPortal.Infrastructure.InteractionReceipt
@{ViewData["Title"]="Đã tiếp nhận";}
<section class="interaction-panel"><h1>Đã tiếp nhận nội dung</h1><p>Nội dung đã được tiếp nhận và đang chờ xử lý.</p>
<p>Mã tiếp nhận: <strong id="receipt-code">@Model.PublicCode</strong>. Hãy lưu riêng mã này để tra cứu hỏi đáp cùng email đã gửi và CAPTCHA. Không chia sẻ mã tiếp nhận.</p>
@if(Model.MailQueued){<p>Email xác nhận đang chờ gửi. Vui lòng lưu mã tiếp nhận để tra cứu.</p>}else{<p>Hệ thống chưa gửi email xác nhận. Vui lòng lưu mã tiếp nhận để tra cứu.</p>}
<a href="/">Về trang chủ</a></section>
