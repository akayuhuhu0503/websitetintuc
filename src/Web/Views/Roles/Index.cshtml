@model RoleListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Nhóm quyền"; }
<div class="account-heading"><div><h1>Nhóm quyền</h1><p>@Model.Total nhóm. Tên nhóm không tự tạo quyền quản trị; quyền lấy từ danh sách cho phép được cấp tường minh.</p></div><a class="button" href="/admin/roles/create">Tạo nhóm quyền</a></div><form method="get" action="/admin/roles" class="account-filter"><div class="form-field"><label for="q">Tên nhóm</label><input id="q" name="q" value="@Model.Query" maxlength="200" /></div><button type="submit" class="button">Tìm nhóm</button></form>
<div class="table-scroll" tabindex="0" aria-label="Danh sách nhóm quyền, cuộn ngang khi cần"><table class="admin-table account-table"><thead><tr><th>Nhóm</th><th>Thành viên</th><th>Quyền được gán</th><th>Thao tác</th></tr></thead><tbody>@foreach (var row in Model.Items) { <tr><td>@AdminLabels.Role(row.Name)</td><td>@row.MemberCount</td><td>@string.Join(", ", row.Permissions.Select(AdminLabels.Permission))</td><td><a href="/admin/roles/@Uri.EscapeDataString(row.Id)">Xem và chỉnh sửa</a></td></tr> }</tbody></table></div>@if (Model.Items.Count == 0) { <p>Không có nhóm phù hợp.</p> }
<nav class="pagination" aria-label="Phân trang nhóm quyền">@if (Model.Page > 1) { <a href="/admin/roles?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page - 1)">Trang trước</a> }<span>Trang @Model.Page / @Model.PageCount</span>@if (Model.Page < Model.PageCount) { <a href="/admin/roles?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page + 1)">Trang sau</a> }</nav>

@section Styles { <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" /> }
