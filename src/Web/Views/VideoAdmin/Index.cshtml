@model VideoIndexModel
@{Layout="_AdminLayout";ViewData["Title"]="Video tải trực tiếp";}
@section Styles{<link rel="stylesheet" href="~/css/video.css" asp-append-version="true" />}
<div class="admin-title"><h1>Video tải trực tiếp</h1>@if(Model.CanCreate){<a class="button" href="/admin/create?kind=Video">Tạo nội dung video</a>}</div>
<p class="scope-note">Tạo bài video, tải tệp ngay trong trình biên tập, xem trước rồi gửi duyệt và xuất bản. Trạng thái bài viết và trạng thái xử lý tệp được hiển thị riêng.</p>
@if(!Model.Enabled){<p role="status" class="validation-summary">Tải video chưa được mở tại môi trường này. Cán bộ kỹ thuật cần kiểm tra cấu hình và kho tệp đã được cấp.</p>}
@if(Model.Enabled&&Model.Processor!="VIDEO_PROCESSOR_CONFIGURED"){<p role="status" class="scope-note">@AdminLabels.State(Model.Processor). Video chưa đủ điều kiện sẽ tiếp tục chờ, không tự xuất bản.</p>}
@if(ViewData["CanViewVideoDiagnostics"] is true&&ViewData["VideoTools"] is LandPortal.Infrastructure.VideoToolHealth tools){
<details class="video-diagnostics"><summary>Thông tin kỹ thuật dành cho quản trị hệ thống</summary>
<dl class="video-panel">
    <dt>FFmpeg (tài khoản Web)</dt><dd>@(tools.Code=="VIDEO_DISABLED"?"Chưa kiểm tra vì chức năng video đang tắt":tools.Ready?"Sẵn sàng · "+tools.FfmpegVersion:tools.FfmpegFound?"Đã tìm thấy; chưa đủ điều kiện xử lý":"Chưa tìm thấy")</dd>
    <dt>FFprobe (tài khoản Web)</dt><dd>@(tools.Code=="VIDEO_DISABLED"?"Chưa kiểm tra vì chức năng video đang tắt":tools.FfprobeVersion!=null?"Sẵn sàng · "+tools.FfprobeVersion:tools.FfprobeFound?"Đã tìm thấy; chưa xác minh thực thi":"Chưa tìm thấy")</dd>
    <dt>Xử lý video trong website</dt><dd>@AdminLabels.State(ViewData["VideoWorkerCode"] as string ?? "VIDEO_WORKER_UNKNOWN")</dd>
    @if(ViewData["VideoWorkerObservation"] is LandPortal.Infrastructure.VideoWorkerObservation worker){
        <dt>Bộ xử lý cập nhật lúc</dt><dd>@worker.Utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd>
        <dt>Kiểm tra trong ứng dụng</dt><dd>@AdminLabels.State(worker.Tools.Code)</dd>
        <dt>Phiên bản bộ xử lý</dt><dd>FFmpeg: @(worker.Tools.FfmpegVersion ?? "Chưa xác nhận") · FFprobe: @(worker.Tools.FfprobeVersion ?? "Chưa xác nhận")</dd>
        @if(!worker.ScannerReady&&!worker.ManagedVideoWithoutAv){<dt>Scanner</dt><dd>Chưa sẵn sàng; chưa có chính sách video không antivirus được bật.</dd>}
        @if(worker.ToolsChangedUtc!=null){<dt>Thay đổi binary gần nhất</dt><dd>@worker.ToolsChangedUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · Đã ghi nhận hash cũ/mới; không phải xác thực nguồn phát hành.</dd>}
    }
</dl>
<p class="scope-note">Bộ xử lý dùng công cụ trong gói triển khai; không cần tạo Task Scheduler hoặc tài khoản Worker riêng. Khi công cụ chưa sẵn sàng, video tiếp tục chờ, không được tự công bố.</p>
<p class="scope-note">Video chỉ được xử lý khi ứng dụng website đang chạy. Nếu IIS cho ứng dụng nghỉ hoặc khởi động lại, hàng đợi vẫn được lưu và tiếp tục ở lần khởi động kế tiếp. Sau khi dừng đột ngột, tác vụ có thể cần chờ hết hạn khóa xử lý trước khi chạy lại. Trạng thái ở đây không thay thế duyệt và xuất bản.</p>
</details>
}
@if(ViewData["ManagedVideoNoAv"] is true){<p class="scope-note">Video tải mới theo chính sách CMS không antivirus: kiểm định định dạng, chuyển mã và tạo poster; trạng thái vẫn là Chưa quét antivirus. Chỉ công khai sau duyệt và xuất bản.</p>}
<form method="get"><label for="video-query">Tìm tiêu đề video</label><input id="video-query" name="q" maxlength="200" value="@Model.Query" /><label for="video-filter">Trạng thái biên tập</label><select id="video-filter" name="state"><option value="">Tất cả</option>@foreach(var value in Enum.GetValues<LandPortal.Domain.WorkflowState>()){<option value="@value" selected="@(Model.State==value.ToString())">@AdminLabels.State(value)</option>}</select><button class="button" type="submit">Tìm</button></form>
<div class="table-scroll"><table><thead><tr><th scope="col">Ảnh đại diện / tiêu đề</th><th scope="col">Trạng thái bài viết</th><th scope="col">Trạng thái tệp video</th><th scope="col">Ngày tạo / người tải</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@if(item.AssetId!=null&&item.FileState=="Ready"){<img src="/admin/videos/media/@item.AssetId/poster?contentId=@item.Id" alt="Ảnh đại diện video" width="120" loading="lazy" />} @item.Title</td><td class="video-editorial-state">@VideoCmsLabels.Article(item.State,item.IsPublic)</td><td>Video: @VideoCmsLabels.File(item.FileState).@if(item.FileState!="Ready"){<p class="video-next-step">Chỉ phiên bản có tệp đạt kiểm định mới được xuất bản.</p>}</td><td>@item.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />@item.Uploader</td><td><a href="/admin/edit/@item.Id">Mở biên tập và tải video</a></td></tr>}</tbody></table></div>
<nav class="pagination" aria-label="Phân trang video">@if(Model.Page>1){<a href="?page=@(Model.Page-1)&amp;q=@Uri.EscapeDataString(Model.Query??"")&amp;state=@Model.State">Trang trước</a>}<span>Trang @Model.Page · @Model.Total nội dung</span>@if(Model.Page*15<Model.Total){<a href="?page=@(Model.Page+1)&amp;q=@Uri.EscapeDataString(Model.Query??"")&amp;state=@Model.State">Trang sau</a>}</nav>
