@model VideoIndexModel
@{Layout="_AdminLayout";ViewData["Title"]="Video tải trực tiếp";}
<div class="admin-title"><h1>Video tải trực tiếp</h1>@if(Model.CanCreate){<a class="button" href="/admin/create?kind=Video">Tạo metadata video</a>}</div>
<p class="scope-note">Video dùng workflow revision của CMS. Hai video nguồn thiếu tệp vẫn chỉ là metadata; không gắn video thử vào dữ liệu nguồn.</p>
@if(!Model.Enabled){<p role="status" class="validation-summary">Upload video chưa mở tại môi trường này. Cần SQL Test/kho Test và cấu hình được phép; không thay đổi quyền Dev.</p>}
<p>Bộ xử lý: <strong>@Model.Processor</strong>. Trạng thái tải/quét/xử lý xem tại từng nội dung; metadata không có nghĩa tệp đã Ready.</p>
<form method="get"><label for="video-query">Tìm tiêu đề video</label><input id="video-query" name="q" maxlength="200" value="@Model.Query" /><label for="video-filter">Trạng thái revision</label><select id="video-filter" name="state"><option value="">Tất cả</option>@foreach(var value in Enum.GetValues<LandPortal.Domain.WorkflowState>()){<option value="@value" selected="@(Model.State==value.ToString())">@value</option>}</select><button class="button" type="submit">Tìm</button></form>
<div class="table-scroll"><table><thead><tr><th scope="col">Poster / tiêu đề</th><th scope="col">Revision / công khai</th><th scope="col">Tệp</th><th scope="col">Ngày tạo / người tải</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@if(item.AssetId!=null&&item.FileState=="Ready"){<img src="/admin/videos/media/@item.AssetId/poster?contentId=@item.Id" alt="Poster video" width="120" loading="lazy" />} @item.Title</td><td>@item.State / @(item.IsPublic?"Có":"Chưa")</td><td>@item.FileState</td><td>@item.CreatedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />@item.Uploader</td><td><a href="/admin/edit/@item.Id">Metadata / workflow</a>@if(Model.Enabled){<span> · </span><a href="/admin/videos/upload/@item.Id">Tải và kiểm tra tệp</a>}</td></tr>}</tbody></table></div>
<nav class="pagination" aria-label="Phân trang video">@if(Model.Page>1){<a href="?page=@(Model.Page-1)&amp;q=@Uri.EscapeDataString(Model.Query??"")&amp;state=@Model.State">Trang trước</a>}<span>Trang @Model.Page · @Model.Total nội dung</span>@if(Model.Page*15<Model.Total){<a href="?page=@(Model.Page+1)&amp;q=@Uri.EscapeDataString(Model.Query??"")&amp;state=@Model.State">Trang sau</a>}</nav>
