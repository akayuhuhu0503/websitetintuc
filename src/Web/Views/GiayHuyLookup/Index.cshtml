@model GiayHuyLookupModel
@{ ViewData["Title"] = "Giấy chứng nhận sai hỏng, hủy"; Layout = ViewData["GiayHuyLayout"] as string ?? "_Layout"; }
@section Styles { <link rel="stylesheet" href="~/css/giay-huy-lookup.css" asp-append-version="true" /> }
<section class="giay-huy-lookup" aria-labelledby="lookup-title">
    <nav aria-label="Đường dẫn" class="lookup-breadcrumb"><a href="/">Trang chủ</a><span>›</span><a href="/cong-khai-thong-tin">Công khai thông tin</a><span>›</span><span>Giấy chứng nhận sai hỏng, hủy</span></nav>
    <h1 id="lookup-title">Giấy chứng nhận sai hỏng, hủy</h1>
    <p class="lookup-intro">Tra cứu thông tin quyết định, thông báo và số hiệu giấy chứng nhận đã được phép công khai.</p>
    <form method="get" class="lookup-filter" data-lookup-filter>
        <div><label for="lookup-year">Năm</label><select id="lookup-year" name="year"><option value="">Tất cả các năm</option>@foreach (var year in Model.Years) { <option value="@year" selected="@(Model.Year == year)">@year</option> }</select></div>
        <div><label for="lookup-province">DVHC</label><select id="lookup-province" name="province"><option value="">Tất cả Tỉnh/Thành phố</option>@foreach (var province in Model.Provinces) { <option value="@province" selected="@(Model.Province == province)">@province</option> }</select></div>
        <div class="lookup-keyword"><label for="lookup-q">Từ khóa</label><input id="lookup-q" name="q" maxlength="200" value="@Model.Query" placeholder="Số quyết định, số hiệu GCN, nội dung công khai…" /></div>
        <button type="submit">Tra cứu</button><a class="lookup-reset" href="@GiayHuyLookup.Route">Xóa bộ lọc</a>
        <p class="lookup-loading" role="status" hidden>Đang tra cứu…</p>
    </form>
    @if (Model.Unavailable) { <div class="lookup-message" role="alert">Hiện chưa thể kết nối dịch vụ tra cứu. Vui lòng thử lại sau.</div> }
    else {
        <p class="lookup-count" role="status"><strong>@Model.Total</strong> kết quả · Trang @Model.Page</p>
        @if (Model.Rows.Count == 0) { <div class="lookup-message">Chưa có hồ sơ được công bố phù hợp với điều kiện tra cứu.</div> }
        else {
            <div class="lookup-table-wrap" tabindex="0" role="region" aria-label="Kết quả tra cứu, có thể cuộn ngang"><table class="lookup-table"><caption class="visually-hidden">Danh sách giấy chứng nhận sai hỏng, hủy</caption><thead><tr><th scope="col">STT</th><th scope="col">Năm</th><th scope="col">DVHC</th><th scope="col">Số quyết định</th><th scope="col">Nội dung quyết định/thông báo</th><th scope="col">Số hiệu GCN</th><th scope="col">Chi tiết</th></tr></thead><tbody>
            @for (var i = 0; i < Model.Rows.Count; i++) { var row = Model.Rows[i]; <tr><td>@((Model.Page - 1) * 10 + i + 1)</td><td>@(row.Year.Length > 0 ? row.Year : "Chưa xác định")</td><td>@row.Province</td><td>@(row.DecisionNumber.Length > 0 ? row.DecisionNumber : "Chưa công bố")</td><td>@(row.DecisionContent.Length > 0 ? row.DecisionContent : "Chưa công bố nội dung")</td><td>@(row.CertificateSerial.Length > 0 ? row.CertificateSerial : "Chưa công bố")</td><td><a asp-controller="GiayHuyLookup" asp-action="Detail" asp-route-id="@row.Id" asp-route-year="@Model.Year" asp-route-province="@Model.Province" asp-route-q="@Model.Query" asp-route-page="@Model.Page" aria-label="Chi tiết quyết định @row.DecisionNumber">Xem chi tiết →</a></td></tr> }
            </tbody></table></div>
            <nav class="lookup-pagination" aria-label="Phân trang">
                @if (Model.Page > 1) { <a asp-action="Index" asp-route-year="@Model.Year" asp-route-province="@Model.Province" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">← Trang trước</a> }
                <span aria-current="page">@Model.Page / @((Model.Total + 9) / 10)</span>
                @if (Model.Page * 10 < Model.Total) { <a asp-action="Index" asp-route-year="@Model.Year" asp-route-province="@Model.Province" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Trang sau →</a> }
            </nav>
        }
    }
</section>
@section Scripts { <script src="~/js/giay-huy-lookup.js" asp-append-version="true" defer></script> }
