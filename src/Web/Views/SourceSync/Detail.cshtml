@using LandPortal.Infrastructure
@using LandPortal.Domain
@model SourceSyncCheckpoint
@{Layout="_AdminLayout";ViewData["Title"]="Xem bài đồng bộ";var item=(CrawlItem)ViewBag.Item;var existing=ViewBag.Existing as ContentRevision;}
<a href="/admin/source-sync">← Hàng chờ QLDD</a><h1>@(Model.Title.Length>0?Model.Title:"Bài chưa thu thập được")</h1>
<p>@SourceSyncPolicy.Label(item.Status) · <a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Xem bài gốc tại QLDD</a></p>
<div id="sync-feedback" role="status" aria-live="polite"></div>
@if(Model.Warnings.Count>0){<div class="validation-summary-errors"><h2>Cần kiểm tra trước khi gửi duyệt</h2><ul>@foreach(var warning in Model.Warnings){<li>@warning</li>}</ul></div>}
@if(Model.Source is {} source){<dl><dt>Ngày đăng nguồn</dt><dd>@(source.OriginalDateText.Length==0?"Nguồn không cung cấp":source.OriginalDateText) (@source.DatePrecision)</dd><dt>Tác giả</dt><dd>@(source.Author.Length==0?"Nguồn không cung cấp":source.Author)</dd><dt>Chuyên mục nguồn</dt><dd>@source.PrimaryCategoryId</dd></dl>
<div class="source-sync-comparison"><section><h2>Nội dung nhận từ nguồn</h2><p><strong>@SourceSyncPolicy.Summary(source)</strong></p><div class="source-sync-preview">@Html.Raw(SourceSyncMedia.Preview(source))</div></section>
@if(existing!=null){<section><h2>Bản CMS hiện tại (không bị thay đổi)</h2><h3>@existing.Title</h3><p>@existing.Summary</p><div>@(new HtmlPolicy().PlainText(existing.BodyHtml))</div></section>}</div>
<h2>Tài nguyên đã lưu riêng</h2><p>Chưa gắn vào bài và chưa được coi là đã quét virus. Khi chuyển sang nháp, hệ thống kiểm định theo chính sách hiện hành; tệp không đạt sẽ bị loại và ghi cảnh báo.</p>
<ul>@foreach(var file in Model.Assets){<li>@file.Name · @(file.Bytes/1024) KB · @file.Mime</li>}</ul>}
@if(ViewBag.ExistingId is Guid id){<p><a class="button" href="/admin/edit/@id">Mở bài hiện có trong CMS</a></p>}
else if(item.Status is "Ready" or "Review" && (bool)ViewBag.CanCreate && !Model.WeeklyReviewRequired && Model.ReconcileContentIds.Count==0){<form method="post" action="/admin/source-sync/@item.Id/draft" data-sync-form>@Html.AntiForgeryToken()<input type="hidden" name="hash" value="@Model.Hash"/><input type="hidden" name="assetHash" value="@Model.AssetHash"/><button class="button">Chuyển vào bản nháp biên tập</button></form>}
@if(Model.ReconcileContentIds.Count>0){<p>Lịch này có thể đã được nhập từ Excel. Cần đối soát bài hiện có trước khi tiếp nhận; hệ thống không tạo thêm bài.</p>}
@if(ViewBag.BindingCandidates is List<WeeklyBindingCandidate> candidates && candidates.Count>0){
<section><h2>Nối lịch nguồn với hồ sơ đã có</h2><p>Chỉ nối khi cùng Lãnh đạo Cục, năm và tuần. Không thay đổi tiêu đề, ngày, bản công khai hoặc lịch hẹn. PDF khác hash sẽ được đề nghị bổ sung qua bản sửa nháp.</p>
@foreach(var candidate in candidates){<div class="settings-panel"><a href="/admin/edit/@candidate.Id" target="_blank" rel="noopener">@candidate.Title</a><p>@(candidate.Year.HasValue?$"Tuần {candidate.Week}/{candidate.Year}":"Năm/tuần trong hồ sơ chưa nhất quán; cần đối soát trước khi nối.")</p>
@if(candidate.CanBind && (bool)ViewBag.CanCreate){<form method="post" action="/admin/source-sync/@item.Id/bind-weekly" data-sync-form>@Html.AntiForgeryToken()
<input type="hidden" name="contentId" value="@candidate.Id"/><input type="hidden" name="hash" value="@Model.Hash"/><input type="hidden" name="assetHash" value="@Model.AssetHash"/><input type="hidden" name="version" value="@candidate.Version"/><input type="hidden" name="commandId" value="@Guid.NewGuid()"/>
<button class="button secondary">Nối với hồ sơ này</button></form>}</div>}
</section>}
@if(item.Status=="Changed" && Model.Source?.PrimaryCategoryId==76 && !Model.WeeklyReviewRequired && ViewBag.ExistingId is Guid updateId && (bool)ViewBag.CanCreate){
<form method="post" action="/admin/source-sync/@item.Id/update" data-sync-form>@Html.AntiForgeryToken()
<input type="hidden" name="contentId" value="@updateId"/><input type="hidden" name="hash" value="@Model.Hash"/><input type="hidden" name="assetHash" value="@Model.AssetHash"/>
<input type="hidden" name="version" value="@ViewBag.Version"/><input type="hidden" name="commandId" value="@Guid.NewGuid()"/>
<button class="button">Tạo bản sửa nháp để bổ sung PDF</button><p>Giữ bản công khai và nội dung đã biên tập. Nếu đang có bản sửa hoặc lịch hẹn, hệ thống sẽ dừng để tránh ghi đè.</p></form>}
@section Scripts {<link rel="stylesheet" href="~/css/source-sync.css" asp-append-version="true"/><script src="~/js/source-sync.js" asp-append-version="true" defer></script>}
