@using LandPortal.Infrastructure
@model SourceSyncPage
@{var pending=Model.Counts.GetValueOrDefault("Queued")+Model.Counts.GetValueOrDefault("Ready")+Model.Counts.GetValueOrDefault("Changed");var review=Model.Counts.GetValueOrDefault("Review")+Model.Counts.GetValueOrDefault("Error");var history=Model.Counts.GetValueOrDefault("Drafted")+Model.Counts.GetValueOrDefault("Existing")+Model.Counts.GetValueOrDefault("Ignored");}
<nav class="source-sync-tabs" aria-label="Danh sách đồng bộ">
@foreach(var tab in new[]{("pending","Chờ xử lý",pending),("review","Cần kiểm tra",review),("history","Lịch sử",history)}){<a href="@Url.Action("Index",new{tab=tab.Item1,q=Model.Query})" aria-current="@(Model.Tab==tab.Item1?"page":null)">@tab.Item2 (@tab.Item3)</a>}
</nav>
<div class="source-sync-summary">
@if(Model.Settings.Cycle is {} cycle){<p><strong>@(cycle.FinishedUtc.HasValue?"Đã hoàn thành vòng kiểm tra":Model.Settings.ConsecutiveFailures>=3?"Vòng kiểm tra đang tạm dừng":cycle.WaitingForCapacity?"Đang chờ giải phóng hàng chờ":"Vòng kiểm tra đang tiếp tục")</strong> · Chuyên mục: @cycle.CategoryIndex/@cycle.Categories.Count · Mới phát hiện: @cycle.NewEntries · Đã đọc chi tiết: @cycle.DetailsChecked · Còn chờ: @cycle.Pending.Count · Lỗi: @cycle.Errors</p>@foreach(var warning in cycle.Warnings.Distinct()){<p>@warning</p>}}
<p><strong>@(Model.Settings.Enabled?"Định kỳ đang bật":"Định kỳ đang tắt")</strong> · @(Model.Running?"Đang kiểm tra nguồn":Model.Settings.ConsecutiveFailures>=3?"Tạm dừng do lỗi nguồn":Model.Settings.LastError!=null?"Đang chờ thử lại":"Sẵn sàng")</p>
<p>Kiểm tra gần nhất: @(Model.Settings.LastCheckedUtc?.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy")??"Chưa kiểm tra")</p>
<p>Mới phát hiện: @Model.Counts.GetValueOrDefault("Queued") · Chờ biên tập: @Model.Counts.GetValueOrDefault("Ready") · Nguồn cập nhật: @Model.Counts.GetValueOrDefault("Changed") · Cần kiểm tra/lỗi: @(Model.Counts.GetValueOrDefault("Review")+Model.Counts.GetValueOrDefault("Error"))</p>
@if(Model.Settings.LastError is string error){<p class="validation-summary-errors">@error</p>}
</div>
<div class="table-responsive"><table><thead><tr><th>Bài nguồn</th><th>Trạng thái</th><th>Kiểm tra gần nhất</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Items){<tr><td><a href="/admin/source-sync/@row.Id">@(string.IsNullOrEmpty(row.Title)?"Chờ lấy tiêu đề từ nguồn":row.Title)</a>@if(row.Error!=null){<small class="source-sync-warning">@row.Error</small>}</td><td>@SourceSyncPolicy.Label(row.Status)</td><td>@row.UpdatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy")</td><td><a href="@row.Url" target="_blank" rel="noopener noreferrer">Xem nguồn</a> · <a href="/admin/source-sync/@row.Id">Xem trước</a>
@if(Guid.TryParse(row.ContentId,out var contentId)){<a href="/admin/edit/@contentId">Mở bản biên tập</a>}
@if(row.Status is not("Ignored" or "Drafted" or "Existing")){<form action="/admin/source-sync/@row.Id/state" method="post" data-sync-form>@Html.AntiForgeryToken()<input type="hidden" name="action" value="ignore" /><button class="link-button">Bỏ qua</button></form>}
@if(row.Status is "Error" or "Review"){<form action="/admin/source-sync/@row.Id/state" method="post" data-sync-form>@Html.AntiForgeryToken()<input type="hidden" name="action" value="retry" /><button class="link-button">Thử lại</button></form>}</td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="4">Không có bài trong danh sách này. Đồng bộ không tự công bố nội dung.</td></tr>}
</tbody></table></div>
<nav class="pagination" aria-label="Phân trang hàng chờ">@if(Model.Page>1){<a href="@Url.Action("Index",new{page=Model.Page-1,q=Model.Query,status=Model.Status,tab=Model.Tab})">Trang trước</a>}<span>Trang @Model.Page · @Model.Total bài</span>@if(Model.Page*20<Model.Total){<a href="@Url.Action("Index",new{page=Model.Page+1,q=Model.Query,status=Model.Status,tab=Model.Tab})">Trang sau</a>}</nav>
