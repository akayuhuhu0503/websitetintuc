@using LandPortal.Infrastructure
@using LandPortal.MigrationCli
@using LandPortal.Domain
@model SourceSyncPage
@{ Layout="_AdminLayout"; ViewData["Title"]="Đồng bộ QLDD"; var categories=(List<Category>)ViewBag.Categories; }
<header class="page-header"><div><h1>Đồng bộ QLDD</h1><p>Nhận tin từ qldd.mae.gov.vn vào hàng chờ. Cán bộ kiểm tra và gửi duyệt như bài viết thông thường.</p></div></header>
<p class="help-text">Một lần bấm kiểm tra sẽ lần lượt kiểm tra các chuyên mục đã ánh xạ, tối đa 5 trang gần nhất mỗi chuyên mục. Các lượt nhỏ tự tiếp tục và lưu tiến độ; bài mới được ưu tiên trước bài đã có. IIS dừng/nghỉ thì việc kiểm tra sẽ tiếp tục khi Web chạy lại.</p>
<div id="sync-feedback" role="status" aria-live="polite"></div>
<div class="source-sync-actions">
<form method="post" action="/admin/source-sync/check" data-sync-form>@Html.AntiForgeryToken()<button class="button">Kiểm tra bài mới ngay</button></form>
<form method="post" action="/admin/source-sync/configure" data-sync-form>@Html.AntiForgeryToken()<label>Đồng bộ định kỳ <select name="enabled"><option value="false" selected="@(!Model.Settings.Enabled)">Tắt</option><option value="true" selected="@Model.Settings.Enabled">Bật</option></select></label><button class="button secondary">Lưu</button></form>
</div>
<details class="settings-panel"><summary>Ánh xạ chuyên mục nguồn → chuyên mục GDLA</summary>
<p>Chọn đúng chuyên mục đích; không tự đoán theo tên hoặc số ID. Lựa chọn này không sửa cấu trúc chuyên mục CMS.</p>
@foreach(var source in SourceCatalog.Categories.Where(x=>SourceSyncStore.Categories.Contains(x.Id))){
<form method="post" action="/admin/source-sync/configure" class="source-sync-mapping" data-sync-form>
@Html.AntiForgeryToken()<input type="hidden" name="sourceCategory" value="@source.Id" /><label for="mapping-@source.Id">@source.Name</label>
<select name="targetCategory" id="mapping-@source.Id"><option value="">Chưa ánh xạ</option>@foreach(var category in categories){<option value="@category.Id" selected="@(Model.Settings.Categories.GetValueOrDefault(source.Id)==category.Id)">@category.Name</option>}</select><button class="button secondary">Lưu ánh xạ</button></form>}
</details>
<form method="get" class="source-sync-actions" id="sync-filter"><input type="hidden" name="tab" value="@Model.Tab"/><label>Tìm tiêu đề <input name="q" value="@Model.Query" maxlength="200" /></label><label>Trạng thái <select name="status"><option value="">Tất cả</option>@foreach(var s in new[]{"Queued","Ready","Review","Changed","Error","Drafted","Existing","Ignored"}){<option value="@s" selected="@(Model.Status==s)">@SourceSyncPolicy.Label(s)</option>}</select></label><label>Chuyên mục nguồn <select name="sourceCategory"><option value="">Tất cả</option>@foreach(var c in SourceCatalog.Categories.Where(x=>SourceSyncStore.Categories.Contains(x.Id))){<option value="@c.Id" selected="@(Model.SourceCategory==c.Id)">@c.Name</option>}</select></label><label>Từ ngày nguồn <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))"/></label><label>Đến ngày nguồn <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))"/></label><button class="button secondary">Lọc</button></form>
<section class="settings-panel source-bulk" data-user="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
@Html.AntiForgeryToken()
<p id="source-bulk-count" role="status">Đã chọn 0 bài</p><p>Chọn tối đa 100 bài qua các trang trong cùng bộ lọc. Bài đã chuyển CMS, đang công khai hoặc hẹn giờ được giữ nguyên.</p>
<div class="source-sync-actions"><button type="button" class="button secondary" id="source-bulk-clear">Bỏ chọn tất cả</button>
<label>Thao tác <select id="source-bulk-action"><option value="">Chọn thao tác…</option>
@foreach(var action in (string[])ViewBag.SourceBulkActions){<option value="@action">@(action=="PublishDirect"?"Đăng trực tiếp":action=="Draft"?"Chuyển vào bản nháp":"Bỏ qua")</option>}</select></label>
@foreach(var action in (string[])ViewBag.SourceBulkActions){<button type="button" class="button @(action=="PublishDirect"?"":"secondary")" data-source-bulk-action="@action" disabled>@(action=="PublishDirect"?"Đăng trực tiếp":action=="Draft"?"Chuyển vào bản nháp":"Bỏ qua")</button>}</div>
<p id="source-bulk-notice" role="status"></p></section>
<div data-sync-results>@await Html.PartialAsync("_Results",Model)</div>
<dialog id="source-bulk-dialog" aria-labelledby="source-bulk-heading"><h2 id="source-bulk-heading">Xác nhận thao tác</h2>
<p id="source-bulk-summary" role="status"></p><progress id="source-bulk-progress" hidden></progress><ul id="source-bulk-results"></ul>
<button type="button" class="button" id="source-bulk-confirm">Xác nhận thực hiện</button><button type="button" class="button secondary" id="source-bulk-close">Đóng</button></dialog>
@section Scripts {<link rel="stylesheet" href="~/css/source-sync.css" asp-append-version="true" /><script src="~/js/source-sync.js" asp-append-version="true" defer></script><script src="~/js/source-bulk.js" asp-append-version="true" defer></script>}
