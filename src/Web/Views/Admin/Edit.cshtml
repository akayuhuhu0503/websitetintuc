@model EditorModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.Id is null ? "Soạn bài mới" : "Biên tập bài viết"; }
@section Styles { <link rel="stylesheet" href="~/vendor/jodit/jodit.min.css" asp-append-version="true" /> }
<div class="admin-title"><div><a class="back-link" href="/admin">← Danh sách bài viết</a><h1>@ViewData["Title"]</h1></div><div class="editor-state"><span class="workflow-badge">@Model.CurrentStatus</span><span class="workflow-badge public-badge">@(Model.IsPublished ? "Có bản đang công khai" : "Chưa công khai")</span></div></div>
@if (Model.IsPublished) { <p class="scope-note">Bạn đang làm việc trên bản biên tập. Bản công khai giữ nguyên tiêu đề, chuyên mục, ảnh và nội dung cho đến lần xuất bản tiếp theo.</p> }
@if (Model.RejectionReason is not null) { <div class="validation-summary" role="alert"><strong>Lý do trả bài:</strong> @Model.RejectionReason</div> }
<form id="editor-form" class="editor-layout" method="post" action="/admin/save" data-state="@Model.DraftState" data-can-save="@Model.CanSave.ToString().ToLowerInvariant()" data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    @Html.AntiForgeryToken()
    <input asp-for="Kind" type="hidden" /><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><input asp-for="CurrentRevisionId" type="hidden" /><input asp-for="CoverAssetId" type="hidden" /><input asp-for="RequestId" type="hidden" />
    @for (var index = 0; index < Model.PreservedAssets.Count; index++) { <input asp-for="PreservedAssets[index].Id" type="hidden" /><input asp-for="PreservedAssets[index].Usage" type="hidden" /><input asp-for="PreservedAssets[index].Caption" type="hidden" /><input asp-for="PreservedAssets[index].SortOrder" type="hidden" /> }
    <div class="editor-main">
        @if(Model.DocumentWarnings.Count > 0) { <div class="editor-notice" role="status"><h2>Xem trước từ tài liệu — chưa lưu</h2><ul>@foreach(var warning in Model.DocumentWarnings){<li>@warning</li>}</ul></div> }
        @if(Model.Id != null && Model.CanSave && Model.CanManageMedia){<p><a href="/admin/documents/@Model.Id">Tải / quét tài liệu PDF, Excel hoặc Word lịch tuần</a></p>}
        <p class="eyebrow">Mẫu: @LandPortal.Web.Services.PublicContentQuery.KindLabel(Model.Kind)</p>
        <partial name="_TypedMetadata" model="Model" />
        <partial name="_V05Metadata" model="Model" />
    @foreach(var videoId in Model.VideoAssetIds){<div data-video-reference="@videoId"><input type="hidden" name="VideoAssetIds" value="@videoId" /><div class="form-field"><label for="video-caption-@videoId">Chú thích video @videoId.ToString().Substring(0,8)</label><input id="video-caption-@videoId" name="AttachmentLabels[@videoId]" value="@Model.AttachmentLabels.GetValueOrDefault(videoId, "")" maxlength="2000" readonly="@(!Model.CanSave)" /></div>@if(Model.CanSave){<button type="button" class="link-button" data-remove-video="@videoId">Gỡ video và các phụ đề khỏi nháp</button>}</div>}
    @foreach(var track in Model.SubtitleAssetIds){<span data-subtitle-reference="@track"><input type="hidden" name="SubtitleAssetIds" value="@track" />Phụ đề @track.ToString().Substring(0,8) @if(Model.CanSave){<button type="button" class="link-button" data-remove-subtitle>Gỡ phụ đề khỏi nháp</button>}</span>}
        @if(Model.Id is not null && Model.CanSave && Model.CanManageMedia && Model.CanManageVideos){<p><a class="outline-link" href="/admin/videos/upload/@Model.Id">Tải hoặc chọn video nội bộ cho bản nháp</a></p>}
        @if(Model.VideoAssetIds.Length>0){<p class="scope-note">Bản nháp gắn @Model.VideoAssetIds.Length video nội bộ. Mọi lần đăng đều kiểm tra scanner, rendition và poster.</p>}
        @if (ViewData.ModelState.ErrorCount > 0) { <div asp-validation-summary="All" class="validation-summary" role="alert"></div> }
        <div id="editor-feedback" class="editor-feedback" role="status" aria-live="polite">@(Model.CanSave ? "Chưa có thay đổi cần lưu." : "Phiên bản này đang được kiểm duyệt; chỉ xem nội dung và thực hiện thao tác được cấp quyền.")</div>
        <div class="form-field"><label asp-for="Title"></label><input asp-for="Title" class="title-input" maxlength="500" placeholder="Nhập tiêu đề bài viết" readonly="@(!Model.CanSave)" /><span asp-validation-for="Title"></span></div>
        <div class="form-field"><label asp-for="Summary"></label><textarea asp-for="Summary" rows="3" maxlength="2000" placeholder="Đoạn giới thiệu ngắn" readonly="@(!Model.CanSave)"></textarea><span asp-validation-for="Summary"></span></div>
        @if(Model.Kind is LandPortal.Domain.ContentKind.Article or LandPortal.Domain.ContentKind.Announcement){<p class="form-help">Trước khi gửi duyệt hoặc đăng, bài mới cần sapo, tên tác giả và ảnh đại diện. Có thể lưu nháp khi chưa điền đủ.</p><div class="form-field"><label asp-for="Metadata.Tags">Từ khóa (ngăn cách bằng dấu phẩy)</label><input asp-for="Metadata.Tags" maxlength="500" readonly="@(!Model.CanSave)"/></div><label><input type="checkbox" name="Metadata.Featured" value="true" checked="@(Model.Metadata.Featured==true)" disabled="@(!Model.CanSave)"/> Ghim vào khối Tin nổi bật khi phiên bản được xuất bản</label><input type="hidden" name="Metadata.Featured" value="false"/><div class="form-field"><label asp-for="CoverCaption"></label><textarea asp-for="CoverCaption" rows="2" maxlength="2000" readonly="@(!Model.CanSave)"></textarea></div>}
        <div class="form-field editor-content-field"><label asp-for="BodyHtml"></label><p class="form-help">Soạn văn bản, bảng và chú thích trực tiếp. Dán từ Word được làm sạch định dạng. Ảnh và PDF được chèn từ kho riêng của hệ thống; không dán HTML.</p><textarea asp-for="BodyHtml" id="content-html" rows="20" readonly="@(!Model.CanSave)" hidden></textarea><noscript><p class="validation-summary">Cần bật JavaScript để sử dụng trình soạn thảo nội dung.</p></noscript><span asp-validation-for="BodyHtml"></span></div>
        @if (Model.CanSave && Model.CanManageMedia) { <div class="editor-insert-actions"><button class="button secondary" type="button" data-open-media="inline">Chèn ảnh có chú thích</button><button class="button secondary" type="button" data-open-media="attachment">Thêm PDF đính kèm</button></div> }
    </div>
    <aside class="editor-settings">
        <section class="settings-panel"><h2>Quy trình bài viết</h2><p class="form-help">Mỗi lần duyệt gắn với phiên bản cụ thể. Bản sửa sau duyệt cần được gửi duyệt lại.</p>
            @if (Model.CanSave) { <button class="button secondary full-width" type="submit" name="intent" value="Save" data-save>Lưu bản nháp</button> }
            @if (Model.CanSubmit && Model.CanSave) { <button class="button full-width" type="submit" name="intent" value="Submit" data-save-submit>Lưu và gửi duyệt</button> }
            @if (Model.CanPublish && Model.CanSave) { <button class="button publish full-width" type="submit" name="intent" value="Publish" data-save-publish>Lưu và đăng trực tiếp</button> }
            @if (Model.Id is not null) {
                <a class="outline-link full-width" id="preview-link" href="/admin/preview/@Model.Id" target="_blank" rel="noopener">Xem trước bản đã lưu ↗</a>
                @if (Model.CanReview && Model.DraftState == "PendingReview") { <button class="button full-width" type="button" data-workflow="Approve">Duyệt phiên bản này</button><div class="form-field"><label for="review-reason">Lý do trả bài</label><textarea id="review-reason" rows="3" maxlength="2000"></textarea></div><button class="button secondary full-width" type="button" data-workflow="Reject">Trả bài kèm lý do</button> }
                @if (Model.CanPublishApproved && Model.DraftState == "Approved") { <button class="button publish full-width" type="button" data-workflow="PublishApproved">Xuất bản phiên bản đã duyệt</button> }
                @if (Model.CanBeginEdit) { <button class="button secondary full-width" type="button" data-workflow="StartDraft">Mở bản sửa mới</button> }
                @if(Model.CanSchedule) { <a class="outline-link full-width" href="/admin/schedules/edit?contentId=@Model.Id">Hẹn giờ phiên bản đã lưu</a> }<a class="outline-link full-width" href="/admin/history/@Model.Id">Lịch sử và so sánh phiên bản</a>
                @if (Model.CanClone) { <button class="button secondary full-width" type="button" data-workflow="Clone">Nhân bản thành bài nháp mới</button> }
                @if (Model.IsPublished) { <a class="outline-link full-width" href="/bai-viet/@Model.Id" target="_blank" rel="noopener">Xem phiên bản công khai ↗</a> }
                @if (Model.CanUnpublish && Model.IsPublished) { <button class="button danger full-width" type="button" data-workflow="Unpublish" data-confirm="Gỡ bài khỏi cổng thông tin? Bản biên tập và lịch sử vẫn được giữ.">Gỡ bài công khai</button> }
                @if (Model.CanRestore && Model.IsTrashed) { <button class="button secondary full-width" type="button" data-workflow="RestoreTrash">Khôi phục từ thùng rác</button> }
                @if (Model.CanTrash && !Model.IsTrashed) { <button class="button danger full-width" type="button" data-workflow="Trash" data-confirm="Chuyển bài vào thùng rác? Bài sẽ không còn công khai.">Chuyển vào thùng rác</button> }
            }
            <p class="form-help">Lịch đăng được quản lý riêng theo phiên bản và quyền. Video phải được quét và xử lý sẵn sàng trước khi xuất bản.</p>
        </section>
        <section class="settings-panel"><h2>Thông tin bài viết</h2>
            <div class="form-field"><label asp-for="CategoryId"></label><select asp-for="CategoryId" disabled="@(!Model.CanSave)"><option value="">Chọn chuyên mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId"></span></div>
            <fieldset class="category-checkboxes" disabled="@(!Model.CanSave)"><legend>Chuyên mục phụ</legend>@foreach (var category in Model.Categories) { <label><input type="checkbox" name="SecondaryCategoryIds" value="@category.Id" checked="@(Model.SecondaryCategoryIds.Contains(category.Id))" /> @category.Name</label> }</fieldset>
            <div class="form-field"><label asp-for="Author"></label><input asp-for="Author" maxlength="300" readonly="@(!Model.CanSave)" /></div><div class="form-field"><label asp-for="SourceName"></label><input asp-for="SourceName" maxlength="300" readonly="@(!Model.CanSave)" /></div>
        </section>
        <section class="settings-panel"><h2>Ảnh đại diện</h2><div id="cover-preview">@if (Model.CoverAssetId is not null && Model.Id is not null) { <img src="/admin/media/@Model.CoverAssetId/preview?contentId=@Model.Id" alt="Ảnh đại diện đang biên tập" /> }</div>@if (Model.CanSave && Model.CanManageMedia) { <button class="button secondary full-width" type="button" data-open-media="cover">Chọn hoặc tải ảnh</button><button class="link-button remove-cover" type="button">Bỏ ảnh đại diện</button> }<p class="form-help">Bài nguồn thiếu ảnh vẫn được giữ; không bắt bổ sung ảnh để lưu dữ liệu đã chuyển.</p></section>
        <section class="settings-panel"><h2>Tài liệu đính kèm</h2><ul id="selected-attachments" class="attachment-editor-list">@foreach (var asset in Model.SelectedMedia.Where(x => Model.AttachmentIds.Contains(x.Id))) { <li data-asset="@asset.Id"><input type="hidden" name="AttachmentIds" value="@asset.Id" /><span>@asset.Name</span><label for="attachment-label-@asset.Id">Nhãn tài liệu</label><input class="attachment-caption" id="attachment-label-@asset.Id" name="AttachmentLabels[@asset.Id]" value="@Model.AttachmentLabels.GetValueOrDefault(asset.Id, "")" maxlength="2000" readonly="@(!Model.CanSave)" />@if (Model.CanSave) { <button type="button" class="link-button" data-remove-attachment>Gỡ khỏi bản nháp</button> }</li> }</ul><p class="form-help">PDF nguồn giữ nguyên byte. Tệp nháp không thể tải bởi khách chưa đăng nhập.</p></section>
    </aside>
</form>
@if (Model.CanSave && Model.CanManageMedia) {
<dialog id="media-dialog" aria-labelledby="media-dialog-title"><div class="media-dialog-heading"><h2 id="media-dialog-title">Kho ảnh và PDF</h2><button type="button" class="button secondary" data-close-media>Đóng</button></div><p class="form-help">Tệp được kiểm tra định dạng; chưa có máy quét mã độc production. Tệp tải trong môi trường phát triển được ghi trung thực là chưa quét.</p><div class="media-upload"><label for="media-upload-file">Tải tệp từ máy (ảnh hoặc PDF)</label><input id="media-upload-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" /><progress id="upload-progress" value="0" max="100" hidden></progress><p id="upload-feedback" role="status" aria-live="polite"></p></div><div class="media-search"><label for="media-search">Tìm tên tệp</label><input id="media-search" maxlength="200" /><button type="button" class="button secondary" data-search-media>Tìm</button></div><div class="form-field"><label for="media-caption">Chú thích ảnh</label><input id="media-caption" maxlength="1000" placeholder="Nhập mô tả ảnh cho người đọc" /></div><div id="media-items" class="media-grid"></div><div id="media-pagination" class="pagination"></div></dialog>
}
<dialog id="reauth-dialog" aria-labelledby="reauth-title"><h2 id="reauth-title">Xác thực lại để tiếp tục</h2><p>Nội dung chưa lưu vẫn giữ trong trang này, không lưu vào localStorage. Không đóng hoặc tải lại trang trước khi lưu.</p><form id="reauth-form"><div class="form-field"><label for="reauth-user">Tên đăng nhập của phiên vừa hết hạn</label><input id="reauth-user" name="userName" autocomplete="username" maxlength="256" required /></div><div class="form-field"><label for="reauth-password">Mật khẩu</label><input id="reauth-password" name="password" type="password" autocomplete="current-password" maxlength="256" required /></div><div class="form-field"><label id="reauth-captcha-question" for="reauth-captcha-answer">Câu hỏi xác thực được tải khi cần xác thực lại</label><input id="reauth-captcha-answer" name="captchaAnswer" autocomplete="off" inputmode="numeric" maxlength="3" required /><input name="captchaId" type="hidden" /><button type="button" data-refresh-reauth>Câu hỏi mới</button></div><p id="reauth-feedback" role="status"></p><button class="button" type="submit">Xác thực lại</button><button class="button secondary" type="button" data-close-reauth>Tiếp tục giữ bản soạn ở trang này</button></form></dialog>
@section Scripts { <script src="~/vendor/jodit/jodit.min.js" asp-append-version="true" defer></script><script src="~/js/editor.js" asp-append-version="true" defer></script> }

