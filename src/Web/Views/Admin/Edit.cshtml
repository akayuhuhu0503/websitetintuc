@model EditorModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.Id is null ? "Soạn bài mới" : "Biên tập bài viết";
   var backToList = Context.Request.Query["returnUrl"].ToString();
   if (!Url.IsLocalUrl(backToList) || backToList.Split('?')[0] != "/admin") backToList = "/admin";
}
@functions {
    private static string FileDescription(EditorMedia file) {
        var kind = file.MimeType switch { "application/pdf" => "PDF", "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "Word", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "Excel", _ => "Tài liệu" };
        return kind + " · " + (file.Bytes >= 1048576 ? (file.Bytes / 1048576d).ToString("0.#") + " MB" : Math.Max(1, Math.Ceiling(file.Bytes / 1024d)).ToString("0") + " KB");
    }
}
@section Styles { <link rel="stylesheet" href="~/vendor/jodit/jodit.min.css" asp-append-version="true" /> }
<div class="admin-title"><div><a class="back-link" href="@backToList">← Danh sách bài viết</a><h1>@ViewData["Title"]</h1></div><div class="editor-state"><span class="workflow-badge">@Model.CurrentStatus</span><span class="workflow-badge public-badge">@(Model.IsPublished ? "Có bản đang công khai" : "Chưa công khai")</span></div></div>
@if (Model.IsPublished) { <p class="scope-note">Bạn đang làm việc trên bản biên tập. Bản công khai giữ nguyên tiêu đề, chuyên mục, ảnh và nội dung cho đến lần xuất bản tiếp theo.</p> }
@if (Model.RejectionReason is not null) { <div class="validation-summary" role="alert"><strong>Lý do trả bài:</strong> @Model.RejectionReason</div> }
<nav class="editor-shortcuts" aria-label="Đi nhanh trong bài"><a href="#editor-content-field">Soạn nội dung</a><a href="#editor-files">Ảnh, tài liệu và video</a><a href="#editor-actions">Lưu / Gửi duyệt / Xuất bản</a></nav>
<form id="editor-form" class="editor-layout" method="post" action="/admin/save" data-state="@Model.DraftState" data-can-save="@Model.CanSave.ToString().ToLowerInvariant()" data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    @Html.AntiForgeryToken()
    <input asp-for="Kind" type="hidden" /><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><input asp-for="CurrentRevisionId" type="hidden" /><input asp-for="CoverAssetId" type="hidden" /><input asp-for="RequestId" type="hidden" />
    @for (var index = 0; index < Model.PreservedAssets.Count; index++) { <input asp-for="PreservedAssets[index].Id" type="hidden" /><input asp-for="PreservedAssets[index].Usage" type="hidden" /><input asp-for="PreservedAssets[index].Caption" type="hidden" /><input asp-for="PreservedAssets[index].SortOrder" type="hidden" /> }
    <div class="editor-main">
        <p class="editor-save-help">Lưu nháp: chỉ cần tiêu đề; nếu được giới hạn chuyên mục, cần chọn chuyên mục được giao. Có thể bổ sung thông tin còn thiếu sau. <strong>* Thông tin bắt buộc khi gửi duyệt/đăng.</strong></p>
        @if(Model.DocumentWarnings.Count > 0) { <div class="editor-notice" role="status"><h2>Xem trước từ tài liệu — chưa lưu</h2><ul>@foreach(var warning in Model.DocumentWarnings){<li>@warning</li>}</ul></div> }
        <p class="eyebrow">@LandPortal.Web.Services.PublicContentQuery.KindLabel(Model.Kind)</p>
        @if (ViewData.ModelState.ErrorCount > 0) { <div asp-validation-summary="All" class="validation-summary" role="alert"></div> }
        <div id="editor-feedback" tabindex="-1" class="editor-feedback" role="status" aria-live="polite">@(Model.CanSave ? "Chưa có thay đổi cần lưu." : "Phiên bản này đang được kiểm duyệt; chỉ xem nội dung và thực hiện thao tác được cấp quyền.")</div>
        <div class="form-field"><label asp-for="Title">Tiêu đề * <small>(cần để lưu nháp)</small></label><input asp-for="Title" class="title-input" maxlength="500" placeholder="Nhập tiêu đề bài viết" readonly="@(!Model.CanSave)" /><span asp-validation-for="Title"></span></div>
        <div class="form-field"><label asp-for="Summary">Mô tả ngắn @(LandPortal.Infrastructure.AnnouncementTemplatePolicy.RequiresArticleFields(Model.Kind) ? "*" : "(không bắt buộc)")</label><textarea asp-for="Summary" rows="3" maxlength="2000" placeholder="Đoạn giới thiệu ngắn" readonly="@(!Model.CanSave)"></textarea><span asp-validation-for="Summary"></span></div>
        @if(Model.Kind is LandPortal.Domain.ContentKind.Article or LandPortal.Domain.ContentKind.Announcement){@if(LandPortal.Infrastructure.AnnouncementTemplatePolicy.RequiresArticleFields(Model.Kind)){<p class="form-help">Trước khi gửi duyệt hoặc đăng, tin mới cần sapo, tên tác giả và ảnh đại diện. Có thể lưu nháp khi chưa điền đủ.</p>}else{<p class="form-help">Thông báo cần tiêu đề, chuyên mục chính và nội dung hoặc PDF đính kèm hợp lệ. Sapo, tác giả và ảnh đại diện không bắt buộc. PDF thay nội dung phải đạt kiểm định theo chính sách hiện hành trước khi gửi duyệt/đăng; có thể lưu nháp khi chưa đủ.</p>}<div class="form-field"><label asp-for="Metadata.Tags">Từ khóa (ngăn cách bằng dấu phẩy)</label><input asp-for="Metadata.Tags" maxlength="500" readonly="@(!Model.CanSave)"/></div><label><input type="checkbox" name="Metadata.Featured" value="true" checked="@(Model.Metadata.Featured==true)" disabled="@(!Model.CanSave)"/> Ghim vào khối Tin nổi bật khi phiên bản được xuất bản</label><input type="hidden" name="Metadata.Featured" value="false"/><div class="form-field"><label asp-for="CoverCaption"></label><textarea asp-for="CoverCaption" rows="2" maxlength="2000" readonly="@(!Model.CanSave)"></textarea></div>}
        <div class="form-field editor-content-field" id="editor-content-field" tabindex="-1"><label asp-for="BodyHtml">Nội dung @(LandPortal.Infrastructure.AnnouncementTemplatePolicy.RequiresArticleFields(Model.Kind) ? "*" : Model.Kind == LandPortal.Domain.ContentKind.Announcement ? "(hoặc PDF đính kèm hợp lệ) *" : "(hoặc tài liệu đính kèm)")</label><p class="form-help">Soạn văn bản, bảng và chú thích trực tiếp. Dán từ Word được làm sạch định dạng. Dùng nút Chèn ảnh và khu vực Tài liệu đính kèm bên dưới; không cần nhập mã kỹ thuật.</p><textarea asp-for="BodyHtml" id="content-html" rows="20" readonly="@(!Model.CanSave)" hidden></textarea><noscript><p class="validation-summary">Cần bật JavaScript để sử dụng trình soạn thảo nội dung.</p></noscript><span asp-validation-for="BodyHtml"></span></div>
        @if (Model.CanSave && Model.CanManageMedia) { <div class="editor-insert-actions"><button class="button secondary" type="button" data-open-media="inline">Chèn ảnh có chú thích</button></div> }
        <section class="settings-panel" id="editor-files" tabindex="-1"><h2>Tài liệu đính kèm</h2><ul id="selected-attachments" class="attachment-editor-list">@foreach (var asset in Model.SelectedMedia.Where(x => Model.AttachmentIds.Contains(x.Id))) { <li data-asset="@asset.Id"><input type="hidden" name="AttachmentIds" value="@asset.Id" /><span>@asset.Name</span><small>@FileDescription(asset)</small><a href="/admin/media/@asset.Id/preview?contentId=@Model.Id" target="_blank" rel="noopener">Xem / tải tệp</a><label for="attachment-label-@asset.Id">Nhãn tài liệu</label><input class="attachment-caption" id="attachment-label-@asset.Id" name="AttachmentLabels[@asset.Id]" value="@Model.AttachmentLabels.GetValueOrDefault(asset.Id, "")" maxlength="2000" readonly="@(!Model.CanSave)" />@if (Model.CanSave) { <button type="button" class="link-button" data-remove-attachment>Gỡ khỏi bản nháp</button> }</li> }</ul>@if(Model.CanSave && Model.CanManageMedia){<div class="editor-document-upload"><label for="editor-document-file">Đính kèm PDF, Word hoặc Excel (tối đa 10 MB/tệp)</label><input id="editor-document-file" type="file" accept=".pdf,.docx,.xlsx" /><progress id="document-progress" hidden max="100" value="0"></progress><p id="document-feedback" role="status" aria-live="polite"></p><button type="button" class="button secondary" data-document-library>Chọn tài liệu đã tải cho bài này</button><div id="document-library"></div></div>}
<p class="form-help">Tài liệu được thêm vào bản nháp, chỉ công khai theo phiên bản đã xuất bản. Tải Word đính kèm không tự nhập nội dung vào bài.</p></section>
<div class="editor-video-references">    @foreach(var videoId in Model.VideoAssetIds){<div data-video-reference="@videoId"><input type="hidden" name="VideoAssetIds" value="@videoId" /><div class="form-field"><label for="video-caption-@videoId">Chú thích video @videoId.ToString().Substring(0,8)</label><input id="video-caption-@videoId" name="AttachmentLabels[@videoId]" value="@Model.AttachmentLabels.GetValueOrDefault(videoId, "")" maxlength="2000" readonly="@(!Model.CanSave)" /></div>@if(Model.CanSave){<button type="button" class="link-button" data-remove-video="@videoId">Gỡ video và các phụ đề khỏi nháp</button>}</div>}
    @foreach(var track in Model.SubtitleAssetIds){<span data-subtitle-reference="@track"><input type="hidden" name="SubtitleAssetIds" value="@track" />Phụ đề @track.ToString().Substring(0,8) @if(Model.CanSave){<button type="button" class="link-button" data-remove-subtitle>Gỡ phụ đề khỏi nháp</button>}</span>}
</div>
@if(Model.CanSave && Model.CanManageMedia && Model.CanManageVideos){<partial name="~/Views/VideoAdmin/_EditorVideo.cshtml" model="Model" />}
<details class="editor-advanced" open="@(Model.Kind is LandPortal.Domain.ContentKind.LegalDocument or LandPortal.Domain.ContentKind.DraftDocument || Model.Metadata.WeeklyYear != null)"><summary>Thông tin theo loại bài và tùy chọn nâng cao</summary><partial name="_TypedMetadata" model="Model" /><partial name="_V05Metadata" model="Model" /></details>
    </div>
    <aside class="editor-settings" id="editor-actions" tabindex="-1">
        <section class="settings-panel"><h2>Hoàn tất bài viết</h2><div id="editor-workflow-readiness" class="editor-workflow-readiness" role="status" aria-live="polite">Lưu nháp để kiểm tra các thông tin còn thiếu. Bạn vẫn có thể lưu khi chưa hoàn chỉnh.</div><p class="form-help">Mỗi lần duyệt gắn với phiên bản cụ thể. Bản sửa sau duyệt cần được gửi duyệt lại.</p>
            @if (Model.CanSave) { <button class="button secondary full-width" type="submit" name="intent" value="Save" data-save>Lưu bản nháp</button> }
            @if (Model.CanSubmit && Model.CanSave) { <button class="button full-width" type="submit" name="intent" value="Submit" data-save-submit>Gửi duyệt</button> }
            @if (Model.CanPublish && Model.CanSave) { <button class="button publish full-width" type="submit" name="intent" value="Publish" data-save-publish>Đăng trực tiếp</button> }
            <a class="outline-link full-width" id="preview-link" href="@(Model.Id == null ? "#" : "/admin/preview/"+Model.Id)" target="_blank" rel="noopener">Xem trước ↗</a>
            @if(Model.CanSchedule){<details class="editor-inline-schedule"><summary>Hẹn giờ xuất bản</summary><label for="editor-due">Thời điểm đăng (giờ Việt Nam)</label><input id="editor-due" type="datetime-local" />
                @if(Model.CanPublishApproved && (Model.DraftState == "Approved" || Model.DraftState == "PendingReview" && Model.CanReview)){<button type="button" class="button secondary full-width" data-editor-schedule="approved">@(Model.DraftState == "PendingReview" ? "Duyệt và hẹn giờ" : "Hẹn giờ bản đã duyệt")</button>}
                @if(Model.CanPublish && (Model.CanSave || Model.DraftState is "PendingReview" or "Approved")){<button type="button" class="button secondary full-width" data-editor-schedule="direct" hidden="@(Model.Metadata.DisclosureGroupId != null)">Hẹn giờ đăng trực tiếp (không qua duyệt)</button>}
                <p class="form-help">Hẹn giờ bản đã duyệt giữ nguyên phiên bản và người duyệt. Đăng trực tiếp là lựa chọn riêng dành cho người có quyền.</p><a href="/admin/schedules">Xem hoặc hủy lịch đã đặt</a></details>}
            @if (Model.Id is not null) {

                @if (Model.CanReview && Model.DraftState == "PendingReview") { @if(Model.CanPublishApproved){<button class="button publish full-width" type="button" data-workflow="ApprovePublish">Duyệt và xuất bản</button>}<button class="button secondary full-width" type="button" data-workflow="Approve">Chỉ duyệt phiên bản này</button><div class="form-field"><label for="review-reason">Lý do trả bài</label><textarea id="review-reason" rows="3" maxlength="2000"></textarea></div><button class="button secondary full-width" type="button" data-workflow="Reject">Trả bài kèm lý do</button> }
                @if (Model.CanPublishApproved && Model.DraftState == "Approved") { <button class="button publish full-width" type="button" data-workflow="PublishApproved">Xuất bản phiên bản đã duyệt</button> }
                @if (Model.CanBeginEdit) { <button class="button secondary full-width" type="button" data-workflow="StartDraft">Mở bản sửa mới</button> }
                <details class="editor-more-actions"><summary>Thao tác khác</summary><a class="outline-link full-width" href="/admin/history/@Model.Id">Lịch sử và so sánh phiên bản</a>
                @if (Model.CanClone) { <button class="button secondary full-width" type="button" data-workflow="Clone">Nhân bản thành bài nháp mới</button> }
                @if (Model.IsPublished) { <a class="outline-link full-width" href="/bai-viet/@Model.Id" target="_blank" rel="noopener">Xem phiên bản công khai ↗</a> }
                @if (Model.CanUnpublish && Model.IsPublished) { <button class="button danger full-width" type="button" data-workflow="Unpublish" data-confirm="Gỡ bài khỏi cổng thông tin? Bản biên tập và lịch sử vẫn được giữ.">Gỡ bài công khai</button> }
                @if (Model.CanRestore && Model.IsTrashed) { <button class="button secondary full-width" type="button" data-workflow="RestoreTrash">Khôi phục từ thùng rác</button> }
                @if (Model.CanTrash && !Model.IsTrashed) { <button class="button danger full-width" type="button" data-workflow="Trash" data-confirm="Chuyển bài vào thùng rác? Bài sẽ không còn công khai.">Chuyển vào thùng rác</button> }
                </details>
            }
            <p class="form-help">Tệp tải lên chưa được công khai. Quyền, phiên bản và kết quả kiểm định được kiểm tra lại khi phát hành.</p>
        </section>
        <section class="settings-panel"><h2>Thông tin bài viết</h2>
            <div class="form-field"><label asp-for="CategoryId">Chuyên mục chính *</label><select asp-for="CategoryId" disabled="@(!Model.CanSave)"><option value="">Chọn chuyên mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId"></span></div>
            <fieldset class="category-checkboxes" disabled="@(!Model.CanSave)"><legend>Chuyên mục phụ</legend>@foreach (var category in Model.Categories) { <label><input type="checkbox" name="SecondaryCategoryIds" value="@category.Id" checked="@(Model.SecondaryCategoryIds.Contains(category.Id))" /> @category.Name</label> }</fieldset>
            <div class="form-field"><label asp-for="Author">Tác giả @(LandPortal.Infrastructure.AnnouncementTemplatePolicy.RequiresArticleFields(Model.Kind) ? "*" : "(không bắt buộc)")</label><input asp-for="Author" maxlength="300" readonly="@(!Model.CanSave)" /></div><div class="form-field"><label asp-for="SourceName"></label><input asp-for="SourceName" maxlength="300" readonly="@(!Model.CanSave)" /></div>
        </section>
        <section class="settings-panel"><h2>Ảnh đại diện @(LandPortal.Infrastructure.AnnouncementTemplatePolicy.RequiresArticleFields(Model.Kind) ? "*" : "")</h2><div id="cover-preview">@if (Model.CoverAssetId is not null && Model.Id is not null) { <img src="/admin/media/@Model.CoverAssetId/preview?contentId=@Model.Id" alt="Ảnh đại diện đang biên tập" /> }</div>@if (Model.CanSave && Model.CanManageMedia) { <button class="button secondary full-width" type="button" data-open-media="cover">Chọn hoặc tải ảnh</button><button class="link-button remove-cover" type="button">Bỏ ảnh đại diện</button> }<p class="form-help">Bài nguồn thiếu ảnh vẫn được giữ; không bắt bổ sung ảnh để lưu dữ liệu đã chuyển.</p></section>

    </aside>
</form>
@if (Model.CanSave && Model.CanManageMedia) {
<dialog id="media-dialog" aria-labelledby="media-dialog-title"><div class="media-dialog-heading"><h2 id="media-dialog-title">Thư viện ảnh</h2><button type="button" class="button secondary" data-close-media>Đóng</button></div><p class="form-help">Tệp tải lên được kiểm tra định dạng và trạng thái an toàn. Tệp chưa quét được ghi nhận trung thực; quyền sử dụng phụ thuộc chính sách hiện hành.</p><div class="media-upload"><label for="media-upload-file">Tải ảnh từ máy</label><input id="media-upload-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /><progress id="upload-progress" value="0" max="100" hidden></progress><p id="upload-feedback" role="status" aria-live="polite"></p></div><div class="media-search"><label for="media-search">Tìm tên tệp</label><input id="media-search" maxlength="200" /><button type="button" class="button secondary" data-search-media>Tìm</button></div><div class="form-field"><label for="media-caption">Chú thích ảnh</label><input id="media-caption" maxlength="1000" placeholder="Nhập mô tả ảnh cho người đọc" /></div><div id="media-items" class="media-grid"></div><div id="media-pagination" class="pagination"></div></dialog>
}
<dialog id="reauth-dialog" aria-labelledby="reauth-title"><h2 id="reauth-title">Xác thực lại để tiếp tục</h2><p>Nội dung chưa lưu vẫn giữ trong trang này, không lưu vào localStorage. Không đóng hoặc tải lại trang trước khi lưu.</p><form id="reauth-form"><div class="form-field"><label for="reauth-user">Tên đăng nhập của phiên vừa hết hạn</label><input id="reauth-user" name="userName" autocomplete="username" maxlength="256" required /></div><div class="form-field"><label for="reauth-password">Mật khẩu</label><input id="reauth-password" name="password" type="password" autocomplete="current-password" maxlength="256" required /></div><div class="form-field"><label id="reauth-captcha-question" for="reauth-captcha-answer">Câu hỏi xác thực được tải khi cần xác thực lại</label><input id="reauth-captcha-answer" name="captchaAnswer" autocomplete="off" inputmode="numeric" maxlength="3" required /><input name="captchaId" type="hidden" /><button type="button" data-refresh-reauth>Câu hỏi mới</button></div><p id="reauth-feedback" role="status"></p><button class="button" type="submit">Xác thực lại</button><button class="button secondary" type="button" data-close-reauth>Tiếp tục giữ bản soạn ở trang này</button></form></dialog>
@section Scripts { <script src="~/vendor/jodit/jodit.min.js" asp-append-version="true" defer></script><script src="~/js/editor.js" asp-append-version="true" defer></script><script src="~/js/editor-video.js" asp-append-version="true" defer></script><script src="~/js/editor-weekly.js" asp-append-version="true" defer></script> }

