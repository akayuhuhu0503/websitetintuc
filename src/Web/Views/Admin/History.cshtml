@model HistoryModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Lịch sử phiên bản"; }
<div class="admin-title"><div><a class="back-link" href="/admin/edit/@Model.ContentId">← Về bài biên tập</a><h1>Lịch sử phiên bản</h1><p>Mỗi phiên bản nội dung được giữ nguyên. Khôi phục tạo bản nháp để duyệt và xuất bản lại.</p></div></div>
<form id="history-form" data-content-id="@Model.ContentId">@Html.AntiForgeryToken()<input name="RowVersion" type="hidden" value="@Model.RowVersion" /></form>
<div id="history-feedback" role="status" aria-live="polite"></div>
@if (Model.Events.Any(x => x.Action == "Phase3B.ImportWarning"))
{
    <aside class="settings-panel" role="note"><h2>Cảnh báo nhập nguồn</h2><p>Các thiếu sót không chặn nhập được ghi riêng theo phiên bản. Kiểm tra trước khi biên tập hoặc xuất bản lại; không có ảnh thay thế hay liên kết nóng.</p><ul>@foreach(var warning in Model.Events.Where(x => x.Action == "Phase3B.ImportWarning")){<li><code>@warning.RevisionId</code> · @warning.Detail</li>}</ul></aside>
}
<div class="table-scroll"><table class="admin-table revision-table"><caption class="sr-only">Phiên bản đã lưu</caption><thead><tr><th>Phiên bản / thời điểm</th><th>Tiêu đề / tác giả</th><th>Người chỉnh sửa / trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var revision in Model.Revisions) { <tr><td><code>@revision.Id.ToString()[..8]</code><br />@revision.CreatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm:ss")</td><td>@revision.Title<br /><small>@revision.Author</small></td><td>@revision.EditedBy<br />@(revision.IsSource ? "Phiên bản nguồn" : "Phiên bản biên tập") @if (revision.IsCurrent) { <span class="workflow-badge">Hiện tại · @Model.CurrentState</span> } @if (revision.IsPublished) { <span class="workflow-badge public-badge">Công khai</span> }</td><td><a class="table-action" href="/admin/preview/@Model.ContentId?revisionId=@revision.Id" target="_blank" rel="noopener">Xem trước ↗</a><button class="link-button" type="button" data-compare="@revision.Id">So sánh với bản trước</button>@if (Model.CanRestore) { <button class="link-button" type="button" data-restore="@revision.Id">Khôi phục thành nháp</button> }</td></tr> }</tbody></table></div>
<section id="revision-comparison" class="settings-panel comparison-panel" hidden aria-labelledby="compare-title"><h2 id="compare-title">So sánh thay đổi</h2><p class="form-help">Màu và nhãn chỉ rõ phần trước/sau. Xem trước từng phiên bản để đối chiếu cấu trúc bảng, ảnh và tài liệu.</p><div id="comparison-content"></div></section>
<section class="history-audit"><h2>Nhật ký thao tác</h2><div class="table-scroll"><table><caption class="sr-only">Nhật ký duyệt và xuất bản</caption><thead><tr><th>Thời điểm (Việt Nam)</th><th>Người thực hiện</th><th>Thao tác</th><th>Phiên bản</th><th>Chi tiết</th></tr></thead><tbody>@foreach (var entry in Model.Events) { <tr><td>@entry.CreatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm:ss")</td><td>@entry.Actor</td><td>@LandPortal.Web.Controllers.AdminController.ActionLabel(entry.Action)</td><td>@if (entry.RevisionId is Guid revisionId) { <a href="/admin/preview/@Model.ContentId?revisionId=@revisionId" target="_blank" rel="noopener" aria-label="Xem phiên bản @revisionId"><code>@revisionId.ToString()[..8]</code></a> } else { <span>—</span> }</td><td>@entry.Detail</td></tr> }</tbody></table></div></section>
@section Scripts { <script src="~/js/history.js" asp-append-version="true" defer></script> }
