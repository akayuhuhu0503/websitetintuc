@* v0.5 additive schedule entry; original CMS routes retained. *@
@model AdminListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Bài viết"; }
@{ var weekly = Model.Kind == "StaticPage" && Model.CategoryId == 76; var returnUrl = Uri.EscapeDataString("/admin" + Context.Request.QueryString.Value); }
<div class="admin-title"><div><p class="eyebrow">KHÔNG GIAN BIÊN TẬP</p><h1>@(weekly ? "Lịch công tác tuần" : "Bài viết")</h1><p>@Model.Total nội dung trong bộ lọc và phạm vi quyền của bạn</p></div>
@if (Model.CanCreate) { <details class="cms-create-menu"><summary class="button">+ Tạo nội dung</summary><div>@foreach(var k in Enum.GetValues<LandPortal.Domain.ContentKind>().Where(x => x != LandPortal.Domain.ContentKind.Video || Model.CanManageVideos)) { <a href="/admin/create?kind=@k&amp;returnUrl=@returnUrl">@LandPortal.Web.Services.PublicContentQuery.KindLabel(k)</a> }<a href="/admin/create?kind=StaticPage&amp;template=weekly&amp;returnUrl=@returnUrl">Lịch công tác tuần</a></div></details> }</div>
<nav class="cms-status-tabs" aria-label="Trạng thái nội dung">
@foreach(var tab in new[] { ("", "Tất cả"), ("Draft", "Bản nháp"), ("PendingReview", "Chờ duyệt"), ("Scheduled", "Hẹn giờ"), ("Published", "Đã đăng"), ("Archived", "Thùng rác") }) {
<a aria-current="@((Model.Status ?? "") == tab.Item1 ? "page" : null)" href="?q=@Uri.EscapeDataString(Model.Query ?? "")&amp;kind=@Model.Kind&amp;categoryId=@Model.CategoryId&amp;owner=@Uri.EscapeDataString(Model.Owner ?? "")&amp;status=@tab.Item1">@tab.Item2 <span>@Model.StatusCounts.GetValueOrDefault(tab.Item1)</span></a>
}</nav>
<form class="cms-list-filter" method="get"><div class="cms-search-line"><div><label for="admin-q">Tìm tiêu đề</label><input id="admin-q" name="q" value="@Model.Query" maxlength="200" placeholder="Nhập tiêu đề bài viết" /></div><button class="button secondary" type="submit">Tìm kiếm</button></div>
<details class="cms-advanced" open="@(Model.Kind != null || Model.CategoryId != null || Model.Owner != null)"><summary>Bộ lọc thêm</summary><div class="admin-filter cms-filter">
<div><label for="admin-kind">Loại nội dung</label><select id="admin-kind" name="kind"><option value="">Tất cả</option>@foreach(var kind in Enum.GetValues<LandPortal.Domain.ContentKind>()) { <option value="@kind" selected="@(Model.Kind == kind.ToString())">@LandPortal.Web.Services.PublicContentQuery.KindLabel(kind)</option> }</select></div>
<div><label for="admin-category">Chuyên mục</label><select id="admin-category" name="categoryId"><option value="">Tất cả chuyên mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option> }</select></div>
<div><label for="admin-owner">Người soạn</label><select id="admin-owner" name="owner"><option value="">Tất cả trong phạm vi quyền</option>@foreach (var owner in Model.Owners) { <option value="@owner.Id" selected="@(Model.Owner == owner.Id)">@owner.Name</option> }</select></div><div><label for="admin-status">Trạng thái chi tiết</label><select id="admin-status" name="status"><option value="">Tất cả</option>@foreach(var item in new[] { ("Draft", "Bản nháp"), ("PendingReview", "Chờ duyệt"), ("Approved", "Đã duyệt"), ("Scheduled", "Hẹn giờ"), ("Published", "Đang công khai"), ("Rejected", "Đã trả bài"), ("Unpublished", "Đã gỡ"), ("Archived", "Thùng rác") }) { <option value="@item.Item1" selected="@(Model.Status == item.Item1)">@item.Item2</option> }</select></div><button class="button secondary" type="submit">Áp dụng bộ lọc</button></div></details></form>
@if (Model.Items.Count == 0) { <div class="empty-state"><h2>Chưa có bài viết phù hợp</h2><p>Chọn bộ lọc khác để tìm bài trong phạm vi được cấp quyền.</p></div> } else { <div class="table-scroll"><table class="admin-table"><caption class="sr-only">Danh sách bài viết</caption><thead><tr><th scope="col">Tiêu đề</th><th scope="col">Công khai / biên tập</th><th scope="col">@(weekly ? "Tuần / phiên bản" : "Chuyên mục")</th><th scope="col">Người soạn / cập nhật</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach (var row in Model.Items) { <tr><td><a href="/admin/edit/@row.Id?returnUrl=@returnUrl">@row.Title</a></td><td><span class="workflow-badge public-badge">@(row.IsPublished ? "Đang công khai" : row.IsTrashed ? "Trong thùng rác" : "Chưa công khai")</span><br /><span class="workflow-badge">Biên tập: @row.Status</span></td><td>@if(weekly){<div class="cms-week-summary"><strong>@(row.Weekly?.Label ?? "Chưa xác định tuần")</strong><span>@row.Weekly?.DateRange</span><small>@(row.Weekly?.PublishedVersion is int version ? "Phiên bản đã phát hành: " + version : "Chưa có phiên bản phát hành")</small></div>}else{@row.CategoryName}</td><td>@row.Owner<br /><span class="muted">@row.UpdatedAt</span></td><td><a class="table-action" href="/admin/edit/@row.Id?returnUrl=@returnUrl">Mở bài →</a><a class="table-action" href="/admin/history/@row.Id">Lịch sử</a></td></tr> }</tbody></table></div> }
@if (Model.PageCount > 1) { <nav class="pagination" aria-label="Phân trang">@if (Model.Page > 1) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&kind=@Model.Kind&status=@Model.Status&categoryId=@Model.CategoryId&owner=@Uri.EscapeDataString(Model.Owner ?? "")&page=@(Model.Page - 1)">← Trước</a> }<span>Trang @Model.Page / @Model.PageCount</span>@if (Model.Page < Model.PageCount) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&kind=@Model.Kind&status=@Model.Status&categoryId=@Model.CategoryId&owner=@Uri.EscapeDataString(Model.Owner ?? "")&page=@(Model.Page + 1)">Tiếp →</a> }</nav> }
