@* v0.5 additive schedule entry; original CMS routes retained. *@
@model AdminListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Bài viết"; }
<div class="admin-title"><div><p class="eyebrow">KHÔNG GIAN BIÊN TẬP</p><h1>Bài viết</h1><p>@Model.Total bài trong phạm vi quyền của bạn</p></div>@if (Model.CanCreate) { <a class="button" href="/admin/create?kind=@(Model.Kind ?? "Article")">+ Soạn bài mới</a> }</div>
<nav class="admin-content-types" aria-label="Mẫu soạn mới">@if(Model.CanCreate) { @foreach(var k in Enum.GetValues<LandPortal.Domain.ContentKind>().Where(x=>x != LandPortal.Domain.ContentKind.Video)) { <a class="outline-link" href="/admin/create?kind=@k">Soạn @LandPortal.Web.Services.PublicContentQuery.KindLabel(k)</a> } }</nav>
<form class="admin-filter cms-filter" method="get"><div><label for="admin-kind">Loại nội dung</label><select id="admin-kind" name="kind"><option value="">Tất cả</option>@foreach(var kind in Enum.GetValues<LandPortal.Domain.ContentKind>()) { <option value="@kind" selected="@(Model.Kind == kind.ToString())">@LandPortal.Web.Services.PublicContentQuery.KindLabel(kind)</option> }</select></div><div><label for="admin-q">Tìm tiêu đề</label><input id="admin-q" name="q" value="@Model.Query" maxlength="200" placeholder="Nhập tiêu đề bài viết" /></div><div><label for="admin-category">Chuyên mục</label><select id="admin-category" name="categoryId"><option value="">Tất cả chuyên mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option> }</select></div><div><label for="admin-owner">Người soạn</label><select id="admin-owner" name="owner"><option value="">Tất cả trong phạm vi quyền</option>@foreach (var owner in Model.Owners) { <option value="@owner.Id" selected="@(Model.Owner == owner.Id)">@owner.Name</option> }</select></div><div><label for="admin-status">Trạng thái biên tập</label><select id="admin-status" name="status"><option value="">Tất cả</option>@foreach (var item in new[] { ("Draft", "Bản nháp"), ("PendingReview", "Chờ duyệt"), ("Approved", "Đã duyệt"), ("Published", "Đã đăng phiên bản này"), ("Rejected", "Đã trả bài"), ("Unpublished", "Đã gỡ"), ("Archived", "Thùng rác") }) { <option value="@item.Item1" selected="@(Model.Status == item.Item1)">@item.Item2</option> }</select></div><button class="button secondary" type="submit">Lọc bài viết</button></form>
@if (Model.Items.Count == 0) { <div class="empty-state"><h2>Chưa có bài viết phù hợp</h2><p>Chọn bộ lọc khác để tìm bài trong phạm vi được cấp quyền.</p></div> } else { <div class="table-scroll"><table class="admin-table"><caption class="sr-only">Danh sách bài viết</caption><thead><tr><th scope="col">Tiêu đề</th><th scope="col">Công khai / biên tập</th><th scope="col">Chuyên mục</th><th scope="col">Người soạn / cập nhật</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach (var row in Model.Items) { <tr><td><a href="/admin/edit/@row.Id">@row.Title</a></td><td><span class="workflow-badge public-badge">@(row.IsPublished ? "Đang công khai" : row.IsTrashed ? "Trong thùng rác" : "Chưa công khai")</span><br /><span class="workflow-badge">Biên tập: @row.Status</span></td><td>@row.CategoryName</td><td>@row.Owner<br /><span class="muted">@row.UpdatedAt</span></td><td><a class="table-action" href="/admin/edit/@row.Id">Mở bài →</a><a class="table-action" href="/admin/history/@row.Id">Lịch sử</a></td></tr> }</tbody></table></div> }
@if (Model.PageCount > 1) { <nav class="pagination" aria-label="Phân trang">@if (Model.Page > 1) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&kind=@Model.Kind&status=@Model.Status&categoryId=@Model.CategoryId&owner=@Uri.EscapeDataString(Model.Owner ?? "")&page=@(Model.Page - 1)">← Trước</a> }<span>Trang @Model.Page / @Model.PageCount</span>@if (Model.Page < Model.PageCount) { <a href="?q=@Uri.EscapeDataString(Model.Query ?? "")&kind=@Model.Kind&status=@Model.Status&categoryId=@Model.CategoryId&owner=@Uri.EscapeDataString(Model.Owner ?? "")&page=@(Model.Page + 1)">Tiếp →</a> }</nav> }


@if(Model.CanCreate){<p><a href="/admin/create?kind=StaticPage&template=weekly">Soạn lịch tuần nhập tay</a></p>}
