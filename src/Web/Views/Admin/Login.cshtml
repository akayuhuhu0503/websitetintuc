@model LoginModel
@{ ViewData["Title"] = "Đăng nhập quản trị"; }
<div class="login-wrap"><section class="login-panel"><p class="eyebrow">DÀNH CHO BIÊN TẬP VIÊN</p><h1>Đăng nhập quản trị</h1><p>Tài khoản được quản trị viên cấp. Cổng thông tin không mở đăng ký công khai.</p><form method="post" action="/admin/login">@Html.AntiForgeryToken()<input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="form-field"><label asp-for="UserName"></label><input asp-for="UserName" autocomplete="username" maxlength="256" /><span asp-validation-for="UserName"></span></div><div class="form-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" maxlength="256" /><span asp-validation-for="Password"></span></div><input asp-for="CaptchaId" type="hidden" /><div class="form-field"><label id="captcha-question" for="CaptchaAnswer">@Model.CaptchaQuestion</label><input asp-for="CaptchaAnswer" autocomplete="off" inputmode="numeric" maxlength="3" aria-describedby="login-captcha-help" /><p id="login-captcha-help" class="form-help">Câu hỏi dùng một lần, hết hạn sau 5 phút. Xác thực tài khoản vẫn cần mật khẩu.</p></div><button class="button" type="submit">Đăng nhập</button></form><p class="form-help">Vui lòng liên hệ người quản trị tài khoản để được cấp quyền biên tập.</p></section></div>
