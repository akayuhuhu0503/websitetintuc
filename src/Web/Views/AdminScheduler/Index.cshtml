@model LandPortal.Web.Models.ScheduleList
@using LandPortal.Domain
@using LandPortal.Infrastructure
@{ Layout="_AdminLayout"; ViewData["Title"]="Lịch xuất bản"; var online=Model.WorkerLastSeen!=null && Model.Now-Model.WorkerLastSeen.Value<TimeSpan.FromSeconds(30); }
@section Styles { <link rel="stylesheet" href="~/css/scheduler.css" asp-append-version="true" /> }
<div class="page-heading"><div><h1>Lịch xuất bản</h1><p>Thời gian Việt Nam (UTC+07:00). Trạng thái lịch tách biệt với bản đang công khai.</p></div></div>
<div class="@(online?"success-message":"schedule-warning")" role="status">@(online?"Worker có heartbeat gần đây.":"Worker đang offline hoặc chưa có heartbeat gần đây; lịch chưa được bảo đảm thực thi.") @if(Model.WorkerLastSeen!=null){<span>Lần cuối: @SchedulerService.ToVietnam(Model.WorkerLastSeen.Value).ToString("dd/MM/yyyy HH:mm:ss")</span>}</div>
<form method="get" class="schedule-filter"><label>Trạng thái<select name="state"><option value="">Tất cả</option>@foreach(var value in Enum.GetValues<PublicationJobState>()){<option value="@value" selected="@(Model.State==value)">@value</option>}</select></label><label>Loại nội dung<select name="kind"><option value="">Tất cả</option>@foreach(var value in Enum.GetValues<ContentKind>()){<option value="@value" selected="@(Model.Kind==value)">@value</option>}</select></label><button type="submit" class="button">Lọc lịch</button></form>
<p>@Model.Total lịch. Nhánh đã duyệt kiểm tra lại cả quyền người duyệt khi chạy.</p>
<div class="table-scroll"><table class="admin-table schedule-table"><thead><tr><th>Nội dung / phiên bản</th><th>Giờ dự kiến</th><th>Trạng thái</th><th>Chủ thể / nhánh</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><a href="/admin/edit/@row.ContentId">@row.Title</a><br/><small>@row.Kind · @row.RevisionId.ToString("N")[..8]</small></td><td>@SchedulerService.ToVietnam(row.DueUtc).ToString("dd/MM/yyyy HH:mm:ss")@if(row.CompletedUtc!=null){<br/><small>Thực tế: @SchedulerService.ToVietnam(row.CompletedUtc.Value).ToString("dd/MM/yyyy HH:mm:ss")</small>}</td><td><span class="schedule-state">@row.State</span><br/><small>@row.Attempts lần nhận. @row.FailureReason</small></td><td>@row.RequestedByUserId<br/>@(row.Direct?"Đăng trực tiếp":"Qua duyệt")</td><td>@if(row.State!=PublicationJobState.Completed){<a href="/admin/schedules/edit?contentId=@row.ContentId&amp;jobId=@row.Id">Đặt lại thời gian / xác nhận phiên bản</a>}@if(row.State is PublicationJobState.Pending or PublicationJobState.Running){<form method="post" action="/admin/schedules/@row.Id/cancel">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Convert.ToBase64String(row.RowVersion)"/><button type="submit" class="button button-secondary">Hủy lịch</button></form>}</td></tr>}</tbody></table></div>
@if(Model.Total==0){<p>Chưa có lịch phù hợp. Mở nội dung đã lưu để đặt lịch theo quyền.</p>}
<nav aria-label="Phân trang lịch" class="pagination">@if(Model.Page>1){<a href="?page=@(Model.Page-1)&amp;state=@Model.State&amp;kind=@Model.Kind">Trang trước</a>}<span>Trang @Model.Page</span>@if(Model.Page*20<Model.Total){<a href="?page=@(Model.Page+1)&amp;state=@Model.State&amp;kind=@Model.Kind">Trang sau</a>}</nav>
