@model SiteEditModel
@section Styles { <link rel="stylesheet" href="~/css/site-config.css" asp-append-version="true" /> }
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Sửa cấu hình nháp"; var isBanner = Model.Section == "banners"; var target = isBanner ? (SiteMenuInput)Model.Banner : Model.Menu; var prefix = isBanner ? "Banner" : "Menu"; }
<div class="admin-page-heading"><div><p class="eyebrow">BẢN NHÁP CẤU HÌNH</p><h1>Sửa @(Model.Section switch { "contact" => "liên hệ & nhận diện", "categories" => "chuyên mục", "menus" => "menu & liên kết", "banners" => "banner", "blocks" => "khối trang chủ", "vocabulary" => "danh mục văn bản", _ => "cấu hình" })</h1></div><a href="/admin/site?section=@Model.Section">← Quay lại</a></div>
@if (Model.SystemProtected) { <p class="editor-notice">Mục nguồn được bảo vệ: giữ tên, slug, cấu trúc và đích. Chỉ chỉnh mô tả/thứ tự phù hợp; hệ thống kiểm tra lại mọi trường.</p> }
<form method="post" action="/admin/site/save" class="site-admin-form" id="site-edit-form">
@Html.AntiForgeryToken()<input type="hidden" asp-for="Section" /><input type="hidden" asp-for="RowVersion" /><input type="hidden" asp-for="ItemId" /><input type="hidden" asp-for="CategoryId" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
@if (Model.Section == "contact")
{
    <label asp-for="Contact.OrganizationName">Tên cơ quan</label><input asp-for="Contact.OrganizationName" maxlength="300" required /><span asp-validation-for="Contact.OrganizationName"></span>
    <label asp-for="Contact.ContactAddress">Địa chỉ công khai</label><input asp-for="Contact.ContactAddress" maxlength="1000" />
    <label asp-for="Contact.EnglishName">Tên tiếng Anh chính thức</label><input asp-for="Contact.EnglishName" maxlength="300" /><p class="field-hint">Để trống khi Văn phòng Cục chưa xác nhận; không tự dịch hoặc dùng tên cũ.</p>
    <label asp-for="Contact.SupervisingAgency">Cơ quan chủ quản</label><input asp-for="Contact.SupervisingAgency" maxlength="300" />
    <label asp-for="Contact.ResponsiblePerson">Người chịu trách nhiệm chính</label><input asp-for="Contact.ResponsiblePerson" maxlength="300" />
    <label asp-for="Contact.LicenseNumber">Số giấy phép</label><input asp-for="Contact.LicenseNumber" maxlength="300" />
    <label asp-for="Contact.SeoDescription">Mô tả mặc định cho công cụ tìm kiếm</label><textarea asp-for="Contact.SeoDescription" maxlength="1000" rows="3"></textarea>
    <div class="site-form-grid"><div><label asp-for="Contact.ContactPhone">Điện thoại</label><input asp-for="Contact.ContactPhone" maxlength="100" /></div><div><label asp-for="Contact.ContactHotline">Đường dây nóng</label><input asp-for="Contact.ContactHotline" maxlength="100" /></div></div>
    <label asp-for="Contact.ContactEmail">Email công khai</label><input asp-for="Contact.ContactEmail" type="email" maxlength="254" />
    <label asp-for="Contact.FooterText">Ghi chú chân trang (văn bản thuần)</label><textarea asp-for="Contact.FooterText" maxlength="5000" rows="4"></textarea>
    <button type="button" class="outline-link" data-picker-target="Contact_LogoAssetId" data-picker-type="image">Chọn logo từ thư viện</button><label asp-for="Contact.LogoAssetId">Logo đã xác minh trong kho riêng</label><select asp-for="Contact.LogoAssetId" class="site-image-select"><option value="">Không dùng logo</option>@foreach (var image in Model.Images) { <option value="@image.Value">@image.Label</option> }</select>
}
@if (Model.Section == "categories")
{
    <label asp-for="Category.DisplayName">Tên chuyên mục</label><input asp-for="Category.DisplayName" maxlength="300" required readonly="@(Model.SystemProtected)" />
    <label asp-for="Category.Slug">Tên trên đường dẫn chuyên mục</label><input asp-for="Category.Slug" maxlength="180" pattern="[a-z0-9]+(-[a-z0-9]+)*" required readonly="@(Model.CategoryId.HasValue)" /><p class="field-hint">Tuyến đã dùng giữ nguyên; không tự đổi đường dẫn đã dùng.</p>
    <label asp-for="Category.Description">Mô tả</label><textarea asp-for="Category.Description" maxlength="2000" rows="4"></textarea>
    <label asp-for="Category.ParentCategoryId">Chuyên mục cha</label><select asp-for="Category.ParentCategoryId"><option value="">Không có cha</option>@foreach (var c in Model.Categories.Where(x => x.Value != Model.CategoryId?.ToString())) { <option value="@c.Value">@c.Label</option> }</select>
    <label asp-for="Category.SortOrder">Thứ tự</label><input asp-for="Category.SortOrder" type="number" min="0" max="10000" />
    <label class="checkbox-label"><input asp-for="Category.ShowInNavigation" /> Hiển thị trong điều hướng</label>
}
@if (Model.Section is "menus" or "banners")
{
    <p class="editor-notice">Thay đổi ở đây chỉ lưu vào bản nháp. Xem trước và áp dụng toàn bộ cấu hình ở màn hình kế tiếp.</p><label for="site_label">Tên hiển thị</label><input id="site_label" name="@(prefix + ".Label")" value="@target.Label" maxlength="300" required readonly="@(Model.SystemProtected)" />
    <label for="site_position">Vị trí</label><select id="site_position" name="@(prefix + ".Position")">@foreach (var position in isBanner ? LandPortal.Infrastructure.SiteConfigurationService.BannerPositions : LandPortal.Infrastructure.SiteConfigurationService.MenuPositions) { <option value="@position" selected="@(target.Position == position)">@AdminLabels.State(position)</option> }</select>
    @if (!isBanner) { <label asp-for="Menu.ParentId">Nhóm cha (cùng vị trí)</label><select asp-for="Menu.ParentId"><option value="">Mục gốc</option>@foreach (var parent in Model.Parents) { <option value="@parent.Value">@parent.Label</option> }</select> }
    <fieldset class="site-target-fields"><legend>Đích liên kết</legend><label for="site_targetKind">Loại đích</label><select id="site_targetKind" name="@(prefix + ".TargetKind")">@foreach (var kind in isBanner ? new[] { "Route", "Category", "Content", "External" } : new[] { "Route", "Category", "Content", "Internal", "External", "Group" }) { <option value="@kind" selected="@(target.TargetKind == kind)">@(kind switch { "Route" => "Mục hệ thống", "Category" => "Chuyên mục", "Content" => "Nội dung công khai", "Internal" => "Đường dẫn nội bộ", "External" => "Liên kết ngoài HTTP(S)", _ => "Nhóm menu" })</option> }</select>
    <div data-target-kind="Route"><label for="site_routeKey">Mục hệ thống</label><select id="site_routeKey" name="@(prefix + ".RouteKey")">@foreach (var route in LandPortal.Infrastructure.SiteConfigurationService.Routes) { <option value="@route.Key" selected="@(target.RouteKey == route.Key)">@route.Value.Label</option> }</select>
    </div><div data-target-kind="Category"><label for="site_category">Chuyên mục đích</label><select id="site_category" name="@(prefix + ".CategoryId")"><option value="">Chọn chuyên mục</option>@foreach (var category in Model.Categories) { <option value="@category.Value" selected="@(target.CategoryId?.ToString() == category.Value)">@category.Label</option> }</select>
    </div><div data-target-kind="Content"><label for="site_content">Nội dung đích</label><select id="site_content" name="@(prefix + ".ContentId")"><option value="">Chọn nội dung</option>@foreach (var content in Model.Contents) { <option value="@content.Value" selected="@(target.ContentId?.ToString() == content.Value)">@content.Label</option> }</select>
    <button type="button" class="outline-link" data-picker-target="site_content" data-picker-type="content">Tìm nội dung theo tiêu đề</button></div><div data-target-kind="Internal External"><label for="site_external">URL nội bộ hoặc ngoài</label><input id="site_external" name="@(prefix + ".ExternalUrl")" value="@target.ExternalUrl" type="text" maxlength="2000" /><p class="field-hint">Chỉ trường của loại đích đã chọn được lưu. Hệ thống không fetch URL để kiểm tra.</p></div></fieldset>
    <label class="checkbox-label"><input type="checkbox" name="@(prefix + ".OpenNewWindow")" value="true" checked="@target.OpenNewWindow" /> Mở tab mới</label><input type="hidden" name="@(prefix + ".OpenNewWindow")" value="false" />
    @if(!isBanner){<label class="checkbox-label"><input asp-for="Menu.Enabled" /> Hiển thị mục menu</label><p>Dịch vụ công/Thư điện tử: chỉ thêm sau khi có URL chính thức. Không dùng # hoặc URL giả.</p>}
    <label for="site_order">Thứ tự</label><input id="site_order" name="@(prefix + ".SortOrder")" value="@target.SortOrder" type="number" min="0" max="10000" />
    @if (isBanner)
    {
        <label asp-for="Banner.MediaAssetId">Ảnh banner trong kho riêng</label><select asp-for="Banner.MediaAssetId" class="site-image-select" required><option value="">Chọn ảnh</option>@foreach (var image in Model.Images) { <option value="@image.Value">@image.Label</option> }</select>
        <button type="button" class="outline-link" data-picker-target="Banner_MediaAssetId" data-picker-type="image">Chọn từ thư viện ảnh</button><div id="site-image-slot"></div>
        <label class="checkbox-label"><input asp-for="Banner.Enabled" /> Bật banner</label>
        <label asp-for="Banner.Description">Mô tả ngắn</label><textarea asp-for="Banner.Description" maxlength="500" rows="2"></textarea>
        <p class="field-hint">Dải sự kiện rộng theo khu vực tin tức, khóa tỉ lệ 117:10 (ví dụ ảnh 1170 × 100 px); ảnh khác tỉ lệ sẽ bị cắt ở giữa để lấp đầy khung. Nên thiết kế chữ quan trọng trong vùng hiển thị này. Chọn từ thư viện hoặc tải ảnh ngay bên dưới; dữ liệu đang nhập được giữ nguyên. Lưu nháp → Xem trước → Áp dụng công khai.</p>
        <p id="event-banner-crop-warning" class="warning-message" role="status" hidden>Ảnh đã chọn lệch nhiều so với tỉ lệ 117:10: hơn 10% ảnh sẽ bị cắt khi hiển thị. Nên dùng ảnh 1170 × 100 px hoặc cùng tỉ lệ và kiểm tra bản xem trước. Đây là cảnh báo, không chặn lưu nháp.</p>
        <details class="cms-advanced"><summary>Lịch hiển thị và mô tả ảnh</summary><label asp-for="Banner.Alt">Nội dung thay thế ảnh</label><input asp-for="Banner.Alt" maxlength="500" required />
        <div class="site-form-grid"><div><label asp-for="Banner.StartVietnam">Bắt đầu (giờ Việt Nam UTC+7)</label><input asp-for="Banner.StartVietnam" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div><div><label asp-for="Banner.EndVietnam">Kết thúc (không bao gồm mốc này, giờ Việt Nam)</label><input asp-for="Banner.EndVietnam" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div></div><p class="field-hint">Có thể bỏ trống mốc. Banner hết hạn sẽ ngừng hiển thị và không còn quyền truy cập tệp riêng, kể cả tác vụ nền tắt.</p></details>
    }
}
@if (Model.Section == "blocks")
{
    <label asp-for="Block.Title">Tên khối</label><input asp-for="Block.Title" maxlength="300" required />
    <label asp-for="Block.Type">Mẫu khối</label><select asp-for="Block.Type">@foreach (var type in LandPortal.Infrastructure.SiteConfigurationService.BlockTypes) { <option value="@type">@(type switch { "Featured" => "Tin nổi bật", "Recent" => "Tin mới", "Announcements" => "Thông báo", "Category" => "Chuyên mục", "LegalDocuments" => "Văn bản pháp luật", "DraftDocuments" => "Văn bản dự thảo", "Videos" => "Video", _ => "Liên kết / sổ tay" })</option> }</select>
    <label asp-for="Block.CategoryId">Chuyên mục (chỉ dành cho mẫu Chuyên mục)</label><select asp-for="Block.CategoryId"><option value="">Không chọn</option>@foreach (var category in Model.Categories) { <option value="@category.Value">@category.Label</option> }</select>
    <div class="site-form-grid"><div><label asp-for="Block.Limit">Số nội dung</label><input asp-for="Block.Limit" type="number" min="1" max="12" /></div><div><label asp-for="Block.SortOrder">Thứ tự</label><input asp-for="Block.SortOrder" type="number" min="0" max="10000" /></div></div>
    <label class="checkbox-label"><input asp-for="Block.Enabled" /> Hiển thị khối</label>
    <button type="button" class="outline-link" data-picker-target="Block_PinnedContentIds" data-picker-type="content">Tìm nội dung để ghim</button><label asp-for="Block.PinnedContentIds">Ghim nội dung đang công khai (Ctrl/Command chọn nhiều, tối đa 12)</label><select asp-for="Block.PinnedContentIds" multiple size="8">@foreach (var content in Model.Contents) { <option value="@content.Value">@content.Label</option> }</select><p class="field-hint">Nội dung ghim giữ mã tham chiếu, không sao chép tiêu đề/ảnh. Nội dung bị gỡ tự biến mất và được bù bằng bản hợp lệ. Hệ thống kiểm tra đúng loại của khối.</p>
}
@if (Model.Section == "vocabulary")
{
    <label asp-for="Vocabulary.Kind">Loại danh mục</label><select asp-for="Vocabulary.Kind">@foreach (var kind in LandPortal.Infrastructure.SiteConfigurationService.VocabularyKinds) { <option value="@kind">@(kind switch { "Authority" => "Cơ quan ban hành", "Type" => "Loại văn bản", _ => "Lĩnh vực" })</option> }</select>
    <label asp-for="Vocabulary.Label">Tên</label><input asp-for="Vocabulary.Label" maxlength="300" required /><label asp-for="Vocabulary.SortOrder">Thứ tự</label><input asp-for="Vocabulary.SortOrder" type="number" min="0" max="10000" /><label class="checkbox-label"><input asp-for="Vocabulary.Active" /> Cho chọn trong trình soạn thảo</label><p class="field-hint">Không xóa vĩnh viễn danh mục đang dùng. Giá trị nguồn chưa ánh xạ vẫn được giữ chữ gốc trong phiên bản; đổi tên cấu hình chỉ công khai khi áp dụng.</p>
}
<div class="site-actions"><button class="primary-button" type="submit">Lưu phiên bản nháp</button><a href="/admin/site?section=@Model.Section">Hủy chỉnh sửa chưa lưu</a></div>
</form>
@if (Model.Section is "contact" or "banners")
{
    <section class="site-admin-panel" id="site-image-panel"><h2>Ảnh cho cấu hình</h2><img id="site-image-preview" class="site-admin-image" alt="Ảnh chọn trong cấu hình nháp" hidden />
    @if (Model.CanUpload) { <form id="site-image-upload"><label for="site-upload-file">Tải ảnh từ máy (JPEG/PNG/GIF/WebP)</label><input id="site-upload-file" type="file" accept="image/jpeg,image/png,image/gif,image/webp" required /><button type="submit">Tải và chọn ảnh</button><progress id="site-upload-progress" max="100" value="0" hidden></progress><p id="site-upload-status" role="status">Ảnh JPG/PNG chỉ được sử dụng sau khi vượt qua chính sách kiểm định hiện hành. Ảnh tải thành công được chọn vào bản nháp; chưa tự hiển thị công khai.</p></form> } else { <p>Cần quyền quản lý tệp và cấu hình quét phù hợp để tải ảnh lên. Có thể chọn ảnh đã nhập hợp lệ; tệp chưa quét không được coi là sạch.</p> }
    </section>
}
@section Scripts { <script src="~/js/site-admin.js" asp-append-version="true" defer></script> }
