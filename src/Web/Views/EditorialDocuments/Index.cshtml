@model LandPortal.Web.Controllers.EditorialDocumentsPage
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tài liệu đính kèm"; }
<h1>Tài liệu của bản biên tập</h1><p>@Model.Title</p><p><a href="/admin/edit/@Model.ContentId">Trở về trình soạn thảo</a></p>
<p>PDF, Word DOCX và Excel XLSX, mỗi tệp tối đa 10 MiB. Không nhận DOC/XLS cũ, macro, liên kết ngoài hoặc công thức Excel. @if(Model.ManagedNoAvEnabled){<strong>Chế độ quản trị: kiểm tra định dạng, KHÔNG quét antivirus.</strong> Tệp chỉ công khai sau bước duyệt/xuất bản bài.}else{<span>Tệp mới được cách ly để chờ quét thật trước khi đọc.</span>}</p>
@if (Model.CanUpload) { <form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<label for="document-file">Chọn tài liệu từ máy</label><input id="document-file" type="file" name="file" accept=".pdf,.docx,.xlsx" required /><button type="submit">Tải tài liệu lên</button></form> }
<div class="table-scroll"><table class="admin-table"><thead><tr><th>Tệp tài liệu</th><th>Trạng thái thật</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Files) { <tr><td>@row.Asset.OriginalName · @row.Asset.ByteLength byte</td><td>@(row.Asset.ValidationStatus==LandPortal.Infrastructure.MediaUploadOptions.ManagedDocumentNoAvValidation?"Đã kiểm định định dạng · Chưa quét antivirus":AdminLabels.State(row.Proof.ScanState)) · lần @row.Proof.Attempts<br/>@AdminLabels.Diagnostic(row.Proof.Error)</td><td>@if(!row.Asset.IsQuarantined && (row.Proof.ScanState == LandPortal.Domain.InquiryScanState.Clean
    || Model.ManagedNoAvEnabled && row.Asset.ScanStatus=="NotScanned" && row.Asset.ValidationStatus==LandPortal.Infrastructure.MediaUploadOptions.ManagedDocumentNoAvValidation)) { <a href="/admin/documents/file/@row.Asset.Id">Tải riêng tư</a> @if(Model.CanUpload){<a href="/admin/edit/@Model.ContentId?documentId=@row.Asset.Id">Đọc / thêm vào bản xem trước</a>} } else { <span>Chưa được đọc hoặc tải theo chính sách hiện tại.</span> }</td></tr> }
</tbody></table></div>
@if(Model.CanUpload && Model.LegacyPdfs.Count > 0){<h2>PDF đã tải lên theo luồng cũ</h2><p>Các tệp này chỉ dùng riêng tư đến khi quét thật. Thao tác dưới giữ nguyên tệp gốc và phiên bản, đưa vào hàng đợi; không áp dụng cho53 tài nguyên nguồn hoặc PDF đang dùng chung hồ sơ khác.</p><ul>@foreach(var asset in Model.LegacyPdfs){<li>@asset.OriginalName <form method="post" action="/admin/documents/@Model.ContentId/enqueue/@asset.Id">@Html.AntiForgeryToken()<button type="submit">Đưa PDF này vào hàng đợi quét</button></form></li>}</ul>}
