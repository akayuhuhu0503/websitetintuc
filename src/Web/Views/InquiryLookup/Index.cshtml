@model LandPortal.Web.Controllers.InquiryLookupForm
@{ ViewData["Title"]="Tra cứu hỏi đáp"; }
<header class="page-header"><p class="eyebrow">HỎI ĐÁP</p><h1>Tra cứu tình trạng câu hỏi</h1><p>Nhập mã tiếp nhận được cấp khi gửi câu hỏi và đúng email đã đăng ký. Không chia sẻ mã tiếp nhận.</p></header>
@if(Model.Message!=null){<p class="form-message" role="status">@Model.Message</p>}
@if(Model.Result!=null){<section class="content-panel" aria-label="Kết quả tra cứu"><h2>Kết quả tra cứu</h2><p>Trạng thái: @LandPortal.Web.Services.AdminLabels.State(Model.Result.State.ToString())</p>@if(Model.Result.Answer!=""){<h3>Trả lời</h3><p class="lookup-answer">@Model.Result.Answer</p>}else{<p>Chưa có câu trả lời.</p>}</section>}
<form method="post" action="/tra-cuu-ho-so" class="interaction-form">
@Html.AntiForgeryToken()
<label asp-for="Receipt">Mã tiếp nhận</label><input asp-for="Receipt" required maxlength="32" autocomplete="off" spellcheck="false" />
<label asp-for="Email">Email đã gửi câu hỏi</label><input asp-for="Email" type="email" required maxlength="254" autocomplete="off" />
<input type="hidden" asp-for="CaptchaId" />
@if(Model.CaptchaId!=Guid.Empty){<label asp-for="CaptchaAnswer">CAPTCHA: @Model.Question</label><input asp-for="CaptchaAnswer" required maxlength="3" inputmode="numeric" autocomplete="off" /><button type="submit">Tra cứu</button>}else{<p>Chưa thể cấp CAPTCHA. Vui lòng thử lại sau.</p>}
<p>Kết quả chỉ hiện sau khi kiểm tra đầy đủ. Tệp đính kèm và thông tin cá nhân không hiển thị tại đây.</p>
</form>
