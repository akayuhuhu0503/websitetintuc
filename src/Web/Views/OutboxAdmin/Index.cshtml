@model OutboxQueue
@{Layout="_AdminLayout";ViewData["Title"]="Thư chưa rõ kết quả gửi";}
<h1>Thư chưa rõ kết quả cần đối soát</h1><p>@Model.Total dòng trong phạm vi quyền. Tác vụ nền không tự gửi lại những thư này. Xem hoặc tải lại danh sách không tạo thư mới.</p><ul>@foreach(var m in Model.Items){<li><a href="/admin/outbox/@m.Id">Xem thư cần đối soát</a> · lần thử @m.Attempts · @AdminLabels.Diagnostic(m.ErrorCode)</li>}</ul>
@if(Model.Page>1){<a href="?page=@(Model.Page-1)">Trước</a>}@if(Model.Page*20<Model.Total){<a href="?page=@(Model.Page+1)">Sau</a>}
