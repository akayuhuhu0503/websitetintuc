@model OutboxQueue
@{Layout="_AdminLayout";ViewData["Title"]="Thư chưa rõ kết quả gửi";}
<h1>Thư Uncertain cần đối soát</h1><p>@Model.Total dòng trong phạm vi quyền. Worker không tự retry các dòng này; xem/refresh không tạo thư mới.</p><ul>@foreach(var m in Model.Items){<li><a href="/admin/outbox/@m.Id">Message-ID @m.Id</a> · lần thử @m.Attempts · @m.ErrorCode</li>}</ul>
@if(Model.Page>1){<a href="?page=@(Model.Page-1)">Trước</a>}@if(Model.Page*20<Model.Total){<a href="?page=@(Model.Page+1)">Sau</a>}
