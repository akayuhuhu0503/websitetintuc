@model OutboxReconcileForm
@using LandPortal.Domain
@{Layout="_AdminLayout";ViewData["Title"]="Đối soát thư";var row=(InteractionOutbox)ViewData["Row"]!;}
<section class="interaction-panel"><h1>Đối soát thư</h1><dl><dt>Mã đối soát thư</dt><dd>&lt;@row.Id@@landportal.invalid&gt;</dd><dt>Trạng thái</dt><dd>@InteractionLabels.Mail(row.State)</dd><dt>Lần thử</dt><dd>@row.Attempts</dd><dt>Kết quả kiểm tra</dt><dd>@AdminLabels.Diagnostic(row.ErrorCode)</dd></dl>
<p class="scope-note">SMTP chấp nhận không đồng nghĩa người dân đã đọc. Không gửi lại thư chưa rõ kết quả nếu chưa đối soát. Nội dung thư riêng tư không hiển thị ở đây.</p>
@if(row.State==InteractionMailState.Uncertain){<form method="post">@Html.AntiForgeryToken()<input asp-for="CommandId" type="hidden"/><input asp-for="RowVersion" type="hidden"/><label asp-for="Decision">Quyết định</label><select asp-for="Decision"><option value="unknown">Vẫn chưa xác định — không gửi lại</option><option value="accepted">Xác nhận máy chủ đã chấp nhận bằng bằng chứng tiếp nhận</option><option value="not-sent">Xác nhận chắc chắn chưa gửi — tạo lần gửi mới</option><option value="resend-risk">Quyết định gửi lại, chấp nhận nguy cơ thư trùng</option></select><label asp-for="Evidence">Bằng chứng/căn cứ</label><textarea asp-for="Evidence" rows="5" required maxlength="1000"></textarea><p>Khi xác nhận đã tiếp nhận: nhập đường dẫn bằng chứng .eml trong kho thư thử nghiệm. Hệ thống đối chiếu mã và nội dung thư. Khi xác nhận chưa gửi: dùng tiền tố NOT_SENT_CONFIRMED: theo quy trình vận hành, kèm kết quả kiểm tra nhật ký. Không dán nội dung thư, OTP hoặc thông tin người dân.</p><label class="interaction-consent"><input asp-for="AcknowledgeDuplicateRisk"/> Tôi xác nhận quyết định gửi lại có nguy cơ thư trùng và chịu trách nhiệm đối soát.</label><button>Lưu quyết định có nhật ký</button></form>}
<a href="/admin/outbox">Về danh sách cần đối soát</a></section>
