@model LandPortal.Web.Services.ConfiguredHomeModel
@{ ViewData["Title"] = "Trang chủ"; }
@if (Model.Site.IsPreview) { <div class="warning-message" role="status">Xem trước cấu hình nháp · chưa áp dụng công khai. Nội dung bài vẫn lấy bản đã xuất bản.</div> }
@{var slides=Model.Site.Banners.Where(x=>x.Position=="home").ToArray();}
@if(slides.Length>0){<section class="activity-slider" data-activity-slider aria-label="Ảnh hoạt động"><div class="activity-slides">@for(var i=0;i<slides.Length;i++){var banner=slides[i];<a class="site-banner activity-slide" data-slide href="@banner.Url" target="@(banner.NewWindow ? "_blank" : null)" rel="@(banner.NewWindow ? "noopener noreferrer" : null)"><img src="@banner.ImageUrl" alt="@banner.Alt" loading="@(i==0?"eager":"lazy")" /></a>}</div>@if(slides.Length>1){<nav class="activity-controls" data-slide-controls hidden aria-label="Chọn ảnh hoạt động"><button type="button" data-slide-prev>Ảnh trước</button><span data-slide-status role="status" aria-live="polite"></span><button type="button" data-slide-next>Ảnh tiếp</button></nav>}</section>}
<section class="quick-links" aria-label="Tra cứu nhanh"><a href="/van-ban"><span class="quick-icon" aria-hidden="true">§</span><span><strong>Văn bản pháp luật</strong><small>Tra cứu số ký hiệu, cơ quan ban hành</small></span><span aria-hidden="true">→</span></a><a href="/du-thao"><span class="quick-icon" aria-hidden="true">≡</span><span><strong>Văn bản dự thảo</strong><small>Theo dõi tài liệu lấy ý kiến</small></span><span aria-hidden="true">→</span></a><a href="/so-tay"><span class="quick-icon" aria-hidden="true">▤</span><span><strong>Sổ tay điện tử đất đai</strong><small>Thông tin hướng dẫn và liên kết nguồn</small></span><span aria-hidden="true">→</span></a></section>
<nav class="supplementary-links" aria-label="Thông tin chuyên ngành">@foreach (var link in Model.Site.Menus.Where(x => x.Position == "supplementary" && x.Url != null)) { <a href="@link.Url" target="@(link.NewWindow ? "_blank" : null)" rel="@(link.NewWindow ? "noopener noreferrer" : null)">@link.Label →</a> }</nav>
<div class="home-modules">
@foreach (var group in Model.VisibleBlocks)
{
    <section class="configured-home-block @(group.Block.Type=="Featured"?"home-featured":group.Block.Type=="Announcements"?"home-notices":"")" data-block-type="@group.Block.Type"><div class="section-heading"><h2>@group.Block.Title</h2>@if (group.MoreUrl != null) { <a href="@group.MoreUrl">Xem tất cả →</a> }</div>
    @if (group.Block.Type == "Links") { <nav class="site-link-grid" aria-label="@group.Block.Title">@foreach (var link in Model.Site.Menus.Where(x => x.Position == "links" && x.Url != null).Take(group.Block.Limit)) { <a href="@link.Url" target="@(link.NewWindow ? "_blank" : null)" rel="@(link.NewWindow ? "noopener noreferrer" : null)">@link.Label ↗</a> }</nav> }
    else if (group.Items.Count == 0) { <p class="empty-note">Chưa có nội dung công khai phù hợp trong mẫu đã nhập.</p> }
    else if (group.Block.Type == "Featured") { var lead = group.Items[0]; <div class="lead-grid"><article class="lead-story">@if (lead.ThumbnailUrl != null) { <a class="lead-image" href="@lead.Url" tabindex="-1" aria-hidden="true"><img src="@lead.ThumbnailUrl" alt="" fetchpriority="high" /></a> }<div class="lead-copy"><p class="item-meta">@lead.CategoryName @lead.DisplayDate</p><h3><a href="@lead.Url">@lead.Title</a></h3><p>@lead.Summary</p></div></article><div class="secondary-stories">@foreach (var item in group.Items.Skip(1)) { <partial name="_Card" model="item" /> }</div></div> }
    else { <div class="configured-story-grid">@foreach (var item in group.Items) { <partial name="_Card" model="item" /> }</div> }
    </section>
}
</div>
@foreach (var banner in Model.Site.Banners.Where(x => x.Position == "sidebar")) { <a class="site-banner" href="@banner.Url" target="@(banner.NewWindow ? "_blank" : null)" rel="@(banner.NewWindow ? "noopener noreferrer" : null)"><img src="@banner.ImageUrl" alt="@banner.Alt" /></a> }

@await Component.InvokeAsync("PopularArticles")
@await Component.InvokeAsync("LandStatistics")
