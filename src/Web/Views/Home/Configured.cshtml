@model LandPortal.Web.Services.ConfiguredHomeModel
@{
    ViewData["Title"] = "Trang chủ"; ViewData["HomeNewsHero"] = true;
    var blocks = Model.VisibleBlocks.ToArray();
    var news = blocks.Where(x => x.Block.Type is "Featured" or "Recent").ToArray();
    var topItems = news.SelectMany(x => x.Items).DistinctBy(x => x.Id).ToArray();
    var hasHero = news.Any(x => x.Block.Type == "Featured") && topItems.Length > 0;
    var latestItems = hasHero ? topItems.Skip(4).ToArray() : topItems;
    var latestTitle = news.FirstOrDefault(x => x.Block.Type == "Recent")?.Block.Title ?? news.FirstOrDefault()?.Block.Title ?? "Tin mới cập nhật";
    var slides = Model.Site.Banners.Where(x => x.Position == "home").ToArray();
    var sidebarBanners = Model.Site.Banners.Where(x => x.Position == "sidebar").ToArray();
}
@section Styles { <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" /> }
<div class="gdla-home">
    <h1 class="sr-only">Cổng thông tin điện tử Cục Quản lý đất đai</h1>
    @if (Model.Site.IsPreview) { <div class="warning-message" role="status">Xem trước cấu hình nháp · chưa áp dụng công khai. Nội dung bài vẫn lấy bản đã xuất bản.</div> }
    <div class="home-top-grid @(hasHero ? "" : "home-top-grid--utilities")">
        @if (hasHero) { <partial name="_HomeNewsCluster" model="topItems.Take(4).ToArray()" /> }
        <aside class="home-top-utilities" aria-label="Tra cứu nhanh">
            <partial name="_HomeUtilityGrid" />
            @if (sidebarBanners.Length > 0)
            {
                <div class="home-sidebar-banners">
                @foreach (var banner in sidebarBanners)
                {
                    <a class="site-banner" href="@banner.Url" aria-label="@banner.Label" target="@(banner.NewWindow ? "_blank" : null)" rel="@(banner.NewWindow ? "noopener noreferrer" : null)"><img src="@banner.ImageUrl" alt="@banner.Alt" loading="lazy" decoding="async" /></a>
                }
                </div>
            }
        </aside>
    </div>
    <div class="home-information-row">
    @foreach (var group in blocks.Where(x => x.Block.Type is "LegalDocuments" or "Announcements").OrderBy(x => x.Block.Type == "LegalDocuments" ? 0 : 1))
    {
        <section class="configured-home-block home-information-panel @(group.Block.Type == "Announcements" ? "home-notices" : "document-preview")" data-block-type="@group.Block.Type">
            <div class="section-heading"><h2><partial name="_PortalIcon" model='@(group.Block.Type == "Announcements" ? "notice" : "document")' />@group.Block.Title</h2>@if (group.MoreUrl is not null) { <a href="@group.MoreUrl">Xem tất cả <span aria-hidden="true">→</span></a> }</div>
            <partial name="_HomeContentBlock" model="group" />
        </section>
    }
    @await Component.InvokeAsync("HomeVideos", new { site = Model.Site })
    </div>
    @if (latestItems.Length > 0)
    {
        <section class="home-latest" aria-labelledby="home-latest-title"><div class="section-heading"><h2 id="home-latest-title">@latestTitle</h2><a href="/tin-tuc">Xem tất cả <span aria-hidden="true">→</span></a></div><div class="home-news-strip">@foreach (var item in latestItems) { <partial name="_Card" model="item" /> }</div></section>
    }
    <partial name="_HomeEventStrip" model="Model.Site" />
    <div class="category-sections">
    @foreach (var group in blocks.Where(x => x.Block.Type == "Category"))
    {
        <section class="configured-home-block home-category" data-block-type="Category"><div class="section-heading"><h2>@group.Block.Title</h2>@if (group.MoreUrl is not null) { <a href="@group.MoreUrl">Xem tất cả <span aria-hidden="true">→</span></a> }</div><partial name="_HomeContentBlock" model="group" /></section>
    }
    </div>
    <div class="home-support-modules">
    @foreach (var group in blocks.Where(x => x.Block.Type is not ("Featured" or "Recent" or "Category" or "Videos" or "LegalDocuments" or "Announcements")))
    {
        <section class="configured-home-block" data-block-type="@group.Block.Type">
            <div class="section-heading"><h2>@group.Block.Title</h2>@if (group.MoreUrl is not null) { <a href="@group.MoreUrl">Xem tất cả <span aria-hidden="true">→</span></a> }</div>
            @if (group.Block.Type == "Links") { <nav class="site-link-grid" aria-label="@group.Block.Title">@foreach (var link in Model.Site.Menus.Where(x => x.Position == "links" && x.Url is not null).Take(group.Block.Limit)) { <a href="@link.Url" target="@(link.NewWindow ? "_blank" : null)" rel="@(link.NewWindow ? "noopener noreferrer" : null)">@link.Label <span aria-hidden="true">↗</span></a> }</nav> }
            else { <partial name="_HomeContentBlock" model="group" /> }
        </section>
    }
    </div>
    @await Component.InvokeAsync("PopularArticles")
    @await Component.InvokeAsync("LandStatistics")
    @if (slides.Length > 0)
    {
        <section class="activity-slider" data-activity-slider aria-label="Ảnh hoạt động"><div class="activity-slides">@foreach (var banner in slides) { <a class="site-banner activity-slide" data-slide href="@banner.Url" target="@(banner.NewWindow ? "_blank" : null)" rel="@(banner.NewWindow ? "noopener noreferrer" : null)"><img src="@banner.ImageUrl" alt="@banner.Alt" loading="lazy" decoding="async" /></a> }</div>@if (slides.Length > 1) { <nav class="activity-controls" data-slide-controls hidden aria-label="Chọn ảnh hoạt động"><button type="button" data-slide-prev>Ảnh trước</button><span data-slide-status role="status" aria-live="polite"></span><button type="button" data-slide-next>Ảnh tiếp</button></nav> }</section>
    }
    <section class="home-utilities" aria-labelledby="home-utilities-title"><div class="home-utilities-intro"><h2 id="home-utilities-title"><partial name="_PortalIcon" model='"search"' />Tra cứu nhanh</h2><p>Thông tin và tiện ích đất đai</p></div><partial name="_QuickAccess" /></section>
    @if (Model.Site.Menus.Any(x => x.Position == "supplementary" && x.Url is not null)) { <nav class="supplementary-links" aria-label="Thông tin chuyên ngành">@foreach (var link in Model.Site.Menus.Where(x => x.Position == "supplementary" && x.Url is not null)) { <a href="@link.Url" target="@(link.NewWindow ? "_blank" : null)" rel="@(link.NewWindow ? "noopener noreferrer" : null)">@link.Label <span aria-hidden="true">→</span></a> }</nav> }
</div>
