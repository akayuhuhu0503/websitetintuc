@model HomeModel
@{ ViewData["Title"] = "Trang chủ"; var lead = Model.News.FirstOrDefault(); }
<div class="section-heading top-heading"><h1>Thông tin mới nhất</h1><a href="/tin-tuc">Tất cả tin tức <span aria-hidden="true">→</span></a></div>
<div class="home-top">
    <section class="lead-grid" aria-label="Tin tức mới nhất">
    @if (lead is not null)
    {
        <article class="lead-story">
            @if (lead.ThumbnailUrl is not null) { <a class="lead-image" href="@lead.Url" tabindex="-1" aria-hidden="true"><img src="@lead.ThumbnailUrl" alt="" fetchpriority="high" /></a> }
            <div class="lead-copy"><p class="item-meta"><span class="category-label">@(lead.CategoryName ?? "Tin tức")</span> @lead.DisplayDate</p><h2><a href="@lead.Url">@lead.Title</a></h2>@if (lead.Summary is not null) { <p>@lead.Summary</p> }</div>
        </article>
        <div class="secondary-stories">@foreach (var item in Model.News.Skip(1).Take(3)) { <partial name="_Card" model="item" /> }</div>
    }
    else { <div class="empty-state"><h2>Chưa có nội dung công khai</h2><p>Chạy bộ lấy mẫu và nhập dữ liệu vào SQL Server để bắt đầu.</p></div> }
    </section>
    <aside class="announcement-panel" aria-labelledby="announcement-heading"><div class="section-heading"><h2 id="announcement-heading">Thông báo</h2><a href="/thong-bao" aria-label="Xem tất cả thông báo">→</a></div>@if (Model.Announcements.Count > 0) { <ol class="notice-list">@foreach (var item in Model.Announcements.Take(5)) { <li><p class="item-meta">@item.DisplayDate</p><h3><a href="@item.Url">@item.Title</a></h3></li> }</ol> } else { <p class="empty-note">Chưa có thông báo trong tập mẫu đã nhập.</p> }<a class="outline-link" href="/thong-bao">Xem danh sách thông báo →</a></aside>
</div>
<section class="quick-links" aria-label="Tra cứu nhanh">
    <a href="/van-ban"><span class="quick-icon" aria-hidden="true">§</span><span><strong>Văn bản pháp luật</strong><small>Tra cứu số ký hiệu, cơ quan ban hành</small></span><span aria-hidden="true">→</span></a>
    <a href="/du-thao"><span class="quick-icon" aria-hidden="true">≡</span><span><strong>Văn bản dự thảo</strong><small>Theo dõi tài liệu lấy ý kiến</small></span><span aria-hidden="true">→</span></a>
    <a href="/so-tay"><span class="quick-icon" aria-hidden="true">▤</span><span><strong>Sổ tay điện tử đất đai</strong><small>Thông tin hướng dẫn và liên kết nguồn</small></span><span aria-hidden="true">→</span></a>
</section>
<nav class="supplementary-links" aria-label="Thông tin chuyên ngành"><a href="/van-ban-chi-dao-dieu-hanh">Văn bản chỉ đạo điều hành →</a><a href="/quy-hoach-su-dung-dat">Quy hoạch sử dụng đất →</a><a href="/lich-tuan">Lịch tuần →</a></nav>
<div class="category-sections">@foreach (var group in Model.Sections) { <section class="category-block"><div class="section-heading"><h2>@group.Name</h2><a href="/chuyen-muc/@group.Slug" aria-label="Xem chuyên mục @group.Name">→</a></div><div class="section-stories">@foreach (var item in group.Items.Take(3)) { <partial name="_Card" model="item" /> }</div></section> }</div>
<div class="home-bottom"><section class="document-preview"><div class="section-heading"><h2>Văn bản mới cập nhật</h2><a href="/van-ban">Tra cứu văn bản →</a></div>@if (Model.Documents.Count > 0) { <ul class="document-links">@foreach (var item in Model.Documents.Take(4)) { <li><span class="document-badge" aria-hidden="true">VB</span><div><p class="item-meta">@item.DisplayDate</p><h3><a href="@item.Url">@item.Title</a></h3></div></li> }</ul> } else { <p class="empty-note">Chưa có văn bản trong tập mẫu đã nhập.</p> }</section><section><div class="section-heading"><h2>Video</h2><a href="/video">Xem tất cả →</a></div>@if (Model.Videos.Count > 0) { @foreach (var item in Model.Videos.Take(2)) { <partial name="_Card" model="item" /> } } else { <div class="video-empty"><span aria-hidden="true">▷</span><h3>Thư viện video</h3><p>Chưa có video nguồn được xác minh và nhập vào kho. Tải video từ máy biên tập viên sẽ được triển khai ở Giai đoạn 2.</p></div> }</section></div>
