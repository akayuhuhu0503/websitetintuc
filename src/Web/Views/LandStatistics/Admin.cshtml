@model List<LandPortal.Domain.LandStatisticsVersion>
@{Layout="_AdminLayout";ViewData["Title"]="Quản lý thống kê diện tích đất";}
<h1>Thống kê diện tích đất</h1><p>Nhập XLSX 6 cột theo SRS v1.2, đủ 34 tỉnh/thành. Bản xem trước và bản nháp không thay số liệu công khai. Không dùng dữ liệu mẫu làm số liệu chính thức.</p>
@if(ViewData["LanScannerRestricted"] is true){<p class="warning-message" role="status">Bản LAN có giao diện nhập và xem trước. Tải tệp để xem trước vẫn đang khóa vì chưa có policy scanner được duyệt cho LAN; không dùng proof Test để công bố tệp LAN. Quy trình nhập đã được kiểm chứng riêng trên SQL Test.</p>}
else if(ViewData["LanSampleOnly"] is true){<p class="warning-message">Chỉ thử SAMPLE/TEST công khai: tải một trong hai mẫu dưới đây, upload lại để xem trước và lưu nháp. Tệp đã sửa hoặc tệp nghiệp vụ khác bị chặn trước scanner. Mọi số liệu thử đều không được xuất bản.</p><p><a href="/admin/thong-ke-dat-dai/sample/valid">Tải SAMPLE/TEST hợp lệ (34 tỉnh)</a> · <a href="/admin/thong-ke-dat-dai/sample/invalid">Tải SAMPLE/TEST lỗi số ở dòng 2, cột C</a></p>}
<p>Cột: Mã tỉnh; Tên tỉnh/thành phố; Tổng diện tích; Đất nông nghiệp; Đất phi nông nghiệp; Đất chưa sử dụng. Chỉ giá trị thuần, không công thức. Đơn vị áp dụng cho toàn kỳ.</p>
@if(ViewData["CanManage"] is true){<form method="post" action="/admin/thong-ke-dat-dai/preview" enctype="multipart/form-data">@Html.AntiForgeryToken()<label>Năm <input name="year" type="number" min="2025" max="@(DateTime.UtcNow.Year+1)" required/></label><label>Đơn vị <select name="unit"><option>ha</option><option>km²</option></select></label><label>Nguồn <input name="source" maxlength="1000" required/></label><label>Excel XLSX ≤10 MiB <input name="file" type="file" accept=".xlsx" required/></label><button disabled="@(ViewData["LanScannerRestricted"] is true)">Quét và xem trước</button></form>}
<h2>Lịch sử phiên bản</h2>
@foreach(var item in Model){<section><h3>Năm @item.Year · @item.CreatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</h3><p>@item.Source · @item.Unit · @(item.IsCurrent?"Đang công khai":item.State=="Draft"?"Bản nháp":item.State=="Preview"?"Chờ xác nhận":"Lịch sử đã công bố")</p><p>SHA-256: <code>@item.Sha256</code></p>
@if(item.State=="Draft"&&ViewData["CanPublish"] is true&&ViewData["LanSampleOnly"] is not true){var lives=(Dictionary<int,Guid>)ViewData["LiveVersions"]!;Guid? live=lives.TryGetValue(item.Year,out var found)?found:null;<form method="post" action="/admin/thong-ke-dat-dai/@item.Id/publish">@Html.AntiForgeryToken()<input type="hidden" name="expectedLive" value="@live"/>@if(live!=null){<label><input name="replace" type="checkbox" value="true" required/>Thay thế phiên bản công khai hiện tại, giữ lịch sử cũ</label>}<button disabled="@(ViewData["LanScannerRestricted"] is true)">Xuất bản đúng phiên bản</button></form>}</section>}
