@model InteractionDetail
@using LandPortal.Infrastructure
@if(Model.Submission.Kind==LandPortal.Domain.InteractionKind.Inquiry){
<section><h2>Xử lý hỏi đáp</h2><p>Lĩnh vực: @(Model.Submission.InquiryField??"Chưa phân loại") · Hạn dự kiến: @(Model.Submission.InquiryDueUtc?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")??"Chưa áp dụng") · @(Model.Submission.SlaIsOfficial?"Phiên bản đã xác nhận":InquiryCalendarService.TemporaryLabel)</p><p>Người phụ trách: @(Model.Submission.AssigneeId==null?"Chưa phân công":Model.Assignees.GetValueOrDefault(Model.Submission.AssigneeId,"Cán bộ đang phụ trách"))</p>
@if(Model.Attachment is {} file){<p>Tệp riêng: @file.Mime · @((file.Bytes/1024d).ToString("N0")) KiB · @file.ScanState</p>@if(Model.CanReadFile&&file.ScanState==LandPortal.Domain.InquiryScanState.Clean){<a href="/admin/hoi-dap/tep/@file.Id">Tải tệp qua kiểm tra quyền và scan</a>}else{<p>Tệp chưa có kết quả quét sạch hoặc bạn thiếu quyền tải; không có link public.</p>}}
@if(Model.CanAssign){<form method="post" action="/admin/hoi-dap/@Model.Submission.Id/phan-cong">@Html.AntiForgeryToken()<input name="CommandId" type="hidden" value="@Guid.NewGuid()"/><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Submission.RowVersion)"/><label for="assignee">Giao/chuyển cán bộ</label><select id="assignee" name="AssigneeId"><option value="">Chuyển trả về hàng chờ</option>@foreach(var person in Model.Assignees){<option value="@person.Key" selected="@(person.Key==Model.Submission.AssigneeId)">@person.Value</option>}</select><label for="assign-reason">Lý do phân công/chuyển trả</label><textarea id="assign-reason" name="Reason" maxlength="500" required></textarea><button>Lưu phân công có audit</button></form>}
@if(Model.CanExtend){<form method="post" action="/admin/hoi-dap/@Model.Submission.Id/gia-han">@Html.AntiForgeryToken()<input name="CommandId" type="hidden" value="@Guid.NewGuid()"/><input name="RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Submission.RowVersion)"/><label for="due-vn">Hạn mới theo giờ Việt Nam</label><input id="due-vn" name="DueVietnam" type="datetime-local" required/><label for="extension-reason">Căn cứ gia hạn</label><textarea id="extension-reason" name="Reason" maxlength="500" required></textarea><button>Gia hạn có lịch sử</button></form>}
@if(Model.History.Count>0){<h3>Lịch sử phân công/gia hạn (chỉ nội bộ)</h3><ul>@foreach(var entry in Model.History){<li>@entry.Utc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") · @entry.Action · @entry.Reason</li>}</ul>}
</section>}
