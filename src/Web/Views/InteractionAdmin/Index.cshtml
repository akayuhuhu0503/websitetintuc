@model InteractionInbox
@using LandPortal.Domain
@{Layout="_AdminLayout";ViewData["Title"]="Hộp thư tương tác";var bulk=Model.CanReadOriginal&&Model.Kind is InteractionKind.Comment or InteractionKind.Inquiry;}
<h1>Hộp thư tương tác</h1><nav class="interaction-inboxes" aria-label="Hộp thư">@foreach(var count in Model.Pending){<a href="?kind=@count.Key">@InteractionLabels.Kind(count.Key) <strong>@count.Value chờ</strong></a>}</nav>
@if(ViewData["CanManageReception"] is true){<a href="/admin/tuong-tac/tiep-nhan-binh-luan">Bật/tắt tiếp nhận bình luận</a>}
@if(ViewData["CanManageCalendar"] is true){<a href="/admin/hoi-dap/lich">Lịch xử lý hỏi đáp tạm tính</a>}
@if(ViewData["CanExport"] is true){<p><a href="/admin/hoi-dap/excel?state=@Model.State&field=@Uri.EscapeDataString(Model.Field??"")">Xuất Excel tối thiểu theo bộ lọc</a>@if(ViewData["CanExportPii"] is true){<a href="/admin/hoi-dap/excel?includePii=true&state=@Model.State&field=@Uri.EscapeDataString(Model.Field??"")">Xuất mở rộng có PII (quyền riêng)</a>}</p>}
@if(Model.Kind==InteractionKind.Contact&&ViewData["CanContactExport"] is true){<p><a href="/admin/hom-thu/excel?state=@Model.State">Xuất Excel hòm thư tối thiểu</a>@if(ViewData["CanContactExportPii"] is true){<a href="/admin/hom-thu/excel?state=@Model.State&includePii=true">Xuất hòm thư có PII (quyền riêng)</a>}</p>}
<form method="get"><input type="hidden" name="kind" value="@Model.Kind"/><label for="state">Trạng thái</label><select id="state" name="state"><option value="">Tất cả</option>@foreach(var state in Enum.GetValues<InteractionState>()){<option value="@state" selected="@(Model.State==state)">@InteractionLabels.State(state)</option>}</select>
@if(Model.Kind==InteractionKind.Inquiry){<label for="field">Lĩnh vực</label><input id="field" name="field" value="@Model.Field" maxlength="120"/><label for="due">Hạn dự kiến</label><select id="due" name="due"><option value="">Tất cả</option><option value="late" selected="@(Model.Due=="late")">Quá hạn tạm tính</option><option value="soon" selected="@(Model.Due=="soon")">Sắp đến hạn trong2 ngày</option></select>}<button>Lọc</button></form>
<p>@Model.Total hồ sơ · trang @Model.Page</p>
@if(bulk){<form id="batch-form">@Html.AntiForgeryToken()<label for="batch-action">Thao tác các hồ sơ đã chọn</label><select id="batch-action"><option value="reject">Từ chối</option><option value="hide">Ẩn bản công khai</option><option value="publish">Duyệt các bản đã biên tập</option></select><label for="batch-reason">Lý do từ chối/ẩn</label><textarea id="batch-reason" maxlength="500"></textarea><button type="submit">Xử lý và trả kết quả từng hồ sơ</button></form><div id="batch-results" role="status" aria-live="polite"></div>}
<ul class="interaction-records">@foreach(var s in Model.Items){<li data-batch-row data-id="@s.Id" data-version="@Convert.ToBase64String(s.RowVersion)">@if(bulk){<label><input type="checkbox" data-select-record/> Chọn hồ sơ</label>}@if(Model.CanReadOriginal){<a href="/admin/tuong-tac/@s.Id">@InteractionLabels.Kind(s.Kind) · @s.CreatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</a>}else{<span>@InteractionLabels.Kind(s.Kind) · @s.CreatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") — danh sách, không có quyền PII</span>} — @InteractionLabels.State(s.State) — @(s.PublicSnapshotId==null?"Riêng tư":"Có bản được duyệt")
@if(s.Kind==InteractionKind.Inquiry){<p>Lĩnh vực: @s.InquiryField · Phụ trách: @(s.AssigneeId==null?"Chưa phân công":Model.Assignees.GetValueOrDefault(s.AssigneeId,"Cán bộ")) · Hạn: @(s.InquiryDueUtc?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")??"Chưa áp dụng") · @(s.SlaIsOfficial?"Đã xác nhận":"Tạm tính")</p>}
@if(bulk){<details><summary>Biên tập bản công khai cho batch duyệt</summary><label>Tên hiển thị<input data-public-name maxlength="120"/></label><label>Nội dung đã loại thông tin riêng<textarea data-public-text maxlength="8000"></textarea></label><label>Câu trả lời/nhãn cơ quan<textarea data-public-answer maxlength="8000"></textarea></label></details>}</li>}</ul>
@if(Model.Page>1){<a href="?kind=@Model.Kind&page=@(Model.Page-1)&state=@Model.State&field=@Uri.EscapeDataString(Model.Field??"")&due=@Model.Due">Trang trước</a>}@if(Model.Page*20<Model.Total){<a href="?kind=@Model.Kind&page=@(Model.Page+1)&state=@Model.State&field=@Uri.EscapeDataString(Model.Field??"")&due=@Model.Due">Trang sau</a>}
@section Scripts{<script src="~/js/interaction-batch.js" asp-append-version="true" defer></script>}
