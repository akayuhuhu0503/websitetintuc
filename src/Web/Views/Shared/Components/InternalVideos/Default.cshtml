@model IReadOnlyList<VideoEmbedModel>
@if(Model.Count==0&&ViewData["ShowMissing"] is true){<div class="scope-note">Chưa có tệp video nguồn được xác minh và chuyển vào kho của hệ thống. Nội dung này chưa thể phát video trong bản chạy thử.</div>}
@foreach(var video in Model){<figure><video class="article-video" controls playsinline preload="metadata" poster="/video-media/@video.Id/poster" aria-label="@(string.IsNullOrWhiteSpace(video.Caption)?"Video nội bộ của bài viết":video.Caption)"><source src="/video-media/@video.Id/play" type="video/mp4" />@foreach(var track in video.Tracks){<track kind="captions" src="/video-track/@track" srclang="vi" label="Tiếng Việt" />}Trình duyệt của bạn chưa hỗ trợ phát video.</video>@if(!string.IsNullOrWhiteSpace(video.Caption)){<figcaption>@video.Caption</figcaption>}</figure>}
