@model (IReadOnlyList<ContentCard> Week,IReadOnlyList<ContentCard> Month)
@{ var home = ViewData["HomeNewsHero"] is true; }
@if(Model.Week.Count>0||Model.Month.Count>0){
<section class="popular-articles"><div class="section-heading"><h2>Tin đọc nhiều</h2></div>
<details open><summary>7 ngày qua</summary>@if(home){<partial name="_HomePopularStories" model="Model.Week"/>}else{<div class="popular-grid">@foreach(var item in Model.Week){<partial name="_Card" model="item"/>}</div>}@if(Model.Week.Count==0){<p class="empty-note">Chưa có lượt đọc trong 7 ngày qua.</p>}</details>
<details><summary>30 ngày qua</summary>@if(home){<partial name="_HomePopularStories" model="Model.Month"/>}else{<div class="popular-grid">@foreach(var item in Model.Month){<partial name="_Card" model="item"/>}</div>}@if(Model.Month.Count==0){<p class="empty-note">Chưa có lượt đọc trong 30 ngày qua.</p>}</details></section>
}
