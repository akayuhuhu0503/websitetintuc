@model ContentCard
<article class="news-card @(string.IsNullOrWhiteSpace(Model.ThumbnailUrl)?"news-card--text":"")">
    @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl)) { <a class="card-image" href="@Model.Url" tabindex="-1" aria-hidden="true"><img src="@Model.ThumbnailUrl" alt="" loading="lazy" /></a> }
    <div class="card-content"><p class="item-meta">@if (Model.DisplayDate is not null) { <span>@Model.DisplayDate</span> }<span class="card-category">@(Model.CategoryName ?? Model.Kind)</span></p><h3><a href="@Model.Url">@Model.Title</a></h3>@if (!string.IsNullOrWhiteSpace(Model.Summary)) { <p class="card-summary">@Model.Summary</p> }</div>
</article>
