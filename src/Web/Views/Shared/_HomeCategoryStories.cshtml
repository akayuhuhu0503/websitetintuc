@model IReadOnlyList<ContentCard>
@{
    // Choose presentation from available published thumbnails, never category names.
    var visual = Model.Count(x => !string.IsNullOrWhiteSpace(x.ThumbnailUrl)) >= Math.Max(2, (Model.Count + 1) / 2);
}
@if(Model.Count>0)
{
    <div class="category-stories @(visual?"category-stories--visual":"category-stories--editorial") @(Model.Count==1?"category-stories--single":"")">
        <div class="category-lead"><partial name="_Card" model="Model[0]" /></div>
        @if(Model.Count>1)
        {
            <div class="category-support">@foreach(var item in Model.Skip(1)){var card=visual?item:item with { ThumbnailUrl=null };<partial name="_Card" model="card" />}</div>
        }
    </div>
}
