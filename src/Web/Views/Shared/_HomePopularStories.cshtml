@model IReadOnlyList<ContentCard>
@if(Model.Count>0)
{
    <div class="popular-grid">@foreach(var item in Model.Take(4)){<partial name="_Card" model="item" />}</div>
    @if(Model.Count>4)
    {
        <ol class="popular-more" start="5">
        @foreach(var item in Model.Skip(4))
        {
            <li><article><h3><a href="@item.Url">@item.Title</a></h3><p class="item-meta"><span>@item.DisplayDate</span><span>@item.CategoryName</span></p></article></li>
        }
        </ol>
    }
}
