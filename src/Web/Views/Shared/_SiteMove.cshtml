@model SiteMoveModel
<form method="post" action="/admin/site/move" class="site-inline-actions">@Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="section" value="@Model.Section" /><input type="hidden" name="id" value="@Model.Id" /><button type="submit" name="direction" value="-1" aria-label="Chuyển mục lên">↑</button><button type="submit" name="direction" value="1" aria-label="Chuyển mục xuống">↓</button></form>
