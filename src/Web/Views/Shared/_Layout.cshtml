@inject LandPortal.Web.Services.PublicSiteService Sites
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject LandPortal.Infrastructure.PublicUrlPolicy PublicUrls
@inject LandPortal.Web.Services.PublicTraffic Traffic
@{ var site = await Sites.GetAsync(); var englishName=LandPortal.Infrastructure.SitePresentation.EnglishName(site?.Revision.EnglishName); var canonical=PublicUrls.Absolute(ViewData["CanonicalPath"] as string ?? Context.Request.Path.Value ?? "/");var publicPage=site?.IsPreview != true && !Context.Request.Path.StartsWithSegments("/admin") && !Context.Request.Path.StartsWithSegments("/tuong-tac") && !Context.Request.Path.StartsWithSegments("/tra-cuu-ho-so"); }
@{LandPortal.Web.Services.PublicTrafficCounts? traffic=null;if(publicPage){Traffic.RegisterSuccessfulPage(Context);traffic=await Traffic.ReadAsync();}}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="@(ViewData["Description"] ?? site?.Revision.SeoDescription ?? "Cổng thông tin Cục Quản lý đất đai — bản chạy thử tại môi trường phát triển.")" />
    <title>@ViewData["Title"] — Cục Quản lý đất đai | @englishName</title>
    <meta name="application-name" content="@englishName" />
    @if(publicPage) {
        <meta property="og:site_name" content="@(site?.Revision.OrganizationName ?? "Cục Quản lý đất đai") / @englishName" />
        <link rel="canonical" href="@canonical" />
        <meta property="og:type" content="@(ViewData["CanonicalPath"] is null ? "website" : "article")" />
        <meta property="og:title" content="@ViewData["Title"] — Cục Quản lý đất đai | @englishName" />
        <meta property="og:description" content="@(ViewData["Description"] ?? "Thông tin và tài liệu công khai của Cục Quản lý đất đai.")" />
        <meta property="og:url" content="@canonical" />
        @if(ViewData["OpenGraphImage"] is string mediaPath) { <meta property="og:image" content="@PublicUrls.Absolute(mediaPath)" /> }
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-config.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-v04.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-reflow.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-portal">
<a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
<div class="utility-bar"><div class="container utility-inner"><span>BỘ NÔNG NGHIỆP VÀ MÔI TRƯỜNG</span><time data-vietnam-clock datetime="@DateTimeOffset.UtcNow.ToString("O")">@DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).ToString("dddd, dd/MM/yyyy HH:mm:ss",System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</time><a href="/admin">Dành cho biên tập viên <span aria-hidden="true">↗</span></a></div></div>
<header class="masthead">
    <div class="container masthead-inner">
        <a class="brand" href="/" aria-label="Cục Quản lý đất đai — Trang chủ">
            @if (site?.LogoUrl != null) { <img class="brand-logo" src="@site.LogoUrl" alt="@site.Revision.OrganizationName" /> } else { <span class="brand-rule" aria-hidden="true"></span> }<span><span class="brand-eyebrow">CỔNG THÔNG TIN ĐIỆN TỬ</span><strong>@(site?.Revision.OrganizationName ?? "CỤC QUẢN LÝ ĐẤT ĐAI")</strong><span class="brand-subtitle" lang="en">@englishName</span><span class="brand-subtitle">Thông tin · Chính sách · Quản lý đất đai</span></span>
        </a>
        <form class="header-search" action="/tim-kiem" method="get" role="search">
            <label class="sr-only" for="header-query">Tìm kiếm trên cổng thông tin</label>
            <input id="header-query" name="q" type="search" placeholder="Tìm tin tức, văn bản..." maxlength="200" />
            <button type="submit" aria-label="Tìm kiếm"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8"/></svg></button>
        </form>
    </div>
</header>
@if (site != null) { foreach (var banner in site.Banners.Where(x => x.Position == "header")) { <div class="container"><a class="site-banner" href="@banner.Url" target="@(banner.NewWindow ? "_blank" : null)" rel="@(banner.NewWindow ? "noopener noreferrer" : null)"><img src="@banner.ImageUrl" alt="@banner.Alt" /></a></div> } }
@await Component.InvokeAsync("PortalNavigation")
<div class="container environment-note"><span class="status-dot" aria-hidden="true"></span> Bản chạy thử · Dữ liệu mẫu thu thập từ nguồn chính, chưa chuyển toàn bộ nội dung</div>
<main id="main-content" class="container main-content" tabindex="-1">
    @RenderBody()
</main>
<footer class="site-footer">
    @if (site != null)
    {
        <div class="container footer-main"><div class="footer-identity"><p class="footer-kicker">CỔNG THÔNG TIN ĐIỆN TỬ</p><h2>@site.Revision.OrganizationName</h2><p lang="en">@englishName</p><p>Bộ Nông nghiệp và Môi trường</p><address class="footer-contact">@site.Revision.ContactAddress<br />Điện thoại: @site.Revision.ContactPhone · Đường dây nóng: @site.Revision.ContactHotline<br />Email: @site.Revision.ContactEmail</address><p class="footer-note">@site.Revision.FooterText</p></div><nav aria-label="Liên kết chân trang"><h3>Thông tin &amp; tra cứu</h3>@foreach (var item in site.Menus.Where(x => x.Position == "footer" && x.Url != null)) { <a href="@item.Url" target="@(item.NewWindow ? "_blank" : null)" rel="@(item.NewWindow ? "noopener noreferrer" : null)">@item.Label</a> }</nav></div>
        <nav class="container agency-links" aria-label="Liên kết cơ quan"><span>Liên kết cơ quan</span>@foreach (var item in site.Menus.Where(x => x.Position == "links" && x.Url != null)) { <a href="@item.Url" target="@(item.NewWindow ? "_blank" : null)" rel="@(item.NewWindow ? "noopener noreferrer" : null)">@item.Label ↗</a> }</nav>
    }
    else
    {
        <div class="container footer-main"><div class="footer-identity"><h2>Cục Quản lý đất đai</h2><p lang="en">@englishName</p><p>Bộ Nông nghiệp và Môi trường</p></div></div>
    }
    <div class="container"><p>Ghi rõ nguồn khi phát hành lại thông tin từ Cổng thông tin điện tử này.</p></div>
    @if(site!=null){<div class="container footer-legal">@if(!string.IsNullOrWhiteSpace(site.Revision.SupervisingAgency)){<p>Cơ quan chủ quản: @site.Revision.SupervisingAgency</p>}@if(!string.IsNullOrWhiteSpace(site.Revision.ResponsiblePerson)){<p>Người chịu trách nhiệm chính: @site.Revision.ResponsiblePerson</p>}@if(!string.IsNullOrWhiteSpace(site.Revision.LicenseNumber)){<p>Số giấy phép: @site.Revision.LicenseNumber</p>}</div>}
    @if(traffic!=null){<section class="container public-traffic" aria-label="Thống kê truy cập"><h3>Thống kê truy cập</h3><p>Đang truy cập (5 phút): @traffic.Active · Hôm nay: @traffic.Today · Tháng này: @traffic.Month · Tổng: @traffic.Total</p><small>Số phiên truy cập từ khi hệ thống bắt đầu ghi nhận; không phải số người duy nhất. Phiên hết hạn sau 20 phút không hoạt động. Không thu địa chỉ IP, tài khoản hay email; dùng cookie ngẫu nhiên của website. Cập nhật lúc @traffic.UpdatedUtc.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm:ss").</small></section>}
    <div class="footer-bottom"><div class="container">Nguồn nội dung: qldd.mae.gov.vn <span>Chỉ truy cập trong môi trường phát triển</span></div></div>
</footer>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
