@model ContentCard
<article class="document-card">
    <span class="document-card-icon"><partial name="_PortalIcon" model='"document"' /></span>
    <div><h3><a href="@Model.Url">@Model.Title</a></h3>
        <p class="document-number">@if(Model.DocumentNumber is not null){<span>Số ký hiệu: @Model.DocumentNumber</span>}@if(Model.DisplayDate is not null){<span>@Model.DisplayDate</span>}</p>
    </div>
</article>
