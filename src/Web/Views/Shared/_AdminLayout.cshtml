@inject LandPortal.Infrastructure.CurrentPermissionService PermissionService
@{ var actor = await PermissionService.GetAsync(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? ""); }
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>@ViewData["Title"] — Quản trị nội dung</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-editor.css" asp-append-version="true" />@await RenderSectionAsync("Styles", required: false)<link rel="stylesheet" href="~/css/font-faces.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" /></head><body class="admin-body">
<a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
<header class="admin-header"><a href="/admin" class="admin-brand"><strong>QLĐĐ</strong><span>QUẢN TRỊ NỘI DUNG</span></a>
<button type="button" class="cms-menu-toggle" aria-expanded="false" aria-controls="cms-sidebar">☰ Menu</button>
<div class="admin-account"><a href="/" target="_blank" rel="noopener">Xem cổng thông tin ↗</a><details class="cms-account-menu"><summary>@User.Identity?.Name</summary><a href="/admin/account/change-password">Đổi mật khẩu</a><form method="post" action="/admin/account/logout">@Html.AntiForgeryToken()<button type="submit" class="link-button">Đăng xuất</button></form></details></div></header>
<div class="admin-shell"><aside id="cms-sidebar" class="admin-sidebar" aria-label="Quản trị">
@{ var canContent = actor.Has(LandPortal.Application.Permissions.Create) || actor.Has(LandPortal.Application.Permissions.ViewOwn) || actor.Has(LandPortal.Application.Permissions.ViewAll) || actor.Has(LandPortal.Application.Permissions.EditOwn) || actor.Has(LandPortal.Application.Permissions.EditAll) || actor.Has(LandPortal.Application.Permissions.Review) || actor.Has(LandPortal.Application.Permissions.PublishApproved); }
@if(canContent || actor.Has(LandPortal.Application.Permissions.ManageVideos) || actor.Has(LandPortal.Application.Permissions.Schedule)) {
<p class="sidebar-label">NỘI DUNG</p>
@if(canContent){<a href="/admin" data-admin-nav="articles">Bài viết</a><a href="/admin?kind=StaticPage&amp;categoryId=76" data-admin-nav="weekly">Lịch công tác tuần</a>}
@if(actor.Has(LandPortal.Application.Permissions.ManageVideos)){<a href="/admin/videos" data-admin-nav="/admin/videos">Video</a>}
@if(actor.Has(LandPortal.Application.Permissions.Schedule)){<a href="/admin/schedules" data-admin-nav="/admin/schedules">Lịch xuất bản</a>}
}
@{ var inboxes = Enum.GetValues<LandPortal.Domain.InteractionKind>().Where(k => LandPortal.Infrastructure.InteractionPermissions.CanList(actor,k)).ToArray(); }
@if(inboxes.Length>0){<p class="sidebar-label">TƯƠNG TÁC</p>@foreach(var kind in inboxes){<a href="/admin/tuong-tac?kind=@kind" data-admin-nav="inbox-@kind">@InteractionLabels.Kind(kind)</a>}}
@if(actor.Has(LandPortal.Application.Permissions.ViewSite) || actor.Has(LandPortal.Application.Permissions.ManageSite) || actor.Has(LandPortal.Application.Permissions.PublishSite) || actor.Has(LandPortal.Application.Permissions.ManageUsers) || actor.Has(LandPortal.Application.Permissions.ManageRoles) || actor.Has(LandPortal.Application.Permissions.OutboxReconcile) || LandPortal.Web.Controllers.AuditController.CanRead(actor)) {
<p class="sidebar-label">QUẢN TRỊ</p>
@if(actor.Has(LandPortal.Application.Permissions.ViewSite) || actor.Has(LandPortal.Application.Permissions.ManageSite) || actor.Has(LandPortal.Application.Permissions.PublishSite)) {<a href="/admin/site?section=banners" data-admin-nav="banners">Banner &amp; trang chủ</a><a href="/admin/site?section=menus" data-admin-nav="site">Menu &amp; cấu hình</a>}
@if(actor.Has(LandPortal.Application.Permissions.ManageSite)||actor.Has(LandPortal.Application.Permissions.PublishSite)){<a href="/admin/thong-ke-dat-dai" data-admin-nav="/admin/thong-ke-dat-dai">Thống kê đất đai</a>}
@if(actor.Has(LandPortal.Application.Permissions.ManageUsers)){<a href="/admin/users" data-admin-nav="/admin/users">Tài khoản</a>}
@if(actor.Has(LandPortal.Application.Permissions.ManageRoles)){<a href="/admin/roles" data-admin-nav="/admin/roles">Nhóm quyền</a>}
@if(actor.Has(LandPortal.Application.Permissions.OutboxReconcile) || LandPortal.Web.Controllers.AuditController.CanRead(actor)){<details class="cms-nav-advanced"><summary>Quản trị nâng cao</summary>@if(actor.Has(LandPortal.Application.Permissions.OutboxReconcile)){<a href="/admin/outbox" data-admin-nav="/admin/outbox">Đối soát gửi thư</a>}@if(LandPortal.Web.Controllers.AuditController.CanRead(actor)){<a href="/admin/audit" data-admin-nav="/admin/audit">Nhật ký hệ thống</a>}</details>}
}
</aside><main id="main-content" class="admin-main" tabindex="-1">@if (TempData["Success"] is string success) { <div class="success-message" role="status">@success</div> }@RenderBody()</main></div>
<script id="admin-display-labels" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(AdminLabels.States))</script><script src="~/js/admin-labels.js" asp-append-version="true"></script><script src="~/js/admin-shell.js" asp-append-version="true" defer></script><script src="~/js/site.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
