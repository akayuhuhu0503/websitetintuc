@inject LandPortal.Infrastructure.CurrentPermissionService PermissionService
@{ var actor = await PermissionService.GetAsync(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? ""); }
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>@ViewData["Title"] — Quản trị nội dung</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/interactions.css" asp-append-version="true" />@await RenderSectionAsync("Styles", required: false)</head><body class="admin-body"><a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a><header class="admin-header"><a href="/admin" class="admin-brand"><strong>QLĐĐ</strong><span>QUẢN TRỊ NỘI DUNG</span></a><div class="admin-account"><a href="/" target="_blank" rel="noopener">Xem cổng thông tin ↗</a><span>@User.Identity?.Name</span><form method="post" action="/admin/account/logout">@Html.AntiForgeryToken()<button type="submit" class="link-button">Đăng xuất</button></form></div></header><div class="admin-shell"><aside class="admin-sidebar" aria-label="Quản trị"><p class="sidebar-label">BIÊN TẬP</p><a class="active" href="/admin">Bài viết</a>@if(actor.Has(LandPortal.Application.Permissions.ManageVideos)){<a href="/admin/videos">Video tải trực tiếp</a>}@if (actor.Has(LandPortal.Application.Permissions.Create)) { <a href="/admin/create">Soạn bài mới</a> }@if(actor.Has(LandPortal.Application.Permissions.ManageUsers)) { <a href="/admin/users">Tài khoản</a> }@if(actor.Has(LandPortal.Application.Permissions.ManageRoles)) { <a href="/admin/roles">Nhóm quyền</a> }@if(actor.Has(LandPortal.Application.Permissions.ViewSite) || actor.Has(LandPortal.Application.Permissions.ManageSite) || actor.Has(LandPortal.Application.Permissions.PublishSite)) { <a href="/admin/site">Cấu hình website</a> }@if(actor.Has(LandPortal.Application.Permissions.Schedule)) { <a href="/admin/schedules">Lịch xuất bản</a> }@foreach(var kind in Enum.GetValues<LandPortal.Domain.InteractionKind>()){if(LandPortal.Infrastructure.InteractionPermissions.CanList(actor,kind)){<a href="/admin/tuong-tac?kind=@kind">Hộp thư @InteractionLabels.Kind(kind)</a>}}@if(actor.Has(LandPortal.Application.Permissions.OutboxReconcile)){<a href="/admin/outbox">Đối soát thư Uncertain</a>}<a href="/admin/account/mfa">Xác thực hai bước</a><a href="/admin/account/change-password">Đổi mật khẩu của tôi</a><div class="sidebar-scope"><p>CMS · Tương tác kiểm duyệt</p><span>Soạn bài, duyệt và xuất bản theo quyền. Hộp thư tương tác theo quyền riêng. Video nội bộ theo quyền và trạng thái xử lý riêng.</span></div></aside><main id="main-content" class="admin-main" tabindex="-1">@if (TempData["Success"] is string success) { <div class="success-message" role="status">@success</div> }@RenderBody()</main></div><script src="~/js/site.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
