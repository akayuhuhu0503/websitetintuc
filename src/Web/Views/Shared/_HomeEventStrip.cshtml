@model LandPortal.Web.Services.SitePublicConfiguration
@{var banners=Model.Banners.Where(x=>x.Position=="home_event_strip").ToArray();}
@if(banners.Length>0)
{
<section class="home-event-strip" data-event-carousel aria-roledescription="băng chuyền" aria-label="Sự kiện và thông tin nổi bật">
    <div class="event-slides">
    @for(var i=0;i<banners.Length;i++)
    {
        var banner=banners[i];
        <article class="event-slide" data-event-slide hidden="@(i>0)" role="group" aria-roledescription="banner" aria-label="@(i+1) / @banners.Length">
            <a href="@banner.Url" aria-label="@banner.Label" target="@(banner.NewWindow?"_blank":null)" rel="@(banner.NewWindow?"noopener noreferrer":null)">
                <img src="@banner.ImageUrl" alt="@banner.Alt" width="1170" height="100" loading="lazy" decoding="async" />
                <span class="event-slide-caption" aria-hidden="true">@banner.Label</span>
            </a>
        </article>
    }
    </div>
    @if(banners.Length>1){<nav class="event-dots" data-event-dots hidden aria-label="Chọn banner sự kiện">@for(var i=0;i<banners.Length;i++){<button type="button" data-event-dot="@i" aria-label="Đến banner @(i+1): @banners[i].Label" aria-current="@(i==0?"true":"false")"><span aria-hidden="true"></span></button>}</nav>}
</section>
}
else if(Model.IsPreview)
{
<aside class="event-preview-placeholder"><strong>Vị trí banner sự kiện</strong><p>Sau Tin mới cập nhật, trước các chuyên mục. Chọn vị trí “Dải sự kiện sau Tin mới cập nhật” trong CMS; khung banner rộng theo khu vực tin tức, ảnh khuyến nghị cùng tỉ lệ 117:10 (ví dụ 1170 × 100 px). Ảnh khác tỉ lệ sẽ bị cắt để lấp đầy khung. Vùng này chỉ xuất hiện khi xem trước, không để khoảng trống ngoài trang công khai.</p></aside>
}
